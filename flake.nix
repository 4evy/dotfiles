{
  description = "My dotfiles";

  inputs = {
    # Retain Home Manager for AI's flake module and Darwin program modules
    ai = {
      inputs = {
        bun2nix.follows = "bun2nix";
        flake-parts.follows = "flake-parts";
        nix-darwin.follows = "";
        nixpkgs.follows = "nixpkgs";
        treefmt-nix.follows = "treefmt-nix";
      };
      url = "github:4evy/ai";
    };

    # Only Tweezle's NixOS module is consumed, omit unused module inputs
    tweezle = {
      inputs = {
        flake-parts.follows = "flake-parts";
        home-manager.follows = "";
        nix-darwin.follows = "";
        nixpkgs.follows = "";
      };
      url = "github:4evy/tweezle";
    };

    determinate = {
      # Share dev tooling, not Nix's release build and regression package sets
      inputs.nix.inputs = {
        flake-parts.follows = "flake-parts";
        git-hooks-nix.follows = "git-hooks-nix";
      };
      url = "https://flakehub.com/f/DeterminateSystems/determinate/=3.24.2";
    };

    darwin = {
      inputs = {
        determinate.follows = "determinate";
        nixpkgs.follows = "nixpkgs";
      };
      url = "github:4evy/ndw";
    };

    sops-nix.inputs.nixpkgs.follows = "";
    sops-nix.url = "github:Mic92/sops-nix";

    catppuccin = {
      inputs.nixpkgs.follows = "nixpkgs";
      url = "github:catppuccin/nix";
    };

    # Numen and Soulver's main package sets follow this transitively
    # Soulver keeps its separate libxml2 ABI compatibility pin
    vicinae.inputs.nixpkgs.follows = "nixpkgs";
    vicinae.url = "github:vicinaehq/vicinae";

    hjem = {
      inputs.nixpkgs.follows = "nixpkgs";
      url = "github:feel-co/hjem";
    };

    git-hooks-nix = {
      inputs = {
        flake-compat.follows = "";
        nixpkgs.follows = "nixpkgs";
      };
      url = "github:cachix/git-hooks.nix";
    };

    source-oh-my-zsh = {
      flake = false;
      url = "github:ohmyzsh/ohmyzsh/6010fb6260f359e71d99ba25f05f9215809b3ed2";
    };
    source-zsh-autosuggestions = {
      flake = false;
      url = "github:zsh-users/zsh-autosuggestions/85919cd1ffa7d2d5412f6d3fe437ebdbeeec4fc5";
    };
    source-zsh-syntax-highlighting = {
      flake = false;
      url = "github:zsh-users/zsh-syntax-highlighting/e6683f20e5c38d3e5447f45845d04ddda75d0f23";
    };
    source-fzf-tab = {
      flake = false;
      url = "github:Aloxaf/fzf-tab/24105b15714bfec37989ed5c5b6e60f572253019";
    };
    source-oh-my-bash = {
      flake = false;
      url = "github:ohmybash/oh-my-bash/94c2977eda06f230aafa9628fcd869123f01896b";
    };
    source-fzf-tab-completion = {
      flake = false;
      url = "github:lincheney/fzf-tab-completion/7014e0a7cd68fe3530e2f58c45740d17e98f05b8";
    };
    source-noto-color-emoji = {
      flake = false;
      url = "file+https://raw.githubusercontent.com/googlefonts/noto-emoji/99701e07d3d1fe1bdbcdb14964547f0fd592966f/2D/fonts/NotoColorEmoji.ttf";
    };

    source-mitos = {
      flake = false;
      url = "github:mitos-editor/mitos";
    };

    source-karabiner-vhid-package = {
      flake = false;
      # Upstream's tagged copy avoids the unreliable release download route
      url = "file+https://raw.githubusercontent.com/pqrs-org/Karabiner-DriverKit-VirtualHIDDevice/v8.8.0/dist/Karabiner-DriverKit-VirtualHIDDevice-8.8.0.pkg";
    };

    source-kmscon = {
      flake = false;
      url = "github:kmscon/kmscon/main";
    };

    source-libtsm = {
      flake = false;
      url = "github:kmscon/libtsm/main";
    };

    source-nix-gl-host = {
      flake = false;
      url = "github:numtide/nix-gl-host/5269b233f83880a0b433eafe026f0bc0d8f1a4a9";
    };

    source-toshy = {
      flake = false;
      url = "github:RedBearAK/Toshy/Toshy_v26.11.0";
    };

    source-uresourced = {
      flake = false;
      url = "git+https://gitlab.freedesktop.org/benzea/uresourced.git?ref=refs/tags/v0.5.5";
    };

    bun2nix = {
      inputs = {
        flake-parts.follows = "flake-parts";
        nixpkgs.follows = "nixpkgs";
        treefmt-nix.follows = "treefmt-nix";
      };
      # Support Bun's v2/v3 lockfiles until upstream merges bun2nix#110
      # https://github.com/nix-community/bun2nix/pull/110
      url = "github:Mic92/bun2nix/lockfile-v2-v3";
    };

    eupkgs.inputs.nixpkgs.follows = "nixpkgs-unstable";
    eupkgs.url = "github:euvlok/pkgs";

    flake-parts.inputs.nixpkgs-lib.follows = "nixpkgs";
    flake-parts.url = "github:hercules-ci/flake-parts";

    nixcord = {
      inputs = {
        # These frameworks are only used by upstream module checks
        home-manager.follows = "";
        nix-darwin.follows = "";
        nixpkgs.follows = "nixpkgs-unstable";
        nixpkgs-ci.follows = "nixpkgs-unstable";
        nixpkgs-packages.follows = "nixpkgs-unstable";
        treefmt-nix.follows = "treefmt-nix";
      };
      url = "github:4evy/nixcord";
    };

    # Keep the faster-moving package channel separate from the main system set
    nixpkgs-unstable.url = "https://channels.nixos.org/nixos-unstable-small/nixexprs.tar.zst";
    nixpkgs.url = "https://channels.nixos.org/nixos-unstable/nixexprs.tar.zst";

    patches = {
      inputs.nixpkgs.follows = "nixpkgs";
      url = "github:4evy/patches";
    };

    raycast = {
      inputs.nixpkgs.follows = "nixpkgs";
      url = "github:4evy/raycast";
    };

    treefmt-nix.inputs.nixpkgs.follows = "nixpkgs";
    treefmt-nix.url = "github:numtide/treefmt-nix";
  };

  outputs = inputs: import ./nix/flake/outputs.nix inputs;
}
