[Unit]
Description=OpenSSH connection over Tailscale
Documentation=man:sshd(8) man:sshd_config(5)
Wants=sshd-keygen.target
After=sshd-keygen.target

[Service]
# Use OpenSSH for user-owned Unix forwarding sockets until Tailscale fixes
# https://github.com/tailscale/tailscale/issues/21098
ExecStart=/usr/sbin/sshd -i -o PasswordAuthentication=no -o KbdInteractiveAuthentication=no -o PermitRootLogin=no -o AllowUsers=evy -o "AuthorizedKeysFile /etc/ssh/authorized_keys/%%u .ssh/authorized_keys"
StandardInput=socket
