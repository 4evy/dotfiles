[Unit]
Description=Refresh KMSCON theme
Documentation=https://github.com/kmscon/kmscon

[Service]
Type=oneshot
EnvironmentFile=-/etc/default/kmscon-dotfiles
ExecStart=/usr/bin/kmscon-theme-config /usr/share/dotfiles/catppuccin_custom_palette.json /etc/kmscon/kmscon.conf
ExecStartPost=/usr/bin/kmscon-refresh /etc/kmscon/kmscon.conf
