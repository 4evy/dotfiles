[Unit]
Description=Refresh Toshy after Kanata virtual keyboard changes
Documentation=https://github.com/RedBearAK/Toshy https://github.com/jtroo/kanata

[Service]
Type=oneshot
# An enabled service may be intentionally stopped by the session monitor
ExecStart=/bin/sh -c 'if [ -e /run/kanata-main/main ] && systemctl --user is-active --quiet toshy-config.service; then systemctl --user restart toshy-config.service; fi'
