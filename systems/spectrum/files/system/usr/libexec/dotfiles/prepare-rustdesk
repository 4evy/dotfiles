#!/usr/bin/bash
set -euo pipefail

readonly runtime_dir=/var/lib/rustdesk/dotfiles
source=$(readlink -f /usr/bin/rustdesk)
install -d -m 0755 "$runtime_dir" /root/.config/rustdesk
if ! cmp -s "$source" "$runtime_dir/rustdesk"; then
  install -m 0755 "$source" "$runtime_dir/rustdesk"
fi
ln -sfn "$(dirname "$source")/lib" "$runtime_dir/lib"

/usr/bin/python3.15 - <<'PY'
import json
from pathlib import Path

path = Path('/root/.config/rustdesk/RustDesk2.toml')
text = path.read_text() if path.exists() else ''
lines = text.splitlines()
policy = json.loads(Path('/usr/share/dotfiles/rustdesk-options.json').read_text())
values = {key: json.dumps(value) for key, value in (policy['common'] | policy['linux']).items()}
result = []
inside = False
for line in lines:
    if line.startswith('['):
        if inside:
            result.extend(f'{key} = {value}' for key, value in values.items())
            values.clear()
        inside = line.strip() == '[options]'
    key = line.split('=', 1)[0].strip()
    if inside and key in values:
        result.append(f'{key} = {values.pop(key)}')
    else:
        result.append(line)
if values:
    if not inside:
        result.extend(('', '[options]'))
    result.extend(f'{key} = {value}' for key, value in values.items())
updated = '\n'.join(result) + '\n'
if updated != text:
    path.write_text(updated)
PY

restorecon -RF /var/lib/rustdesk
