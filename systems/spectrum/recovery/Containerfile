ARG BASE=localhost/spectrum:latest

# Image-backed resources have root ownership and container-safe SELinux labels
FROM scratch AS recovery-files
COPY systems/spectrum/files/system/usr/lib/dracut/modules.d/91spectrum-wifi /usr/lib/dracut/modules.d/91spectrum-wifi
COPY systems/spectrum/files/system/usr/lib/dracut/dracut.conf.d/90-spectrum-recovery.conf /usr/lib/dracut/dracut.conf.d/90-spectrum-recovery.conf
COPY systems/spectrum/files/system/etc/ssh/sshd_config.d/00-spectrum.conf /etc/ssh/sshd_config.d/00-spectrum.conf
COPY systems/spectrum/files/system/etc/ssh/authorized_keys/evy /etc/ssh/authorized_keys/evy
COPY systems/spectrum/recovery/sshd_config /etc/dracut-sshd/sshd_config

FROM ${BASE}

# This derivative stays in root's local storage, never in the public registry
RUN --mount=type=bind,from=recovery-files,source=/,target=/run/spectrum-files,ro \
    --mount=type=secret,id=recovery-wifi,required=true \
    --mount=type=secret,id=recovery-host-key,target=/etc/ssh/dracut_ssh_host_ed25519_key,required=true \
    --mount=type=secret,id=recovery-host-key-pub,target=/etc/ssh/dracut_ssh_host_ed25519_key.pub,required=true \
    set -eu; \
    cp -a /run/spectrum-files/usr/lib/dracut/modules.d/91spectrum-wifi /usr/lib/dracut/modules.d/; \
    install -Dm 0644 /run/spectrum-files/usr/lib/dracut/dracut.conf.d/90-spectrum-recovery.conf /usr/lib/dracut/dracut.conf.d/90-spectrum-recovery.conf; \
    install -Dm 0644 /run/spectrum-files/etc/ssh/sshd_config.d/00-spectrum.conf /etc/ssh/sshd_config.d/00-spectrum.conf; \
    install -Dm 0644 /run/spectrum-files/etc/ssh/authorized_keys/evy /etc/ssh/authorized_keys/evy; \
    install -Dm 0644 /run/spectrum-files/etc/ssh/authorized_keys/evy /etc/dracut-sshd/authorized_keys; \
    install -Dm 0644 /run/spectrum-files/etc/dracut-sshd/sshd_config /etc/dracut-sshd/sshd_config; \
    install -d -m 0700 /var/roothome; \
    set -- /usr/lib/modules/*; \
    test "$#" -eq 1; \
    kver="${1##*/}"; \
    DRACUT_NO_XATTR=1 dracut --force --no-hostonly --force-add 'sshd spectrum-wifi' \
      "/usr/lib/modules/$kver/initramfs.img" "$kver"; \
    systemctl enable sshd.service; \
    bootc container lint
