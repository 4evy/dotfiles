# Start from an empty build context and add back only the paths used by the
# smoke-test Dockerfile and Spectrum image builds.
*

!Dockerfile
!.dockerignore
!.ansible-lint
!.yamllint
!ansible.cfg
!pyproject.toml
!uv.lock

!cmd/
!cmd/chezmoi-support/
!cmd/chezmoi-support/**
!internal/
!internal/**

!containers/
!containers/**

!ansible/
!ansible/**

!patches/
!patches/**

!dotfiles/
!dotfiles/**

!manifests/
!manifests/**

!spectrum/
!spectrum/**

!packages/
packages/*
!packages/dotfiles-python/
!packages/dotfiles-python/src/
!packages/dotfiles-python/src/workstation/
!packages/dotfiles-python/src/workstation/__init__.py
!packages/dotfiles-python/src/workstation/errors.py
!packages/dotfiles-python/src/workstation/lib/
!packages/dotfiles-python/src/workstation/lib/__init__.py
!packages/dotfiles-python/src/workstation/lib/commands.py
!packages/dotfiles-python/src/workstation/lib/files.py
!packages/dotfiles-python/src/workstation/lib/http.py
!packages/dotfiles-python/src/workstation/lib/validation.py
!packages/scripts/
!packages/scripts/**
!packages/terminal-theme-tools/
!packages/terminal-theme-tools/**

# Never send local generated state if it appears under an included path.
**/.DS_Store
**/__pycache__/
**/*.pyc
**/target/
.docker-cache/
.git/
*.log
