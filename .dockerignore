# Start from an empty build context and add back only the paths used by the
# smoke-test Dockerfile and Spectrum image builds.
*

!Dockerfile
!.dockerignore
!.ansible-lint
!.yamllint
!ansible.cfg
!pyproject.toml
!uv.lock

!containers/
!containers/**

!ansible/
!ansible/**

!patches/
!patches/ghostty/
!patches/ghostty/**

!bluebuild/
!bluebuild/**

# BlueBuild extracts embedded build helpers here before invoking BuildKit.
!.bluebuild-scripts_*/
!.bluebuild-scripts_*/**

!dotfiles/
!dotfiles/**

!npins/
!npins/sources.json

!packages/
packages/*
!packages/ghostty/
!packages/ghostty/**
!packages/dotfiles-python/
!packages/dotfiles-python/**
!packages/terminal-theme-tools/
!packages/terminal-theme-tools/**

# Never send local generated state if it appears under an included path.
**/.DS_Store
**/__pycache__/
**/*.pyc
**/target/
.docker-cache/
.git/
*.log
