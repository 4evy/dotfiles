# Start from an empty build context and add back only Spectrum image inputs.
*

!.ansible-lint
!.yamllint
!ansible.cfg
!LICENSE
!pyproject.toml
!uv.lock

!ansible/
!ansible/**

!bluebuild/
!bluebuild/**

# BlueBuild extracts embedded build helpers here before invoking BuildKit.
!.bluebuild-scripts_*/
!.bluebuild-scripts_*/**

!dotfiles/
!dotfiles/**

!flake.lock

!packages/
packages/*
!packages/source-lock/
!packages/source-lock/**
!packages/dotfiles-python/
packages/dotfiles-python/*
!packages/dotfiles-python/assets/
!packages/dotfiles-python/assets/**
!packages/dotfiles-python/src/
!packages/dotfiles-python/src/**
!packages/ghostty-patched/
!packages/ghostty-patched/build.sh
!packages/hyper-window-tiling/
packages/hyper-window-tiling/*
!packages/hyper-window-tiling/package.json
!packages/hyper-window-tiling/bun.lock
!packages/hyper-window-tiling/tsconfig.json
!packages/hyper-window-tiling/src/
!packages/hyper-window-tiling/src/**
!packages/hyper-window-tiling/gnome/
!packages/hyper-window-tiling/gnome/**
!packages/hyper-window-tiling/kde/
!packages/hyper-window-tiling/kde/**
!packages/kanata/
!packages/kanata/kanata.kbd
!packages/kanata-with-cmd/
packages/kanata-with-cmd/*
!packages/kanata-with-cmd/build-linux.sh
!packages/theme-run/
packages/theme-run/*
!packages/theme-run/go.mod
!packages/theme-run/go.sum
!packages/theme-run/package.nix
!packages/theme-run/cmd/
!packages/theme-run/cmd/**
!packages/theme-run/internal/
!packages/theme-run/internal/**

# Never send local generated state if it appears under an included path.
**/.DS_Store
**/.rumdl_cache/
**/.zig-cache/
**/__pycache__/
**/*.pyc
**/node_modules/
**/target/
**/zig-out/
**/zig-pkg/
.docker-cache/
.git/
*.log
