# Docker Buildx and Podman share this allowlist for the public build context
**
!package.json
!bun.lock
!tsconfig.json

!data/rustdesk/options.json

!systems/spectrum/files/**
!systems/spectrum/recipes/spectrum/sources/system/**
!systems/spectrum/recipes/spectrum/sources/*.json
!systems/spectrum/recovery/sshd_config

# BlueBuild extracts embedded build helpers here before building the image
!.bluebuild-scripts_*/
!.bluebuild-scripts_*/**

!home/package.json
!home/generators.json
!home/deploy/schema.ts
!home/files/.local/lib/package.json
!home/files/.local/lib/typescript/process.ts
!home/files/.local/lib/typescript/runtime.ts
!home/theme/palette/palette.json

# Workstation's shared TypeScript helpers are also builder inputs
!lib/typescript/**

!tools/workstation/package.json
!tools/workstation/build.ts
!tools/workstation/tsconfig.json
!tools/workstation/assets/**
!tools/workstation/src/**
!tools/tiling/package.json
!tools/tiling/bindings.json
!tools/tiling/scripts/**
!tools/tiling/vendor/**
!tools/tiling/tsconfig.json
!tools/tiling/src/**
!tools/tiling/gnome/**
!tools/tiling/kde/**
!packages/solaar/tray.patch
!packages/kanata/kanata.kbd
!packages/kanata/build.sh

# Never send local generated state if it appears under an included path
**/.DS_Store
**/.rumdl_cache/
**/.zig-cache/
**/__pycache__/
**/*.pyc
**/node_modules/
**/target/
**/zig-out/
**/zig-pkg/
.git/
*.log
