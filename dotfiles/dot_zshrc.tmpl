# Zsh startup: ordered interactive modules.
#
# Zsh reads .zshrc only for interactive shells; .zshenv owns the environment.

_dotfiles_zsh_module_dir="$HOME/.config/shell/zshrc.d"
_dotfiles_zsh_local_dir="$HOME/.config/shell/zshrc.local.d"

for _dotfiles_zsh_module in \
  "$_dotfiles_zsh_module_dir"/*.zsh(N) \
  "$_dotfiles_zsh_local_dir"/*.zsh(N); do
  [[ -r "$_dotfiles_zsh_module" ]] || continue
  source "$_dotfiles_zsh_module"
done

unset \
  _dotfiles_zsh_module \
  _dotfiles_zsh_module_dir \
  _dotfiles_zsh_local_dir

# Startup-only helpers are intentionally unavailable after initialization.
unset -f _dotfiles_wrap_command _dotfiles_wrap_themed_command _dotfiles_command_path
