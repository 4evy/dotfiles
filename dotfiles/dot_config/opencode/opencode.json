{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "autoupdate": false,
  "username": "Evy",
  "snapshot": true,
  "plugin": ["@slkiser/opencode-quota@4.8.2"],
  "references": {
    "opencode": {
      "repository": "anomalyco/opencode",
      "description": "Use for current OpenCode implementation, configuration, SDK, and documentation details; compare behavior with the installed release."
    }
  },
  "watcher": {
    "ignore": [
      "**/.git/**",
      "**/.jj/**",
      "**/.cache/**",
      "**/.ansible/**",
      "**/.venv/**",
      "**/.ruby-lsp/**",
      "**/.gradle/**",
      "**/node_modules/**",
      "**/__pycache__/**",
      "**/*.egg-info/**",
      "**/.zig-cache/**",
      "**/zig-cache/**",
      "**/zig-pkg/**",
      "**/zig-out/**",
      "**/target/**",
      "**/build/**",
      "**/build-*/**",
      "**/builddir/**",
      "**/.build/**",
      "**/dist/**",
      "**/result/**",
      "**/tmp/**",
      "**/.bluebuild-scripts_*/**"
    ]
  },
  "tool_output": {
    "max_lines": 600,
    "max_bytes": 32768
  },
  "compaction": {
    "prune": true
  },
  "mcp": {
    "ghidra": {
      "type": "remote",
      "url": "http://127.0.0.1:8090/mcp",
      "oauth": false,
      "enabled": false
    },
    "lldb": {
      "type": "local",
      "command": ["lldb-mcp-launcher"],
      "enabled": false,
      "timeout": 30000
    }
  },
  "permission": {
    "*": "allow",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "~/.ssh/**": "deny",
      "~/.config/gh/**": "deny",
      "~/.local/share/opencode/auth.json": "deny",
      "~/.config/opencode/auth.json": "deny"
    },
    "external_directory": {
      "*": "allow"
    },
    "bash": {
      "*": "allow",
      "sudo": "ask",
      "sudo *": "ask",
      "rm": "ask",
      "rm *": "ask",
      "rmdir": "ask",
      "rmdir *": "ask",
      "unlink": "ask",
      "unlink *": "ask",
      "git commit*": "ask",
      "git push*": "ask",
      "git send-pack*": "ask",
      "git-push*": "ask",
      "git-send-pack*": "ask",
      "git lfs push*": "ask",
      "jj git push*": "ask",
      "jj gerrit upload*": "ask",
      "git reset*": "ask",
      "git restore*": "ask",
      "git clean*": "ask",
      "git checkout*": "ask",
      "git switch*": "ask",
      "git rebase*": "ask",
      "git merge*": "ask",
      "git cherry-pick*": "ask",
      "git stash*": "ask",
      "gh": "ask",
      "gh *": "ask",
      "gh pr view*": "allow",
      "gh pr list*": "allow",
      "gh issue view*": "allow",
      "gh issue list*": "allow",
      "gh run view*": "allow",
      "gh run list*": "allow",
      "gh repo view*": "allow",
      "gh repo list*": "allow",
      "gh release view*": "allow",
      "gh release list*": "allow",
      "gh pr diff*": "allow",
      "gh pr checks*": "allow",
      "gh pr status*": "allow",
      "gh issue status*": "allow",
      "gh run watch*": "allow",
      "gh workflow view*": "allow",
      "gh workflow list*": "allow",
      "gh release download*": "allow",
      "gh search*": "allow",
      "gh status*": "allow",
      "gh api *": "allow",
      "gh api *-X*": "ask",
      "gh api *--method*": "ask",
      "gh api *-f*": "ask",
      "gh api *-F*": "ask",
      "gh api *--field*": "ask",
      "gh api *--raw-field*": "ask",
      "gh api *--input*": "ask",
      "gh api *graphql*": "ask"
    },
    "ghidra_import_file": "deny"
  }
}
