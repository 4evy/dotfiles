{
  "$schema": "https://opencode.ai/tui.json",
  "plugin": ["@slkiser/opencode-quota@4.8.2"],
  "theme": "catppuccin-custom",
  "keybinds": {
    "leader": "ctrl+space",
    "command_list": "ctrl+shift+p",
    "editor_open": "ctrl+x",
    "session_export": "ctrl+t",
    "session_copy": "<leader>y",
    "agent_list": "alt+a",
    "variant_cycle": "alt+.,ctrl+shift+t",
    "messages_copy": "ctrl+o",
    "input_move_up": "up,ctrl+p",
    "input_move_down": "down,ctrl+n",
    "input_line_home": "home,ctrl+a",
    "input_line_end": "end,ctrl+e",
    "input_buffer_home": "ctrl+home",
    "input_buffer_end": "ctrl+end",
    "input_backspace": "backspace,shift+backspace,ctrl+h",
    "input_delete_word_backward": "ctrl+w,ctrl+backspace,ctrl+shift+backspace,alt+backspace,ctrl+alt+h",
    "input_delete_word_forward": "alt+d,alt+delete,ctrl+delete,ctrl+shift+delete",
    "history_previous": "up,ctrl+p",
    "history_next": "down,ctrl+n"
  },
  "attention": {
    "enabled": true,
    "notifications": true,
    "sound": true,
    "volume": 0.4,
    "sound_pack": "opencode.default"
  }
}
