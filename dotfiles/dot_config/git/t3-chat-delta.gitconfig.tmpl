{{- $t3 := .t3_chat -}}
{{- range $variant := list "light" "dark" }}
{{- $palette := index $t3 $variant }}
[delta "t3-chat-{{ $variant }}"]
    blame-palette = "{{ index $palette "base" }} {{ index $palette "mantle" }} {{ index $palette "crust" }} {{ index $palette "surface0" }} {{ index $palette "surface1" }}"
    commit-decoration-style = "{{ index $palette "overlay0" }}" bold box ul
    {{ $variant }} = true
    file-decoration-style = "{{ index $palette "overlay0" }}"
    file-style = "{{ index $palette "text" }}"
    hunk-header-decoration-style = "{{ index $palette "overlay0" }}" box ul
    hunk-header-file-style = bold
    hunk-header-line-number-style = bold "{{ index $palette "subtext0" }}"
    hunk-header-style = file line-number syntax
    line-numbers-left-style = "{{ index $palette "overlay0" }}"
    line-numbers-minus-style = bold "{{ index $palette "red" }}"
    line-numbers-plus-style = bold "{{ index $palette "green" }}"
    line-numbers-right-style = "{{ index $palette "overlay0" }}"
    line-numbers-zero-style = "{{ index $palette "overlay0" }}"
    minus-emph-style = bold syntax "{{ index $palette "errorSurface" }}"
    minus-style = syntax "{{ index $palette "errorSurface" }}"
    plus-emph-style = bold syntax "{{ template "theme_color_mix" (dict "background" (index $palette "terminalBackground") "foreground" (index $palette "success") "weight" 15) }}"
    plus-style = syntax "{{ template "theme_color_mix" (dict "background" (index $palette "terminalBackground") "foreground" (index $palette "success") "weight" 15) }}"
    syntax-theme = T3 Chat {{ title $variant }}

{{ end -}}
