{
  "appSupport": "~/Library/Application Support/com.raycast.macos",
  "appBundle": "/Applications/Raycast.app",
  "dataAddon": "Contents/Resources/macos-app_RaycastDesktopApp.bundle/Contents/Resources/backend/data.darwin-arm64.node",
  "nodeRuntime": "node/runtime",
  "nodeGlob": "node-v*/bin/node",
  "keyCacheName": ".raycast-key-cache",
  "aiDisableBackupName": "raycast-ai-disable-backup.json",
  "defaultsBin": "defaults",
  "defaultsDomain": "com.raycast.macos",
  "profileUserDefaults": {
    "currentUser": "CurrentUser",
    "oauthToken": "OAuthTokenResponse"
  },
  "env": {
    "appSupport": "RAYCAST_APP_SUPPORT",
    "appBundle": "RAYCAST_APP_BUNDLE",
    "dataAddon": "RAYCAST_DATA_ADDON",
    "keyFile": "RAYCAST_KEY_FILE",
    "keyDumpFile": "RAYCAST_KEYDUMP_FILE",
    "aiDisableBackup": "RAYCAST_AI_DISABLE_BACKUP"
  }
}
