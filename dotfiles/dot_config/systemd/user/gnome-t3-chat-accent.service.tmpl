[Unit]
Description=Apply T3 Chat GNOME accent colors
PartOf=graphical-session.target

[Service]
Type=simple
{{ if eq (get .chezmoi.osRelease "id") "nixos" -}}
ExecStart=/run/current-system/sw/bin/gnome-t3-chat-accent --watch
{{ else -}}
ExecStart=%h/.local/bin/gnome-t3-chat-accent --watch
{{ end -}}
Restart=on-failure

[Install]
WantedBy=default.target
