# 07 / prompt, picker, and history
# Prefer cached init scripts; generate them directly on a fresh install.
# Atuin provides bash-preexec; Starship must see it during initialization so
# both tools share one preexec/precmd framework instead of competing PS0 hooks.
_atuin_bin="$(_dotfiles_command_path atuin 2>/dev/null || true)"
if [[ -t 0 && -t 1 && -n "$_atuin_bin" ]]; then
	if _dotfiles_command_path theme-run >/dev/null; then
		_dotfiles_wrap_themed_command atuin
	else
		_dotfiles_wrap_command atuin "$_atuin_bin"
	fi
	if [[ -r "$HOME/.cache/atuin/init.bash" ]]; then
		# shellcheck source=/dev/null
		source "$HOME/.cache/atuin/init.bash"
	else
		if _dotfiles_init="$("$_atuin_bin" init bash --disable-up-arrow)"; then
			eval "$_dotfiles_init"
		fi
		unset _dotfiles_init
	fi
	__atuin_search_cmd() (
		local -a search_args=("$@")
		local result_file status

		result_file="$(mktemp)" || exit 1
		trap 'rm -f -- "$result_file"' EXIT
		ATUIN_SHELL=bash \
			ATUIN_LOG=error \
			ATUIN_QUERY=$READLINE_LINE \
			atuin search "${search_args[@]}" -i --result-file "$result_file" 1>&2
		status=$?
		cat -- "$result_file"
		exit "$status"
	)
fi
unset _atuin_bin

_starship_bin="$(_dotfiles_command_path starship 2>/dev/null || true)"
if [[ -n "$_starship_bin" ]]; then
	# 10-terminal selected STARSHIP_CONFIG once; keep Starship's prompt-time
	# calls on the direct binary path.
	_dotfiles_wrap_command starship "$_starship_bin"
fi
if [[ -n "$_starship_bin" && -r "$HOME/.cache/starship/init.bash" ]]; then
	# shellcheck source=/dev/null
	source "$HOME/.cache/starship/init.bash"
elif [[ -n "$_starship_bin" ]]; then
	if _dotfiles_init="$("$_starship_bin" init bash)"; then
		eval "$_dotfiles_init"
	fi
	unset _dotfiles_init
fi
unset _starship_bin
_fzf_bin="$(_dotfiles_command_path fzf 2>/dev/null || true)"
if [[ -n "$_fzf_bin" ]]; then
	if _dotfiles_command_path theme-run >/dev/null; then
		_dotfiles_wrap_themed_command fzf
	else
		_dotfiles_wrap_command fzf "$_fzf_bin"
	fi
	if [[ -r "$HOME/.cache/fzf/init.bash" ]]; then
		# shellcheck source=/dev/null
		source "$HOME/.cache/fzf/init.bash"
	else
		if _dotfiles_init="$("$_fzf_bin" --bash)"; then
			eval "$_dotfiles_init"
		fi
		unset _dotfiles_init
	fi
fi
unset _fzf_bin
