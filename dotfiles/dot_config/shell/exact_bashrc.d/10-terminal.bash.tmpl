# 01 / terminal integration
# Load Ghostty integration and fall back when its terminfo is unavailable.
if [[ -n "${GHOSTTY_RESOURCES_DIR:-}" ]] &&
	[[ -r "${GHOSTTY_RESOURCES_DIR}/shell-integration/bash/ghostty.bash" ]]; then
	builtin source "${GHOSTTY_RESOURCES_DIR}/shell-integration/bash/ghostty.bash"
fi

if [[ "${TERM:-}" == "xterm-ghostty" ]] && ! infocmp xterm-ghostty &>/dev/null; then
	export TERM=xterm-256color
fi

# Detect once without writing a query into the shell's input stream. Theme-aware
# wrappers inherit this value; standalone launcher calls can still use Kitty or
# OSC detection when no theme environment is available.
if [[ -z "${TERMINAL_THEME:-}" ]] &&
	command -v theme-run >/dev/null 2>&1; then
	_dotfiles_terminal_theme="$(theme-run --print-theme-no-terminal 2>/dev/null)" || _dotfiles_terminal_theme=
	case "$_dotfiles_terminal_theme" in
		dark | light) export TERMINAL_THEME="$_dotfiles_terminal_theme" ;;
	esac
	unset _dotfiles_terminal_theme
fi

# OpenSSH and Tailscale SSH accept LC_* environment variables. Mirror the
# detected client appearance so remote shells inherit it before consulting the
# remote desktop's theme.
case "${TERMINAL_THEME:-}" in
	dark | light)
		export LC_TERMINAL_THEME="$TERMINAL_THEME"
		# Starship runs several times per prompt. Select its managed profile once
		# instead of putting theme-run in that hot path.
		if [[ "${TERM_PROGRAM:-}" == "Apple_Terminal" ]]; then
			export STARSHIP_CONFIG="$HOME/.config/starship-t3-chat-terminal-${TERMINAL_THEME}.toml"
			if [[ -t 1 ]]; then
				printf '\e]50;SetProfile=T3 Chat %s\a' "${TERMINAL_THEME^}"
			fi
		else
			export STARSHIP_CONFIG="$HOME/.config/starship-t3-chat-${TERMINAL_THEME}.toml"
		fi
		;;
esac
