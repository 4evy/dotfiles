# Source fingerprint: {{ output "git" "-C" $repo "hash-object" (joinPath $repo "packages/chatgpt/patch-computer-use-policy.ts") (joinPath $repo "dotfiles/dot_local/bin/executable_patch-chatgpt-computer-use") (joinPath $repo "dotfiles/Library/LaunchAgents/dev.4evy.patch-chatgpt-computer-use.plist.tmpl") | sha256sum }}
from __future__ import annotations

import os
import subprocess
from pathlib import Path

home = Path(os.environ["CHEZMOI_HOME_DIR"])
domain = f"gui/{os.getuid()}"
label = "dev.4evy.patch-chatgpt-computer-use"
plist = home / "Library/LaunchAgents" / f"{label}.plist"
subprocess.run(
    ("/bin/launchctl", "bootout", domain, str(plist)),
    check=False,
    stdout=subprocess.DEVNULL,
    stderr=subprocess.DEVNULL,
)
subprocess.run(("/bin/launchctl", "bootstrap", domain, str(plist)), check=True)
{{ end -}}
