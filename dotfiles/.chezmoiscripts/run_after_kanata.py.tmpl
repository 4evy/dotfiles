{{- if eq .chezmoi.os "darwin" -}}
{{- $repo := joinPath .chezmoi.sourceDir ".." -}}
#!/usr/bin/env python3.14
from __future__ import annotations

import shutil
import subprocess
from pathlib import Path

fingerprint = "{{ include "dot_config/kanata/kanata-macos.kbd" | sha256sum }}:{{ output "shasum" "-a" "256" (joinPath $repo "ansible/library/dotfiles_codesign.py") (joinPath $repo "ansible/roles/system/tasks/macos.yml") (joinPath $repo "ansible/roles/system/templates/macos/kanata-app-info.plist.j2") (joinPath $repo "Formula/kanata-with-cmd.rb") | sha256sum }}"
marker = Path.home() / ".cache/dotfiles/kanata-reconcile.sha256"
state = subprocess.run(
    ("/bin/launchctl", "print", "system/dev.4evy.kanata"),
    check=False,
    capture_output=True,
    text=True,
)
if (
    state.returncode == 0
    and "state = running" in state.stdout
    and marker.is_file()
    and marker.read_text(encoding="utf-8").strip() == fingerprint
):
    raise SystemExit(0)

repository = Path({{ joinPath .chezmoi.sourceDir ".." | quote }})
ansible = shutil.which("ansible-playbook")
uvx = shutil.which("uvx")
if ansible is not None:
    command = (ansible,)
elif uvx is not None:
    command = (uvx, "--from", "ansible-core", "ansible-playbook")
else:
    raise SystemExit(
        "kanata reconciliation failed: ansible-playbook/uvx is not available"
    )

subprocess.run(
    (
        *command,
        "ansible/site.yml",
        "--tags",
        "always,kanata",
    ),
    cwd=repository,
    check=True,
)
marker.parent.mkdir(parents=True, exist_ok=True)
marker.write_text(f"{fingerprint}\n", encoding="utf-8")
{{- end }}
