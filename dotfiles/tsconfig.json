{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "erasableSyntaxOnly": false
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    "**/*.cts",
    "**/*.js",
    "**/*.jsx",
    "**/*.mjs",
    "**/*.cjs"
  ],
  "exclude": ["**/node_modules/**", "**/dist/**", "**/build/**", "**/tmp/**"]
}
