# Zsh environment entry point.
#
# Zsh reads this file for every invocation. Keep it quiet and limit it to
# environment state that child processes must inherit.

typeset -U path PATH fpath FPATH

# Zsh skips this user file with RCS unset; also honor RCS when sourced manually
if [[ -o rcs ]]; then
  # Fedora's /etc/zshrc sources /etc/profile.d for non-login shells. During the
  # SSH Bash-to-Zsh handoff, Bash has already printed Bluefin's MOTD, so shadow
  # only the second startup invocation. .zshrc removes this function afterward.
  if [[ "${DOTFILES_SSH_ZSH_HANDOFF:-}" == 1 ]]; then
    umotd() { :; }
  fi

  if [[ -r "$HOME/.config/shell/environment.sh" ]]; then
    source "$HOME/.config/shell/environment.sh"
  fi

  # Completion search paths are Zsh-specific. PATH itself is owned by the
  # shared environment module and is initialized once per process tree.
  if [[ -n "${HOMEBREW_PREFIX:-}" ]]; then
    fpath=("$HOMEBREW_PREFIX/share/zsh/site-functions" "${fpath[@]}")
  fi
fi

export PATH FPATH
