  "list_data_items_by_xrefs",
  "list_globals",
  "search_byte_patterns",
  "search_instructions",
  "read_memory",
  "inspect_memory_content",
  "list_data_types",
  "search_data_types",
  "get_type_size",
  "get_struct_layout",
  "create_struct",
  "add_struct_field",
  "modify_struct_field",
