  "close_project",
  "open_project",
  "load_program",
  "load_program_from_project",
  "open_program",
  "close_program",
  "switch_program",
  "save_program",
  "save_all_programs",
  "analysis_status",
  "run_analysis",
  "reanalyze",
  "get_address_spaces",
