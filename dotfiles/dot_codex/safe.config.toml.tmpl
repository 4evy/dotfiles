# Select with `codex --profile safe` for normal project work with approvals
approval_policy = "on-request"
default_permissions = ":workspace"
web_search = "cached"

# Keep read-only app calls frictionless, but require approval for writes
[apps._default]
default_tools_approval_mode = "writes"

# The desktop app contributes this server through its unified automation plugin
[plugins."unified-computer-use@openai-bundled".mcp_servers.cua_repl]
default_tools_approval_mode = "prompt"

{{- $onePasswordMcp := "" }}
{{- if eq .chezmoi.os "darwin" }}
{{- $onePasswordMcp = "/Applications/1Password.app/Contents/MacOS/1password-mcp" }}
{{- else if lookPath "1password-mcp" }}
{{- $onePasswordMcp = lookPath "1password-mcp" }}
{{- end }}
{{- if and $onePasswordMcp (stat $onePasswordMcp) }}

# Secret access deserves an explicit prompt even when the tool is read-only
[mcp_servers.1password]
default_tools_approval_mode = "prompt"
{{- end }}

[mcp_servers.ghidra]
default_tools_approval_mode = "prompt"

{{- if lookPath "lldb-mcp-launcher" }}

[mcp_servers.lldb]
default_tools_approval_mode = "prompt"
{{- end }}

{{- $chatGPTResources := includeTemplate "chatgpt_resources" . | trim }}
{{- $nodeRepl := joinPath $chatGPTResources "cua_node/bin/node_repl" }}
{{- if and $chatGPTResources (stat $nodeRepl) }}

[mcp_servers.node_repl]
default_tools_approval_mode = "prompt"
{{ end -}}
