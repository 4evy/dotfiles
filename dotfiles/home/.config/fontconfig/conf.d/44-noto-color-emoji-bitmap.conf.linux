<?xml version="1.0"?>
<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">
<fontconfig>
  <match target="scan">
    <test name="file" compare="eq">
      <string>/usr/share/fonts/url-fonts/NotoColorEmojiBitmap/NotoColorEmoji.ttf</string>
    </test>
    <edit name="family" mode="prepend">
      <string>Noto Color Emoji Bitmap</string>
    </edit>
  </match>
</fontconfig>
