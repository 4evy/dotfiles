[Unit]
Description=Solaar Logitech device manager
After=graphical-session.target
PartOf=graphical-session.target
StartLimitIntervalSec=30
StartLimitBurst=3

[Service]
Type=simple
# Resolve the managed profile before host executables without a launcher
ExecSearchPath=%S/hjem/standalone/current-profile/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/run/current-system/sw/bin
ExecStart=solaar --window=hide --no-tray
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
