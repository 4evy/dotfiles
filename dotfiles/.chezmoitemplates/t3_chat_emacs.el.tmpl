{{- $p := index .root.t3_chat .variant -}}
;;; t3-chat-{{ .variant }}-theme.el --- T3 Chat -*- lexical-binding: t -*-

;;; Commentary:

;; Share the T3 Chat palette with graphical and terminal Emacs frames.

;;; Code:

(deftheme t3-chat-{{ .variant }} "Shared T3 Chat palette.")

(custom-theme-set-faces
 't3-chat-{{ .variant }}
 '(default ((((type tty)) (:foreground "{{ $p.text }}" :background "unspecified-bg"))
    (t (:foreground "{{ $p.text }}" :background "{{ $p.base }}"))))
 '(cursor ((t (:background "{{ $p.rose }}"))))
 '(fringe ((((type tty)) ( :background "unspecified-bg"))
    (t ( :background "{{ $p.base }}"))))
 '(region ((t (:background "{{ $p.highlightMed }}"))))
 '(highlight ((t (:background "{{ $p.highlightLow }}"))))
 '(hl-line ((t (:background "{{ $p.highlightLow }}"))))
 '(minibuffer-prompt ((t (:foreground "{{ $p.rose }}" :weight bold))))
 '(font-lock-comment-face ((t (:foreground "{{ $p.placeholder }}" :slant italic))))
 '(font-lock-string-face ((t (:foreground "{{ $p.pine }}"))))
 '(font-lock-keyword-face ((t (:foreground "{{ $p.iris }}"))))
 '(font-lock-function-name-face ((t (:foreground "{{ $p.rose }}"))))
 '(font-lock-variable-name-face ((t (:foreground "{{ $p.text }}"))))
 '(font-lock-type-face ((t (:foreground "{{ $p.gold }}"))))
 '(font-lock-constant-face ((t (:foreground "{{ $p.gold }}"))))
 '(font-lock-builtin-face ((t (:foreground "{{ $p.foam }}"))))
 '(font-lock-warning-face ((t (:foreground "{{ $p.love }}"))))
 '(mode-line ((t (:foreground "{{ $p.text }}" :background "{{ $p.surface }}" :box nil))))
 '(mode-line-inactive ((t (:foreground "{{ $p.placeholder }}" :background "{{ $p.surface }}" :box nil))))
 '(line-number ((((type tty)) (:foreground "{{ $p.placeholder }}" :background "unspecified-bg"))
    (t (:foreground "{{ $p.placeholder }}" :background "{{ $p.base }}"))))
 '(line-number-current-line ((t (:foreground "{{ $p.rose }}" :weight bold))))
 '(vertical-border ((t (:foreground "{{ $p.highlightHigh }}"))))
 '(link ((t (:foreground "{{ $p.rose }}" :underline t))))
 '(success ((t (:foreground "{{ $p.pine }}"))))
 '(warning ((t (:foreground "{{ $p.gold }}"))))
 '(error ((t (:foreground "{{ $p.love }}"))))
 '(isearch ((t (:foreground "{{ $p.accentForeground }}" :background "{{ $p.accent }}"))))
 '(lazy-highlight ((t (:background "{{ $p.highlightMed }}"))))
 '(show-paren-match ((t (:background "{{ $p.highlightHigh }}" :weight bold))))
 '(vertico-current ((t (:background "{{ $p.highlightMed }}"))))
 '(corfu-default ((t (:foreground "{{ $p.text }}" :background "{{ $p.surface }}"))))
 '(corfu-current ((t (:background "{{ $p.highlightMed }}"))))
 '(tab-bar ((t (:foreground "{{ $p.text }}" :background "{{ $p.surface }}"))))
 '(tab-bar-tab ((((type tty)) (:foreground "{{ $p.rose }}" :background "unspecified-bg"))
    (t (:foreground "{{ $p.rose }}" :background "{{ $p.base }}"))))
 '(tab-bar-tab-inactive ((t (:foreground "{{ $p.placeholder }}" :background "{{ $p.surface }}"))))
 '(hel-normal-state-main-cursor ((t (:background "{{ $p.rose }}"))))
 '(hel-insert-state-main-cursor ((t (:background "{{ $p.foam }}"))))
 '(hel-emacs-state-main-cursor ((t (:background "{{ $p.placeholder }}"))))
 '(hel-normal-state-fake-cursor ((t (:background "{{ $p.rose }}"))))
 '(hel-insert-state-fake-cursor ((t (:background "{{ $p.foam }}"))))
 '(hel-extend-selection-cursor ((t (:background "{{ $p.iris }}"))))
 '(hel-search-highlight ((t (:background "{{ $p.highlightMed }}"))))
 '(diff-added ((t (:foreground "{{ $p.pine }}"))))
 '(diff-removed ((t (:foreground "{{ $p.love }}"))))
 '(diff-hl-insert ((t (:foreground "{{ $p.pine }}" :background unspecified))))
 '(diff-hl-change ((t (:foreground "{{ $p.gold }}" :background unspecified))))
 '(diff-hl-delete ((t (:foreground "{{ $p.love }}" :background unspecified))))
 '(diff-hl-margin-insert ((t (:inherit diff-hl-insert))))
 '(diff-hl-margin-change ((t (:inherit diff-hl-change))))
 '(diff-hl-margin-delete ((t (:inherit diff-hl-delete))))
 '(doom-modeline-buffer-modified ((t (:foreground "{{ $p.gold }}" :weight bold))))
 '(doom-modeline-info ((t (:foreground "{{ $p.pine }}"))))
 '(doom-modeline-warning ((t (:foreground "{{ $p.gold }}"))))
 '(doom-modeline-urgent ((t (:foreground "{{ $p.love }}"))))
 '(doom-modeline-hel-normal-state ((t (:foreground "{{ $p.rose }}" :weight bold))))
 '(doom-modeline-hel-insert-state ((t (:foreground "{{ $p.foam }}" :weight bold))))
 '(magit-section-heading ((t (:foreground "{{ $p.rose }}" :weight bold))))
 '(magit-section-highlight ((t (:background "{{ $p.highlightLow }}"))))
 '(magit-branch-local ((t (:foreground "{{ $p.iris }}"))))
 '(magit-branch-remote ((t (:foreground "{{ $p.pine }}"))))
 '(magit-diff-added ((t (:foreground "{{ $p.pine }}" :background "{{ $p.surface }}"))))
 '(magit-diff-removed ((t (:foreground "{{ $p.love }}" :background "{{ $p.surface }}"))))
 '(magit-diff-added-highlight ((t (:foreground "{{ $p.pine }}" :background "{{ $p.highlightLow }}"))))
 '(magit-diff-removed-highlight ((t (:foreground "{{ $p.love }}" :background "{{ $p.highlightLow }}"))))
 '(header-line ((t (:foreground "{{ $p.text }}" :background "{{ $p.surface }}" :box nil))))
 '(help-key-binding ((t (:foreground "{{ $p.rose }}" :background "{{ $p.surface }}" :box nil))))
 '(which-key-key-face ((t (:foreground "{{ $p.rose }}"))))
 '(which-key-group-description-face ((t (:foreground "{{ $p.iris }}"))))
 '(flymake-error ((t (:underline (:style wave :color "{{ $p.love }}")))))
 '(flymake-warning ((t (:underline (:style wave :color "{{ $p.gold }}")))))
 '(flymake-note ((t (:underline (:style wave :color "{{ $p.foam }}")))))
 '(whitespace-space ((t (:foreground "{{ $p.highlightHigh }}" :background unspecified))))
 '(whitespace-tab ((t (:foreground "{{ $p.highlightHigh }}" :background unspecified))))
 '(whitespace-newline ((t (:foreground "{{ $p.highlightHigh }}" :background unspecified))))
 '(evy-status-normal ((t (:foreground "{{ $p.accentForeground }}" :background "{{ $p.accent }}" :weight bold))))
 '(evy-status-insert ((t (:foreground "{{ $p.base }}" :background "{{ $p.foam }}" :weight bold))))
 '(evy-status-select ((t (:foreground "{{ $p.base }}" :background "{{ $p.iris }}" :weight bold))))
 '(evy-status-modified ((t (:foreground "{{ $p.gold }}" :weight bold))))
 '(tab-line ((t (:foreground "{{ $p.text }}" :background "{{ $p.surface }}" :box nil))))
 '(tab-line-tab ((t (:foreground "{{ $p.placeholder }}" :background "{{ $p.surface }}" :box nil))))
 '(tab-line-tab-current ((t (:foreground "{{ $p.rose }}" :background "{{ $p.base }}" :underline t :weight bold :box nil))))
 '(tab-line-tab-inactive ((t (:foreground "{{ $p.placeholder }}" :background "{{ $p.surface }}" :box nil))))
 '(tab-line-highlight ((t (:foreground "{{ $p.rose }}" :background "{{ $p.highlightLow }}" :box nil))))
 '(org-block ((t (:background "{{ $p.surface }}"))))
 '(org-level-1 ((t (:foreground "{{ $p.rose }}" :weight bold))))
 '(org-level-2 ((t (:foreground "{{ $p.iris }}" :weight bold)))))

(provide-theme 't3-chat-{{ .variant }})

;;; t3-chat-{{ .variant }}-theme.el ends here
