  purpose_bold: {{ template "theme_rgb" (index $p "mauve") }} none Bold
  purpose_ellipsis: {{ template "theme_rgb" (index $p "overlay1") }} none

  scrollbar_track: {{ template "theme_rgb" (index $p "surface0") }} none
  scrollbar_thumb: {{ template "theme_rgb" (index $p "surface2") }} none

  good_to_bad_0: {{ template "theme_rgb" (index $p "green") }} none
  good_to_bad_1: {{ template "theme_rgb" (index $p "teal") }} none
  good_to_bad_2: {{ template "theme_rgb" (index $p "sky") }} none
  good_to_bad_3: {{ template "theme_rgb" (index $p "blue") }} none
  good_to_bad_4: {{ template "theme_rgb" (index $p "sapphire") }} none
  good_to_bad_5: {{ template "theme_rgb" (index $p "lavender") }} none
  good_to_bad_6: {{ template "theme_rgb" (index $p "mauve") }} none
  good_to_bad_7: {{ template "theme_rgb" (index $p "peach") }} none
