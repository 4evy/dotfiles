  help_table_border: {{ template "theme_rgb" (index $p "overlay0") }} none

  hex_null: {{ template "theme_rgb" (index $p "text") }} none
  hex_ascii_graphic: {{ template "theme_rgb" (index $p "peach") }} none
  hex_ascii_whitespace: {{ template "theme_rgb" (index $p "green") }} none
