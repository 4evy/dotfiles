--color=header-border:{{ index $p "overlay0" }},footer-border:{{ index $p "overlay0" }},scrollbar:{{ index $p "overlay2" }},preview-scrollbar:{{ index $p "overlay2" }}
--color=separator:{{ index $p "surface2" }},gap-line:{{ index $p "surface2" }},label:{{ index $p "text" }},list-label:{{ index $p "text" }}
--color=preview-label:{{ index $p "rosewater" }},input-label:{{ index $p "rosewater" }},header-label:{{ index $p "rosewater" }},footer-label:{{ index $p "rosewater" }}
