{
  "chat.disableAIFeatures": true,
  "github.copilot.enable": {
    "*": false
  },
  "github.copilot.editor.enableCodeActions": false,
  "github.copilot.nextEditSuggestions.enabled": false,
  "editor.fontFamily": "'JetBrainsMono Nerd Font Mono', 'Noto Sans Mono', monospace",
  "editor.wordWrap": "on",
  "editor.mouseWheelZoom": true,
  "editor.renderWhitespace": "selection",
  "editor.linkedEditing": true,
  "editor.guides.bracketPairs": "active",
  "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
  "editor.accessibilitySupport": "off",
  "editor.semanticHighlighting.enabled": true,
  "workbench.editor.showIcons": true,
  "window.autoDetectColorScheme": true,
  "workbench.preferredDarkColorTheme": "Catppuccin Mocha",
  "workbench.preferredLightColorTheme": "Catppuccin Latte",
  "workbench.colorTheme": "Catppuccin Mocha",
  "workbench.iconTheme": "vs-seti",
  "catppuccin.accentColor": "pink",
  "catppuccin.bracketMode": "monochromatic",
  "catppuccin.extraBordersEnabled": true,
  "catppuccin.colorOverrides": {
    "mocha": {
      "rosewater": "{{- $brd := include `.chezmoitemplates/black_rose_doll_palette.json` | fromJson -}}{{- $light := index $brd `light` -}}{{- $dark := index $brd `dark` -}}{{ index $dark `rosewater` }}",
      "flamingo": "{{ index $dark `flamingo` }}",
      "pink": "{{ index $dark `pink` }}",
      "mauve": "{{ index $dark `mauve` }}",
      "red": "{{ index $dark `red` }}",
      "maroon": "{{ index $dark `maroon` }}",
      "peach": "{{ index $dark `peach` }}",
      "yellow": "{{ index $dark `yellow` }}",
      "green": "{{ index $dark `green` }}",
      "teal": "{{ index $dark `teal` }}",
      "sky": "{{ index $dark `sky` }}",
      "sapphire": "{{ index $dark `sapphire` }}",
      "blue": "{{ index $dark `blue` }}",
      "lavender": "{{ index $dark `lavender` }}",
      "text": "{{ index $dark `text` }}",
      "subtext1": "{{ index $dark `subtext1` }}",
      "subtext0": "{{ index $dark `subtext0` }}",
      "overlay2": "{{ index $dark `overlay2` }}",
      "overlay1": "{{ index $dark `overlay1` }}",
      "overlay0": "{{ index $dark `overlay0` }}",
      "surface2": "{{ index $dark `surface2` }}",
      "surface1": "{{ index $dark `surface1` }}",
      "surface0": "{{ index $dark `surface0` }}",
      "base": "{{ index $dark `base` }}",
      "mantle": "{{ index $dark `mantle` }}",
      "crust": "{{ index $dark `crust` }}"
    },
    "latte": {
      "rosewater": "{{ index $light `rosewater` }}",
      "flamingo": "{{ index $light `flamingo` }}",
      "pink": "{{ index $light `pink` }}",
      "mauve": "{{ index $light `mauve` }}",
      "red": "{{ index $light `red` }}",
      "maroon": "{{ index $light `maroon` }}",
      "peach": "{{ index $light `peach` }}",
      "yellow": "{{ index $light `yellow` }}",
      "green": "{{ index $light `green` }}",
      "teal": "{{ index $light `teal` }}",
      "sky": "{{ index $light `sky` }}",
      "sapphire": "{{ index $light `sapphire` }}",
      "blue": "{{ index $light `blue` }}",
      "lavender": "{{ index $light `lavender` }}",
      "text": "{{ index $light `text` }}",
      "subtext1": "{{ index $light `subtext1` }}",
      "subtext0": "{{ index $light `subtext0` }}",
      "overlay2": "{{ index $light `overlay2` }}",
      "overlay1": "{{ index $light `overlay1` }}",
      "overlay0": "{{ index $light `overlay0` }}",
      "surface2": "{{ index $light `surface2` }}",
      "surface1": "{{ index $light `surface1` }}",
      "surface0": "{{ index $light `surface0` }}",
      "base": "{{ index $light `base` }}",
      "mantle": "{{ index $light `mantle` }}",
      "crust": "{{ index $light `crust` }}"
    }
  },
  "workbench.colorCustomizations": {
    "[Catppuccin Mocha]": {
      "terminal.ansiBlack": "{{ index $dark `crust` }}",
      "terminal.ansiBrightBlack": "{{ index $dark `overlay0` }}",
      "terminal.ansiRed": "{{ index $dark `love` }}",
      "terminal.ansiBrightRed": "{{ index $dark `red` }}",
      "terminal.ansiGreen": "{{ index $dark `pine` }}",
      "terminal.ansiBrightGreen": "{{ index $dark `foam` }}",
      "terminal.ansiYellow": "{{ index $dark `gold` }}",
      "terminal.ansiBrightYellow": "{{ index $dark `yellow` }}",
      "terminal.ansiBlue": "{{ index $dark `pine` }}",
      "terminal.ansiBrightBlue": "{{ index $dark `foam` }}",
      "terminal.ansiMagenta": "{{ index $dark `rose` }}",
      "terminal.ansiBrightMagenta": "{{ index $dark `pink` }}",
      "terminal.ansiCyan": "{{ index $dark `foam` }}",
      "terminal.ansiBrightCyan": "{{ index $dark `teal` }}",
      "terminal.ansiWhite": "{{ index $dark `subtext1` }}",
      "terminal.ansiBrightWhite": "{{ index $dark `text` }}"
    },
    "[Catppuccin Latte]": {
      "activityBar.activeBorder": "{{ index $light `rose` }}",
      "activityBarBadge.background": "{{ index $light `rose` }}",
      "activityBarBadge.foreground": "{{ index $light `surface` }}",
      "focusBorder": "{{ index $light `rose` }}",
      "statusBar.background": "{{ index $light `love` }}",
      "statusBar.foreground": "{{ index $light `surface` }}",
      "statusBar.noFolderBackground": "{{ index $light `rose` }}",
      "statusBar.debuggingBackground": "{{ index $light `gold` }}",
      "statusBar.debuggingForeground": "{{ index $light `surface` }}",
      "tab.activeBorderTop": "{{ index $light `rose` }}",
      "terminal.ansiBlack": "{{ index $light `subtext1` }}",
      "terminal.ansiBrightBlack": "{{ index $light `subtext0` }}",
      "terminal.ansiRed": "{{ index $light `love` }}",
      "terminal.ansiBrightRed": "{{ index $light `red` }}",
      "terminal.ansiGreen": "{{ index $light `pine` }}",
      "terminal.ansiBrightGreen": "{{ index $light `foam` }}",
      "terminal.ansiYellow": "{{ index $light `gold` }}",
      "terminal.ansiBrightYellow": "{{ index $light `yellow` }}",
      "terminal.ansiBlue": "{{ index $light `pine` }}",
      "terminal.ansiBrightBlue": "{{ index $light `foam` }}",
      "terminal.ansiMagenta": "{{ index $light `rose` }}",
      "terminal.ansiBrightMagenta": "{{ index $light `pink` }}",
      "terminal.ansiCyan": "{{ index $light `foam` }}",
      "terminal.ansiBrightCyan": "{{ index $light `teal` }}",
      "terminal.ansiWhite": "{{ index $light `surface2` }}",
      "terminal.ansiBrightWhite": "{{ index $light `surface1` }}"
    }
  },
  "window.zoomLevel": 1.5,
  "window.titleBarStyle": "custom",
  "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font Mono', 'Noto Sans Mono', monospace",
  "terminal.integrated.minimumContrastRatio": 1,
  "terminal.integrated.macOptionIsMeta": true,
  "files.trimTrailingWhitespace": true,
  "files.trimFinalNewlines": true,
  "files.insertFinalNewline": true,
  "diffEditor.ignoreTrimWhitespace": false,
  "security.workspace.trust.enabled": false,
  "telemetry.telemetryLevel": "off",
  "git.enableCommitSigning": true,
  "git.mergeEditor": true,
  "git.branchProtection": ["main", "master"],
  "git.branchProtectionPrompt": "alwaysCommitToNewBranch",
  "git.branchRandomName.enable": true,
  "js/ts.experimental.useTsgo": true,
  "js/ts.inlayHints.parameterNames.enabled": "literals",
  "js/ts.inlayHints.parameterTypes.enabled": true,
  "js/ts.inlayHints.functionLikeReturnTypes.enabled": true,
  "js/ts.preferences.preferTypeOnlyAutoImports": true,
  "js/ts.suggest.completeFunctionCalls": true,
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "python.languageServer": "None",
  "python.useEnvironmentsExtension": true,
  "python.defaultInterpreterPath": "{{- if lookPath `python` -}}{{ lookPath `python` }}{{- else if lookPath `python3` -}}{{ lookPath `python3` }}{{- else -}}python{{- end -}}",
  "python.experiments.enabled": false,
  "python-envs.terminal.autoActivationType": "shellStartup",
  "ty.importStrategy": "fromEnvironment",
  "ty.path": ["{{- if lookPath `ty` -}}{{ lookPath `ty` }}{{- else -}}ty{{- end -}}"],
  "ruff.importStrategy": "fromEnvironment",
  "ruff.path": [
    "{{- if lookPath `ruff` -}}{{ lookPath `ruff` }}{{- else -}}ruff{{- end -}}"
  ],
  "ruff.nativeServer": "on",
  "C_Cpp.codeAnalysis.clangTidy.path": "{{- if lookPath `clang-tidy` -}}{{ lookPath `clang-tidy` }}{{- else if stat `/opt/homebrew/opt/llvm/bin/clang-tidy` -}}/opt/homebrew/opt/llvm/bin/clang-tidy{{- else -}}clang-tidy{{- end -}}",
  "path-intellisense.autoSlashAfterDirectory": true,
  "path-intellisense.autoTriggerNextSuggestion": true,
  "markdownlint.run": "onSave",
  "vscode-just.runInTerminal": true,
  "stylua.searchBinaryInPATH": true,
  "stylua.disableVersionCheck": true,
  "systemd.version": "latest",
  "containers.containerClient": "com.microsoft.visualstudio.containers.{{- if lookPath `podman` -}}podman{{- else -}}docker{{- end -}}",
  "containers.orchestratorClient": "com.microsoft.visualstudio.orchestrators.{{- if lookPath `podman` -}}podmancompose{{- else -}}dockercompose{{- end -}}",
  "ansible.lightspeed.enabled": false,
  "ansible.lightspeed.suggestions.enabled": false,
  "ansible.mcpServer.enabled": false,
  "errorLens.delay": 250,
  "errorLens.enabledDiagnosticLevels": ["error", "warning"],
  "errorLens.messageMaxChars": 160,
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    }
  },
  "[go]": {
    "editor.defaultFormatter": "golang.go",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    }
  },
  "[shellscript]": {
    "editor.defaultFormatter": "mkhl.shfmt"
  },
  "[dockerfile]": {
    "editor.defaultFormatter": "ms-azuretools.vscode-containers",
    "editor.formatOnSave": true
  },
  "[meson]": {
    "editor.defaultFormatter": "mesonbuild.mesonbuild",
    "editor.formatOnSave": true
  },
  "[nix]": {
    "editor.defaultFormatter": "jnoortheen.nix-ide",
    "editor.formatOnPaste": true,
    "editor.formatOnSave": true,
    "editor.formatOnType": true
  },
  "[javascript]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.formatOnPaste": true,
    "editor.formatOnSave": true,
    "editor.formatOnType": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.biome": "explicit",
      "source.organizeImports.biome": "explicit"
    }
  },
  "[typescript]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.formatOnPaste": true,
    "editor.formatOnSave": true,
    "editor.formatOnType": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.biome": "explicit",
      "source.organizeImports.biome": "explicit"
    }
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.formatOnPaste": true,
    "editor.formatOnSave": true,
    "editor.formatOnType": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.biome": "explicit",
      "source.organizeImports.biome": "explicit"
    }
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.formatOnPaste": true,
    "editor.formatOnSave": true,
    "editor.formatOnType": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.biome": "explicit",
      "source.organizeImports.biome": "explicit"
    }
  },
  "[html][css][scss][less][postcss]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[svelte]": {
    "editor.defaultFormatter": "svelte.svelte-vscode",
    "editor.formatOnSave": true
  },
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features",
    "editor.formatOnSave": true
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features",
    "editor.formatOnSave": true
  },
  "[yaml]": {
    "editor.defaultFormatter": "redhat.vscode-yaml",
    "editor.formatOnSave": true
  },
  "[toml]": {
    "editor.defaultFormatter": "tamasfe.even-better-toml",
    "editor.formatOnSave": true
  },
  "[lua]": {
    "editor.defaultFormatter": "johnnymorganz.stylua",
    "editor.formatOnSave": true
  },
  "[xml]": {
    "editor.defaultFormatter": "redhat.vscode-xml",
    "editor.formatOnSave": true
  },
  "[kdl]": {
    "editor.defaultFormatter": "kdl-org.kdl",
    "editor.formatOnSave": true
  },
  "[typst]": {
    "editor.defaultFormatter": "myriad-dreamin.tinymist",
    "editor.formatOnSave": true
  },
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "nix.enableLanguageServer": true,
  "nix.serverPath": "{{- if lookPath `vscode-nixd` -}}{{ lookPath `vscode-nixd` }}{{- else if lookPath `nixd` -}}{{ lookPath `nixd` }}{{- else if lookPath `nil` -}}{{ lookPath `nil` }}{{- else -}}nixd{{- end -}}",
  "nix.formatterPath": "{{- if lookPath `vscode-nixfmt` -}}{{ lookPath `vscode-nixfmt` }}{{- else if lookPath `nixfmt` -}}{{ lookPath `nixfmt` }}{{- else -}}nixfmt{{- end -}}",
  "nix.serverSettings": {
    "nil": {
      "formatting": {
        "command": [
          "{{- if lookPath `vscode-nixfmt` -}}{{ lookPath `vscode-nixfmt` }}{{- else if lookPath `nixfmt` -}}{{ lookPath `nixfmt` }}{{- else -}}nixfmt{{- end -}}"
        ]
      }
    },
    "nixd": {
      "formatting": {
        "command": [
          "{{- if lookPath `vscode-nixfmt` -}}{{ lookPath `vscode-nixfmt` }}{{- else if lookPath `nixfmt` -}}{{ lookPath `nixfmt` }}{{- else -}}nixfmt{{- end -}}"
        ]
      }
    }
  },
  "redhat.telemetry.enabled": false,
  "yaml.disableSchemaDetection": [
    "**/.github/workflows/*.yml",
    "**/.github/workflows/*.yaml",
    "**/.gitea/workflows/*.yml",
    "**/.gitea/workflows/*.yaml",
    "**/.forgejo/workflows/*.yml",
    "**/.forgejo/workflows/*.yaml"
  ],
  "json.schemaDownload.trustedDomains": {
    "https://schemastore.azurewebsites.net/": true,
    "https://raw.githubusercontent.com/": true,
    "https://www.schemastore.org/": true,
    "https://json.schemastore.org/": true,
    "https://json-schema.org/": true,
    "https://esm.sh": true
  }
}
