{{- $root := index . "root" -}}
{{- $variant := index . "variant" -}}
{{- $terminal := index . "terminal" -}}
{{- $t3 := $root.t3_chat -}}
{{- $p := index $t3 $variant -}}
add_newline = true
command_timeout = 5000
continuation_prompt = "[∙](subtle) "
format = "$directory$line_break$sudo$character$command_timeout"
palette = "t3_chat_{{ $variant }}"
right_format = "$cmd_duration$time"

[character]
error_symbol = "[💔 ❯ ](bold love)"
format = "$symbol"
success_symbol = "[🦋 ❯ ](bold sky)"

[cmd_duration]
format = "[took $duration]($style) "
min_time = 2000
style = "subtle"

[directory]
fish_style_pwd_dir_length = 1
format = "[🌈 $path]($style)[$read_only]($read_only_style) "
read_only = " 󰌾"
read_only_style = "bold love"
style = "bold pink"
truncate_to_repo = false
truncation_symbol = "../"

[palettes.t3_chat_{{ $variant }}]
{{ range $name := list
  "base" "blue" "crust" "flamingo" "green" "lavender" "love" "mantle"
  "maroon" "mauve" "overlay0" "overlay1" "overlay2" "peach" "pink" "red"
  "rose" "rosewater" "sapphire" "sky" "subtle" "subtext0" "subtext1"
  "surface0" "surface1" "surface2" "teal" "text" "yellow" -}}
{{ $name }} = "{{ index $p $name }}"
{{ end }}

[sudo]
disabled = false
format = "[$symbol]($style) "
style = "bold love"
symbol = "🔓 root"

[time]
disabled = false
format = "[✨ $time]($style)"
style = "subtle"
time_format = "%H:%M:%S"
