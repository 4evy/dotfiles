#!/usr/bin/env bash
# shellcheck shell=bash
set -euo pipefail

if command -v bun >/dev/null 2>&1; then
	bun_global_dir="$(dirname "$(bun pm bin --global)")/install/global"
	readonly bun_global_dir
	declare -a bun_packages=()

	queue_bun_package() {
		local package=$1
		local requested=$2
		local installed=
		local available

		if [[ -f $bun_global_dir/node_modules/$package/package.json ]]; then
			installed=$(jq -r '.version // empty' \
				"$bun_global_dir/node_modules/$package/package.json")
		fi
		available=$(bun pm --global view "$requested" version)
		if [[ $installed != "$available" ]]; then
			bun_packages+=("$requested")
		fi
	}

	queue_bun_package opencode-ai opencode-ai
	if ((${#bun_packages[@]})); then
		bun add --global "${bun_packages[@]}"
	fi

	readonly codex_package=@openai/codex@alpha
	readonly codex_dir="$bun_global_dir/node_modules/@openai/codex"
	readonly codex_bin="$codex_dir/bin/codex.js"
	codex_available=$(bun pm --global view "$codex_package" version)
	codex_installed=
	if [[ -f $codex_dir/package.json ]]; then
		codex_installed=$(jq -r '.version // empty' "$codex_dir/package.json")
	fi
	if [[ $codex_installed != "$codex_available" ]]; then
		bun add --global "$codex_package"
	fi

	codex_version=$("$codex_bin" --version 2>/dev/null || :)
	if [[ $codex_version != "codex-cli $codex_available" ]]; then
		bun remove --global @openai/codex
		bun add --global "$codex_package"
		codex_version=$("$codex_bin" --version)
	fi
	if [[ $codex_version != "codex-cli $codex_available" ]]; then
		printf 'Codex CLI version %s does not match package version %s\n' \
			"$codex_version" "$codex_available" >&2
		exit 1
	fi

	if daemon_state=$("$codex_bin" app-server daemon version 2>/dev/null); then
		managed_codex_path=$(jq -r '.managedCodexPath // empty' <<<"$daemon_state")
		managed_codex_version=$(jq -r '.managedCodexVersion // empty' <<<"$daemon_state")
		if [[ -n $managed_codex_path && $managed_codex_version != "$codex_available" ]]; then
			"$codex_bin" app-server daemon update --from-cli --yes
		fi
	fi
fi

# Chezmoi renders this assignment before execution.
# shellcheck disable=SC1083,SC2034
readonly home_dir={{ quote .chezmoi.homeDir }}
readonly local_bin_dir="$home_dir/.local/bin"
readonly zsh_completion_dir="$home_dir/.cache/zsh/completions"
readonly bash_completion_dir="$home_dir/.local/share/bash-completion/completions"
mkdir -p "$local_bin_dir" "$zsh_completion_dir" "$bash_completion_dir"

if [[ $(uname -s) == Linux ]] && command -v nix >/dev/null 2>&1; then
	readonly chatgpt_package_dir="$home_dir/.local/share/nix/chatgpt"
	if [[ -f $chatgpt_package_dir/flake.nix ]]; then
		if nix profile list --json | jq -e '.elements.chatgpt' >/dev/null; then
			nix profile upgrade chatgpt
		else
			nix profile install "path:$chatgpt_package_dir#chatgpt"
		fi
	fi
fi
