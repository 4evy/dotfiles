#!/usr/bin/env ruby
# frozen_string_literal: true

require "English"
require "fileutils"
require "json"
require "pathname"
require "tempfile"

# Synchronizes optional plugins from ChatGPT's bundled Codex marketplace into
# the compatibility marketplace used by standalone Codex sessions.
# rubocop:disable Style/OneClassPerFile
module CodexPlugins
  MARKETPLACE = "dotfiles-chatgpt-bundled"
  SOURCE = Pathname(
    "/Applications/ChatGPT.app/Contents/Resources/plugins/openai-bundled",
  ).freeze
  MATERIALIZED = (
    Pathname(Dir.home)/".codex/.tmp/bundled-marketplaces/openai-bundled"
  ).freeze
  DESTINATION = (
    Pathname(Dir.home)/".codex/.tmp/compatibility-marketplaces"/MARKETPLACE
  ).freeze
  CODEX = (SOURCE.parent.parent/"codex-cli/bin/codex").freeze
  PLUGINS = %w[
    codex-app-tools
    sites
    browser
    chrome
    computer-use
    deep-research
    user-writing
    visualize
    latex
  ].freeze

  module_function

  def sync
    unless SOURCE.directory?
      warn "private-application-configurer: ChatGPT is absent; skipping Codex plugins"
      return false
    end
    unless MATERIALIZED.directory?
      warn "private-application-configurer: bundled Codex marketplace is absent; skipping"
      return false
    end

    source_manifest = load_manifest(SOURCE)
    materialized_manifest = load_manifest(MATERIALIZED)
    source_entries = source_manifest.fetch("plugins").to_h do |entry|
      [entry.fetch("name"), entry]
    end
    materialized_entries = materialized_manifest.fetch("plugins").to_h do |entry|
      [entry.fetch("name"), entry]
    end
    entries = source_entries.merge(materialized_entries)

    destination_entries = PLUGINS.filter_map do |name|
      entry = entries[name]
      next unless entry

      materialized = MATERIALIZED/"plugins"/name
      source = materialized.directory? ? materialized : SOURCE/"plugins"/name
      next unless source.directory?

      destination = DESTINATION/"plugins"/name
      unless destination.symlink? && destination.readlink == source
        FileUtils.rm_rf(destination)
        destination.dirname.mkpath
        FileUtils.ln_s(source, destination)
      end
      entry
    end

    destination_manifest = source_manifest.merge(
      "name"    => MARKETPLACE,
      "plugins" => destination_entries,
    )
    (DESTINATION/".agents/plugins").mkpath
    write_manifest(DESTINATION, destination_manifest)
    raise "ChatGPT Codex CLI not found: #{CODEX}" unless CODEX.file?

    destination_entries.each do |entry|
      system(
        CODEX.to_s,
        "plugin",
        "add",
        "#{entry.fetch('name')}@#{MARKETPLACE}",
        exception: true,
      )
    end
    warn "private-application-configurer: bundled Codex plugins are current"
    true
  end

  def load_manifest(root)
    path = root/".agents/plugins/marketplace.json"
    data = JSON.load_file(path)
    unless data.is_a?(Hash) &&
           data["plugins"].is_a?(Array) &&
           data["plugins"].all? do |entry|
             entry.is_a?(Hash) && entry["name"].is_a?(String)
           end
      raise "invalid ChatGPT marketplace manifest: #{path}"
    end

    data
  end

  def write_manifest(root, manifest)
    path = root/".agents/plugins/marketplace.json"
    Tempfile.create([".marketplace.", ".json"], path.dirname.to_s) do |file|
      file.write(JSON.pretty_generate(manifest))
      file.write("\n")
      file.flush
      file.fsync
      file.close
      File.rename(file.path, path)
    end
  end
end

# Makes Computer Use follow unrestricted local Codex config.
module ComputerUse
  PATCHER = Pathname(Dir.home)/".local/bin/patch-chatgpt-computer-use"
  APP = Pathname("/Applications/ChatGPT.app")

  module_function

  def patch
    unless APP.directory?
      warn "private-application-configurer: ChatGPT is absent; skipping Computer Use patch"
      return false
    end
    unless PATCHER.executable?
      warn "private-application-configurer: Computer Use patcher is absent; skipping"
      return false
    end

    return true if system(PATCHER.to_s)

    status = $CHILD_STATUS.exitstatus
    message = "private-application-configurer: Computer Use patch failed"
    message += " (exit #{status})" if status
    warn message
    false
  end
end
# rubocop:enable Style/OneClassPerFile

if $PROGRAM_NAME == __FILE__
  begin
    unless ARGV == ["configure"] || ARGV.empty?
      warn "private-application-configurer: usage: configure"
      exit 1
    end
    CodexPlugins.sync
    ComputerUse.patch
  rescue StandardError => e
    warn "private-application-configurer: error: #{e.message}"
    exit 1
  end
end
