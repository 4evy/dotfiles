#!/usr/bin/env bash
# shellcheck shell=bash
set -euo pipefail

case "$#" in
	0) ;;
	1)
		if [[ $1 != --check ]]; then
			printf '%s\n' "usage: update-chatgpt-nix [--check]" >&2
			exit 2
		fi
		;;
	*)
		printf '%s\n' "usage: update-chatgpt-nix [--check]" >&2
		exit 2
		;;
esac

readonly data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
readonly package_dir="$data_home/nix/chatgpt"
readonly package_target="$package_dir/package.nix"
readonly repository="${DOTFILES_REPOSITORY:-$HOME/dotfiles}"

if [[ ! -f $package_dir/flake.nix || ! -f $package_target ]]; then
	printf '%s\n' "the record-managed ChatGPT Nix package is unavailable" >&2
	exit 1
fi

if (($#)); then
	CHATGPT_PACKAGE_FILE="$package_target" \
		nix run "path:$package_dir#update-chatgpt" -- --check
	exit
fi

if [[ ! -f $repository/Justfile || ! -f $repository/secrets/records.yaml ]]; then
	printf '%s\n' "the dotfiles repository is unavailable at $repository" >&2
	exit 1
fi

records_workspace=$(mktemp -d "${TMPDIR:-/tmp}/chatgpt-records.XXXXXX")
chmod 700 "$records_workspace"
cleanup() {
	rm -rf -- "$records_workspace"
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

(
	cd "$repository"
	just records-unpack "$records_workspace"
)

package_body=
for record_metadata in "$records_workspace"/t0/*/metadata.json; do
	if jq -e --arg target ".local/share/nix/chatgpt/package.nix" \
		'any(.paths[]?; . == $target)' "$record_metadata" >/dev/null; then
		package_body="${record_metadata%/metadata.json}/body"
		break
	fi
done
if [[ -z $package_body ]]; then
	printf '%s\n' "the ChatGPT package record is unavailable" >&2
	exit 1
fi

CHATGPT_PACKAGE_FILE="$package_body" \
	nix run "path:$package_dir#update-chatgpt"
(
	cd "$repository"
	just records-pack "$records_workspace"
)
install -m 600 "$package_body" "$package_target"

if nix profile list --json | jq -e '.elements.chatgpt' >/dev/null; then
	nix profile upgrade chatgpt
else
	nix profile install "path:$package_dir#chatgpt"
fi
