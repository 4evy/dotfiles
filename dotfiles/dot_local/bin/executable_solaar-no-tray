#!/usr/bin/env bash
# shellcheck shell=bash
set -euo pipefail

# Nix wraps Solaar with the Python and GTK environment required by its package.
solaar_executable="$(realpath "$(command -v solaar)")"
solaar_helper="${solaar_executable%/*}/solaar-no-tray"
if [[ -x "$solaar_helper" ]]; then
	exec "$solaar_helper" "$@"
fi

# Fedora's Solaar modules live in the system Python, not uv's isolated runtime.
exec /usr/bin/python3.14 -s "$HOME/.local/lib/python/solaar_no_tray.py" "$@"
