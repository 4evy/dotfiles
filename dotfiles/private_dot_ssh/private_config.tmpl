{{- $onePasswordAgent := "%d/.1password/agent.sock" -}}
{{- if eq .chezmoi.os "darwin" -}}
{{- $onePasswordAgent = "%d/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock" -}}
{{- end }}
# Optional host-to-key mappings generated by 1Password SSH Bookmarks.
Include ~/.ssh/1Password/config

Host github github.com
  Hostname github.com
  Port 22
  User git
  ForwardAgent no
  UserKnownHostsFile ~/.ssh/known_hosts ~/.ssh/known_hosts.d/github

Host codeberg.org
  Hostname codeberg.org
  Port 22
  User git
  ForwardAgent no
  UserKnownHostsFile ~/.ssh/known_hosts ~/.ssh/known_hosts.d/codeberg

Host fedora fedora.*.ts.net fedora.*.ts.net. 100.123.214.78 ublue
  # Forward 1Password directly even when the launching shell has no
  # SSH_AUTH_SOCK (for example, an older already-running terminal session).
  IdentityAgent "{{ $onePasswordAgent }}"
  ForwardAgent yes

Match host * exec "test -z \"$SSH_CONNECTION\" && test -z \"$SSH_AUTH_SOCK\""
  IdentityAgent "{{ $onePasswordAgent }}"

Host *
  AddKeysToAgent no
  ForwardAgent no
  HashKnownHosts yes
  SendEnv LC_TERMINAL_THEME
