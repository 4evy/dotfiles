{
  "name": "dotfiles-workstation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build --compile src/cli.ts --outfile dist/workstation",
    "check": "tsc --noEmit -p tsconfig.json && bun run check:fallow",
    "check:fallow": "bun x --no-install fallow dead-code --config .fallowrc.jsonc && bun x --no-install fallow health --complexity --max-crap 0 --config .fallowrc.jsonc",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "fast-xml-parser": "5.11.2",
    "fast-xml-validator": "1.4.2",
    "fflate": "0.8.3",
    "suncalc": "2.1.1",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "typescript": "7.0.2"
  }
}
