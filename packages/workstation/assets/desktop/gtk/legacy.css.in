/* Generated from the shared palette for GTK3 and pre-1.6 libadwaita */
@define-color accent_color ${accent};
@define-color accent_bg_color ${accent};
@define-color accent_fg_color ${accentForeground};
@define-color window_bg_color ${canvas};
@define-color window_fg_color ${text};
@define-color view_bg_color ${surface};
@define-color view_fg_color ${text};
@define-color headerbar_bg_color ${toolbar};
@define-color headerbar_fg_color ${toolbarForeground};
@define-color headerbar_border_color ${toolbarBorder};
@define-color headerbar_backdrop_color ${toolbar};
@define-color sidebar_bg_color ${sidebar};
@define-color sidebar_fg_color ${sidebarForeground};
@define-color sidebar_backdrop_color ${sidebar};
@define-color sidebar_border_color ${sidebarBorder};
@define-color secondary_sidebar_bg_color ${surface};
@define-color secondary_sidebar_fg_color ${text};
@define-color secondary_sidebar_backdrop_color ${surface};
@define-color card_bg_color ${surfaceRaised};
@define-color card_fg_color ${text};
@define-color dialog_bg_color ${surfaceOverlay};
@define-color dialog_fg_color ${text};
@define-color popover_bg_color ${surfaceOverlay};
@define-color popover_fg_color ${text};
@define-color thumbnail_bg_color ${surfaceRaised};
@define-color thumbnail_fg_color ${text};
@define-color destructive_bg_color ${error};
@define-color destructive_fg_color ${accentForeground};
@define-color destructive_color ${errorForeground};
@define-color error_bg_color ${error};
@define-color error_fg_color ${accentForeground};
@define-color error_color ${errorForeground};
@define-color success_bg_color ${success};
@define-color success_fg_color ${accentForeground};
@define-color success_color ${successForeground};
@define-color warning_bg_color ${warning};
@define-color warning_fg_color ${accentForeground};
@define-color warning_color ${warningForeground};
@define-color theme_bg_color ${canvas};
@define-color theme_fg_color ${text};
@define-color theme_base_color ${surface};
@define-color theme_text_color ${text};
@define-color theme_selected_bg_color ${accent};
@define-color theme_selected_fg_color ${accentForeground};
@define-color theme_unfocused_bg_color ${canvas};
@define-color theme_unfocused_fg_color ${textMuted};
@define-color theme_unfocused_base_color ${surface};
@define-color theme_unfocused_text_color ${textMuted};
@define-color theme_unfocused_selected_bg_color ${accent};
@define-color theme_unfocused_selected_fg_color ${accentForeground};
@define-color borders ${border};
@define-color unfocused_borders ${border};

/* GTK3 hardcodes white action text instead of using the accent foreground */
button.suggested-action:not(:disabled) {
  color: @accent_fg_color;
}

selection {
  background-color: @accent_bg_color;
  color: @accent_fg_color;
}
