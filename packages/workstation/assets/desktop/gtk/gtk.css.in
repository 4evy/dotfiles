/* GTK4 uses CSS variables, older apps still consume the named colors */
${legacy}

:root {
  --accent-bg-color: ${accent};
  --accent-fg-color: ${accentForeground};
  --accent-color: oklab(from var(--accent-bg-color) var(--standalone-color-oklab));
  --window-bg-color: ${canvas};
  --window-fg-color: ${text};
  --view-bg-color: ${surface};
  --view-fg-color: ${text};
  --headerbar-bg-color: ${toolbar};
  --headerbar-fg-color: ${toolbarForeground};
  --headerbar-border-color: ${toolbarBorder};
  --headerbar-backdrop-color: ${toolbar};
  --sidebar-bg-color: ${sidebar};
  --sidebar-fg-color: ${sidebarForeground};
  --sidebar-backdrop-color: ${sidebar};
  --secondary-sidebar-bg-color: ${surface};
  --secondary-sidebar-fg-color: ${text};
  --secondary-sidebar-backdrop-color: ${surface};
  --card-bg-color: ${surfaceRaised};
  --card-fg-color: ${text};
  --dialog-bg-color: ${surfaceOverlay};
  --dialog-fg-color: ${text};
  --popover-bg-color: ${surfaceOverlay};
  --popover-fg-color: ${text};
  --thumbnail-bg-color: ${surfaceRaised};
  --thumbnail-fg-color: ${text};
  --overview-bg-color: ${surface};
  --overview-fg-color: ${text};
  --active-toggle-bg-color: ${surfaceRaised};
  --active-toggle-fg-color: ${text};
  --destructive-bg-color: ${error};
  --destructive-fg-color: ${accentForeground};
  --destructive-color: ${errorForeground};
  --error-bg-color: ${error};
  --error-fg-color: ${accentForeground};
  --error-color: ${errorForeground};
  --success-bg-color: ${success};
  --success-fg-color: ${accentForeground};
  --success-color: ${successForeground};
  --warning-bg-color: ${warning};
  --warning-fg-color: ${accentForeground};
  --warning-color: ${warningForeground};
}
