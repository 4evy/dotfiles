diff --git a/packages/coding-agent/src/tools/browser/workspace.ts b/packages/coding-agent/src/tools/browser/workspace.ts
new file mode 100644
--- /dev/null
+++ b/packages/coding-agent/src/tools/browser/workspace.ts
@@ -0,0 +1,46 @@
+import * as fs from "node:fs/promises";
+import * as os from "node:os";
+import * as path from "node:path";
+import { ToolError } from "@oh-my-pi/pi-tui/tools/tool-errors";
+
+export interface WorkspaceBrowserLaunch {
+	executablePath: string;
+	args: string[];
+}
+
+export async function isolateBrowserLaunch(
+	executablePath: string,
+	args: string[],
+	headless: boolean,
+	rejectProfileReuse = false,
+): Promise<WorkspaceBrowserLaunch> {
+	if (process.platform !== "linux" || headless) return { executablePath, args };
+	const helper = path.join(
+		process.env.XDG_DATA_HOME ?? path.join(os.homedir(), ".local/share"),
+		"omp-helper/current/bin/omp-helper-desktop",
+	);
+	try {
+		await fs.access(helper, fs.constants.X_OK);
+	} catch {
+		throw new ToolError("Headed Linux browsers require an installed omp-helper with GNOME workspace isolation");
+	}
+	if (args.some(arg => arg.startsWith("--ozone-platform=") && arg !== "--ozone-platform=wayland")) {
+		throw new ToolError("Isolated Linux browsers require native Wayland, not X11");
+	}
+	const profile = args.find(arg => arg.startsWith("--user-data-dir="))?.slice("--user-data-dir=".length);
+	if (!profile || !path.isAbsolute(profile)) {
+		throw new ToolError("An isolated Linux browser requires a dedicated absolute --user-data-dir");
+	}
+	if (rejectProfileReuse) {
+		try {
+			await fs.lstat(path.join(profile, "SingletonLock"));
+			throw new ToolError("The requested browser profile is already in use; refusing to reuse a window outside the isolated workspace");
+		} catch (error) {
+			if (!(error instanceof Error && "code" in error && error.code === "ENOENT")) throw error;
+		}
+	}
+	return {
+		executablePath: helper,
+		args: ["workspace-run", "--", executablePath, ...args, "--ozone-platform=wayland"],
+	};
+}
