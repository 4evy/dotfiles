--- /dev/null
+++ b/packages/coding-agent/src/ssh/transfer-compression.ts
@@ -0,0 +1,72 @@
+import { isIP } from "node:net";
+import { networkInterfaces } from "node:os";
+import { $which, ptree } from "@oh-my-pi/pi-utils";
+import { buildRemoteCommand, ensureConnection, ensureHostInfo, type SSHConnectionTarget } from "./connection-manager";
+import { wrapInPosixShell } from "./utils";
+
+function address(value: string): string {
+	const bare = (value.replace(/^\[|\]$/g, "").split("%")[0] ?? "").toLowerCase();
+	if (isIP(bare) === 6) {
+		const normalized = new URL(`http://[${bare}]/`).hostname.slice(1, -1);
+		const mapped = /^::ffff:([0-9a-f]+):([0-9a-f]+)$/.exec(normalized);
+		if (mapped) {
+			const high = Number.parseInt(mapped[1] ?? "", 16);
+			const low = Number.parseInt(mapped[2] ?? "", 16);
+			return `${high >>> 8}.${high & 255}.${low >>> 8}.${low & 255}`;
+		}
+		return normalized;
+	}
+	return bare;
+}
+
+/** Inspect the authenticated server's actual endpoint, not its OpenSSH alias */
+export async function isSameMachineSSH(
+	target: SSHConnectionTarget,
+	opts: { controlPath?: string; signal?: AbortSignal | undefined; timeoutMs?: number } = {},
+): Promise<boolean> {
+	await ensureConnection(target);
+	const info = await ensureHostInfo(target);
+	if (!info.transferShell) throw new Error("SSH transfer requires a verified POSIX shell");
+	const args = await buildRemoteCommand(target, wrapInPosixShell(info.transferShell, 'printf "%s\\n" "$SSH_CONNECTION"'));
+	if (opts.controlPath) args.unshift("-o", `ControlPath=${opts.controlPath}`);
+	using child = ptree.spawn(["ssh", ...args], {
+		signal: ptree.combineSignals(opts.signal, opts.timeoutMs ?? 30_000),
+	});
+	const connection = (await child.text()).trim().split(/\s+/);
+	await child.exitedCleanly;
+	const serverAddress = connection[2];
+	if (connection.length !== 4 || !serverAddress || !isIP(serverAddress.split("%")[0] ?? "")) {
+		throw new Error("SSH server did not report its actual endpoint in SSH_CONNECTION");
+	}
+	const endpoint = address(serverAddress);
+	if (endpoint === "::1" || (isIP(endpoint) === 4 && endpoint.startsWith("127."))) return true;
+	return Object.values(networkInterfaces()).some(entries =>
+		entries?.some(entry => address(entry.address) === endpoint),
+	);
+}
+
+export function requireZstd(): void {
+	if (!$which("zstd")) throw new Error("Remote file transfers require zstd on the local and remote PATH; no gzip fallback is used");
+}
+
+/** Drain without allowing a remote decoder to exceed the requested byte bound */
+export async function boundedTransferBytes(stream: ReadableStream<Uint8Array>, limit: number): Promise<Uint8Array> {
+	const reader = stream.getReader();
+	const chunks: Uint8Array[] = [];
+	let length = 0;
+	try {
+		while (true) {
+			const { done, value } = await reader.read();
+			if (done) break;
+			length += value.length;
+			if (length > limit) {
+				await reader.cancel("SSH transfer exceeded its byte bound");
+				throw new Error("SSH transfer exceeded its byte bound");
+			}
+			chunks.push(value);
+		}
+	} finally {
+		reader.releaseLock();
+	}
+	return Buffer.concat(chunks, length);
+}
