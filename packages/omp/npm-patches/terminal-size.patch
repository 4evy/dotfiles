+	await child.exitedCleanly;
+	const serverAddress = connection[2];
+	if (connection.length !== 4 || !serverAddress || !isIP(serverAddress.split("%")[0] ?? "")) {
+		throw new Error("SSH server did not report its actual endpoint in SSH_CONNECTION");
+	}
+	const endpoint = address(serverAddress);
+	if (endpoint === "::1" || (isIP(endpoint) === 4 && endpoint.startsWith("127."))) return true;
+	return Object.values(networkInterfaces()).some(entries =>
+		entries?.some(entry => address(entry.address) === endpoint),
+	);
+}
+
+export function requireZstd(): void {
+	if (!$which("zstd")) throw new Error("Remote file transfers require zstd on the local and remote PATH; no gzip fallback is used");
+}
+
+/** Drain without allowing a remote decoder to exceed the requested byte bound */
+export async function boundedTransferBytes(stream: ReadableStream<Uint8Array>, limit: number): Promise<Uint8Array> {
+	const reader = stream.getReader();
+	const chunks: Uint8Array[] = [];
+	let length = 0;
+	try {
+		while (true) {
+			const { done, value } = await reader.read();
+			if (done) break;
+			length += value.length;
+			if (length > limit) {
+				await reader.cancel("SSH transfer exceeded its byte bound");
+				throw new Error("SSH transfer exceeded its byte bound");
+			}
+			chunks.push(value);
+		}
+	} finally {
+		reader.releaseLock();
+	}
+	return Buffer.concat(chunks, length);
+}
