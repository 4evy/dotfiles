(defcfg
  process-unmapped-keys yes
  linux-output-device-name "dotfiles-kanata-main"
  linux-dev-names-include (
    "ITE Tech. Inc. ITE Device(8910) Keyboard"
    "LIFT Mouse"
    "Pebble K380s"
    "solaar-keyboard"
  )
)

(deflocalkeys-linux
  my_extra_button 276
  my_side_button 275
)

(defsrc
  esc caps lsft rsft my_side_button my_extra_button w a s d ret \
)

(defvar
  tap-hold-ms 200
  shift-double-tap-ms 240
  volume-mute-hold-ms 1000
)

(defalias
  caps-hyper (tap-hold-press $tap-hold-ms $tap-hold-ms esc (multi lmet lctl lalt lsft (layer-while-held hyper)))
  vicinae-toggle (multi lmet lctl lalt lsft f24)
  left-shift (tap-dance $shift-double-tap-ms (lsft @vicinae-toggle))
  right-shift (tap-dance $shift-double-tap-ms (rsft @vicinae-toggle))
  volume-down-mute (tap-hold $tap-hold-ms $volume-mute-hold-ms vold mute)
  volume-up-mute (tap-hold $tap-hold-ms $volume-mute-hold-ms volu mute)
)

(deflayer base
  caps @caps-hyper @left-shift @right-shift @volume-down-mute @volume-up-mute w a s d ret \
)

(deflayer hyper
  _    _           _           _            _    _    w a s d ret \
)
