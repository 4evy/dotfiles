{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    "tools/{setup,renovate}/**/*.ts",
    "tools/workstation/install.ts",
    "systems/modules/darwin/**/*.ts",
    "packages/ghostty/source/*.ts",
    "systems/spectrum/recipes/spectrum/sources/sources.ts",
    "home/{deploy,applications,theme}/**/*.ts",
    "home/files/.omp/agent/extensions/**/*.ts",
    "home/files/.local/lib/{ghostty,helium,helix,solaar,vscode}/*.ts"
  ],
  "ignorePatterns": [
    "!home/files/.local/**",
    "!home/files/.omp/**",
    ".jj/**",
    ".venv/**",
    ".cache/**",
    "target/**",
    "zig-pkg/**",
    "zig-out/**",
    // This independently locked package runs Fallow through its own check script
    "tools/workstation/src/**",
    "tools/workstation/assets/**",
    "tools/tiling/vendor/**"
  ]
}
