{
  "name": "@dotfiles/workstation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./desktop": "./src/linux/desktop.ts",
    "./theme": "./src/lib/theme.ts",
    "./solar": "./src/lib/solar.ts",
    "./assets/gtk4": "./assets/desktop/gtk/gtk.css.in",
    "./assets/gtk3": "./assets/desktop/gtk/legacy.css.in",
    "./assets/kmscon": "./assets/kmscon/defaults.conf",
    "./assets/desktop": "./assets/linux/desktop.gjs"
  },
  "scripts": {
    "build": "bun build --compile --no-compile-autoload-dotenv --no-compile-autoload-bunfig src/cli.ts --outfile dist/workstation",
    "check": "bun run tsrs --noEmit -p tsconfig.json && bun run check:fallow",
    "check:fallow": "bun run fallow dead-code --config .fallowrc.jsonc && bun run fallow health --complexity --max-crap 0 --config .fallowrc.jsonc",
    "typecheck": "bun run tsrs --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@dotfiles/core": "workspace:*",
    "@dotfiles/home": "workspace:*",
    "@dotfiles/runtime": "workspace:*",
    "effect": "4.0.7",
    "fast-xml-builder": "1.3.1",
    "fast-xml-parser": "5.11.2",
    "fast-xml-validator": "1.4.2",
    "fflate": "0.8.3",
    "suncalc": "2.1.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929"
  }
}
