{
  "move-up": {
    "action": "cycle",
    "presets": ["top-half", "top-two-thirds", "top-third"],
    "kde": {
      "title": "Hyper Window Tiling: Move Up",
      "accelerator": "Meta+Ctrl+Alt+Shift+W"
    },
    "gnome": {
      "summary": "Cycle the focused window through top layouts",
      "accelerator": "<Super><Control><Alt><Shift>w"
    }
  },
