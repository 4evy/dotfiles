# syntax=docker/dockerfile:1@sha256:87999aa3d42bdc6bea60565083ee17e86d1f3339802f543c0d03998580f9cb89

ARG BLUEFIN_BASE_IMAGE=ghcr.io/ublue-os/bluefin-nvidia-open:stable@sha256:167d18ed51092b17687fbfcf5405e9efbc13414ddcfc5e5c5217b87beb0f074b
ARG BLUEFIN_BASE_IMAGE_NAME=bluefin-nvidia-open
ARG BLUEFIN_BASE_IMAGE_TAG=stable

# Build graph and cache contract
#
# 1. `uv`, `nix-tools`, and `spectrum-python` produce build-only tools in
#    independent stages. Later RUN instructions bind-mount their outputs, so the
#    tools are available during the build without shipping the Python venv.
# 2. The scratch stages contain narrowly scoped inputs. Buildah includes mounted
#    files in a RUN cache key, so keeping package, lockfile, source, and rootfs
#    inputs separate prevents an unrelated edit from invalidating every layer.
# 3. The final stage follows Bluefin's current two-phase cache pattern: expensive
#    package/program work happens before filesystem policy and the static overlay.
#    Per-build metadata is declared only after both, so a new commit SHA does not
#    rebuild Ghostty, KMSCON, or third-party RPMs.
# 4. Program families have separate RUN layers. A failed KMSCON build can resume
#    from cached app, extension, and Ghostty layers on the next attempt.
#
# Podman builds OCI-format images by default and ignores Dockerfile `SHELL`
# metadata for that format. Keep RUN bodies POSIX-compatible, or invoke bash
# explicitly inside the RUN that needs it; do not add a global SHELL directive.

FROM ghcr.io/astral-sh/uv:0.11.32@sha256:df4cae8f3a96d175e2e5f992e597550000edbe78fdc2594d5cd8de1a217f504c AS uv

# Build the Nix launchers once as a self-contained artifact. Only changes under
# spectrum/nix-tools should invalidate this stage.
FROM docker.io/library/debian:bookworm-slim@sha256:7b140f374b289a7c2befc338f42ebe6441b7ea838a042bbd5acbfca6ec875818 AS nix-tools

ARG DETERMINATE_NIX_INSTALLER_VERSION=v3.21.8
ADD --chmod=0755 \
    https://install.determinate.systems/nix/tag/${DETERMINATE_NIX_INSTALLER_VERSION}/nix-installer-x86_64-linux \
    /tmp/nix-installer
RUN printf '%s  %s\n' \
    'eecf66f62b044f40b0632d8e9ea72ffc3bd3214357d09317117febff748e71b3' \
    /tmp/nix-installer >/tmp/nix-installer.sha256 && \
    sha256sum --check /tmp/nix-installer.sha256 && \
    /tmp/nix-installer install linux \
    --extra-conf 'sandbox = false' \
    --init none \
    --no-confirm && \
    rm /tmp/nix-installer /tmp/nix-installer.sha256

ENV PATH="/nix/var/nix/profiles/default/bin:${PATH}"

COPY spectrum/nix-tools /src
WORKDIR /src
RUN nix build \
    --out-link /tmp/spectrum-nix-tools \
    .#bundle && \
    cp --dereference /tmp/spectrum-nix-tools /spectrum-nix-tools

FROM scratch AS rootfs
COPY spectrum/image/rootfs /

# These data-only stages are used as named bind-mount sources. Splitting them is
# intentional: a package-list edit should not rebuild the Python environment,
# and a Python edit should not invalidate the Fedora package transaction.
FROM scratch AS package-manifest
COPY spectrum/image/packages/required.txt /required.txt

FROM scratch AS systemd-manifest
COPY manifests/spectrum-systemd-units.txt /enabled-units.txt

FROM scratch AS python-project
COPY pyproject.toml uv.lock /

FROM scratch AS spectrum-program-common-source
# Shared program and source-catalog machinery is isolated from every concrete
# program module. A common HTTP/DNF/catalog change correctly rebuilds every
# consumer, while a KMSCON-only edit reaches only the KMSCON and final validation
# source stages below.
COPY packages/dotfiles-python/src/workstation/__init__.py \
    packages/dotfiles-python/src/workstation/errors.py \
    /src/packages/dotfiles-python/src/workstation/
COPY packages/dotfiles-python/src/workstation/lib/__init__.py \
    packages/dotfiles-python/src/workstation/lib/commands.py \
    packages/dotfiles-python/src/workstation/lib/files.py \
    packages/dotfiles-python/src/workstation/lib/http.py \
    packages/dotfiles-python/src/workstation/lib/manifests.py \
    packages/dotfiles-python/src/workstation/lib/platform.py \
    packages/dotfiles-python/src/workstation/lib/sources.py \
    packages/dotfiles-python/src/workstation/lib/validation.py \
    /src/packages/dotfiles-python/src/workstation/lib/
COPY manifests/sources.json manifests/sources.schema.json \
    manifests/spectrum-programs.toml manifests/spectrum-programs.schema.json \
    /src/manifests/
COPY spectrum/scripts/spectrum_build/__init__.py \
    spectrum/scripts/spectrum_build/cli.py \
    spectrum/scripts/spectrum_build/settings.py \
    /src/spectrum/scripts/spectrum_build/
COPY spectrum/scripts/spectrum_build/core /src/spectrum/scripts/spectrum_build/core
COPY spectrum/scripts/spectrum_build/integrations /src/spectrum/scripts/spectrum_build/integrations
COPY spectrum/scripts/spectrum_build/programs/__init__.py \
    spectrum/scripts/spectrum_build/programs/manifest.py \
    spectrum/scripts/spectrum_build/programs/models.py \
    spectrum/scripts/spectrum_build/programs/operations.py \
    /src/spectrum/scripts/spectrum_build/programs/

FROM spectrum-program-common-source AS spectrum-packaged-source
# Repository-backed and downloaded RPM applications share one cache boundary.
COPY spectrum/image/repos /src/spectrum/image/repos

FROM spectrum-program-common-source AS spectrum-extension-source
# Extension installers are fully data-driven by the shared program manifest.

FROM spectrum-program-common-source AS spectrum-ghostty-source
COPY patches /src/patches
COPY spectrum/scripts/spectrum_build/programs/ghostty.py \
    /src/spectrum/scripts/spectrum_build/programs/

FROM spectrum-program-common-source AS spectrum-kmscon-source
COPY spectrum/scripts/spectrum_build/programs/kmscon.py \
    /src/spectrum/scripts/spectrum_build/programs/

FROM spectrum-program-common-source AS spectrum-image-source
# Finalization and validation need the complete manifest/image modules, but they
# extend only the common source instead of widening any program cache key.
COPY manifests /src/manifests
COPY spectrum/image/packages/required.txt /src/spectrum/image/packages/
COPY spectrum/scripts/spectrum_build/programs /src/spectrum/scripts/spectrum_build/programs
COPY spectrum/scripts/spectrum_build/image /src/spectrum/scripts/spectrum_build/image
COPY spectrum/scripts/spectrum_build/manifests /src/spectrum/scripts/spectrum_build/manifests

FROM ${BLUEFIN_BASE_IMAGE} AS spectrum-python

# Resolve locked build-tool dependencies independently from Spectrum source and
# final-image package layers. The venv is bind-mounted into later RUN steps and
# is never committed to the shipped image. `--no-install-project` is what makes
# this layer depend only on pyproject.toml/uv.lock; project modules arrive later
# through the read-only source mounts and PYTHONPATH. Bluefin links /opt to
# mutable /var/opt, so replace the link with an image-backed directory before
# creating the stage artifact that later bind mounts consume.
COPY --from=uv /uv /usr/bin/uv
RUN --mount=type=bind,from=python-project,source=/,target=/project \
    --mount=type=cache,id=spectrum-uv,sharing=locked,target=/var/cache/uv \
    rm -rf /opt && \
    mkdir /opt && \
    /usr/bin/python3 -c \
    'import sys; assert sys.version_info[:2] == (3, 14), sys.version' && \
    export UV_CACHE_DIR=/var/cache/uv && \
    export UV_LINK_MODE=copy && \
    export UV_PROJECT_ENVIRONMENT=/opt/spectrum-build-venv && \
    uv --directory /project venv \
    --python /usr/bin/python3 \
    --no-python-downloads \
    --system-site-packages \
    /opt/spectrum-build-venv && \
    uv --directory /project sync \
    --locked \
    --no-dev \
    --no-install-project

FROM ${BLUEFIN_BASE_IMAGE} AS final

# bootc lint needs the marker while validating the filesystem. Keep volatile OCI
# provenance labels until the end so a new build timestamp cannot bust this layer.
LABEL containers.bootc=1

# Fedora composefs images cannot create new root-level mountpoints at runtime.
# Keep /nix non-empty so it survives the image-to-ostree deployment path.
# Bluefin links /root to /var/roothome, so create the target before tools use it.
RUN rm -rf /opt && \
    mkdir /opt /nix && \
    mkdir -p /var/roothome && \
    touch /nix/.spectrum-mountpoint

# Keep the stable Fedora package transaction independent from Python and custom
# program sources. Source-only edits can now reuse this expensive layer. The
# tmpfs mounts prevent package-manager logs/runtime files from entering the
# committed layer, while the cache mount preserves downloaded RPMs for rebuilds.
# `xargs` keeps the command POSIX-shell compatible; a Bash array would fail
# under Podman's default OCI output because OCI ignores SHELL metadata.
RUN --mount=type=bind,from=package-manifest,source=/required.txt,target=/required-packages.txt \
    --mount=type=cache,id=spectrum-dnf5,sharing=locked,target=/var/cache/libdnf5 \
    --mount=type=tmpfs,target=/boot \
    --mount=type=tmpfs,target=/var/log \
    --mount=type=tmpfs,target=/run \
    --mount=type=tmpfs,target=/tmp \
    test -s /required-packages.txt && \
    LC_ALL=C sort --check --unique /required-packages.txt && \
    xargs --no-run-if-empty \
        dnf5 -y install \
        --setopt=keepcache=True \
        --setopt=install_weak_deps=False \
        </required-packages.txt

# Tool artifacts start after the stable package layer so updates to their pinned
# builder images cannot invalidate the Fedora transaction.
COPY --from=uv /uv /usr/bin/uv
COPY --from=nix-tools /spectrum-nix-tools /usr/libexec/spectrum-nix-tools

# Install repository/RPM applications together because they share DNF and release
# lookup machinery. The optional GitHub token is a secret mount: release lookups
# can use it, but neither the token nor the Python build environment is shipped.
RUN --mount=type=bind,from=spectrum-python,source=/opt/spectrum-build-venv,target=/opt/spectrum-build-venv \
    --mount=type=bind,from=spectrum-packaged-source,source=/src,target=/src \
    --mount=type=cache,id=spectrum-dnf5,sharing=locked,target=/var/cache/libdnf5 \
    --mount=type=tmpfs,target=/boot \
    --mount=type=tmpfs,target=/var/log \
    --mount=type=tmpfs,target=/run \
    --mount=type=tmpfs,target=/tmp \
    --mount=type=secret,id=github_token,required=false \
    GITHUB_TOKEN="$(cat /run/secrets/github_token 2>/dev/null || true)" \
    PYTHONPATH=/src/packages/dotfiles-python/src:/src/spectrum/scripts \
    /opt/spectrum-build-venv/bin/python \
        -m spectrum_build.cli install-packaged-programs

# Copyous tracks a separate upstream release and has a small dependency set.
# Keeping it out of the RPM-app layer lets extension-only work restart here.
RUN --mount=type=bind,from=spectrum-python,source=/opt/spectrum-build-venv,target=/opt/spectrum-build-venv \
    --mount=type=bind,from=spectrum-extension-source,source=/src,target=/src \
    --mount=type=cache,id=spectrum-dnf5,sharing=locked,target=/var/cache/libdnf5 \
    --mount=type=tmpfs,target=/boot \
    --mount=type=tmpfs,target=/var/log \
    --mount=type=tmpfs,target=/run \
    --mount=type=tmpfs,target=/tmp \
    --mount=type=secret,id=github_token,required=false \
    GITHUB_TOKEN="$(cat /run/secrets/github_token 2>/dev/null || true)" \
    PYTHONPATH=/src/packages/dotfiles-python/src:/src/spectrum/scripts \
    /opt/spectrum-build-venv/bin/python \
        -m spectrum_build.cli install-extension-programs

# Ghostty and KMSCON are long source builds with independent failure/retry
# boundaries. Neither needs the GitHub API secret or package-manager cache.
RUN --mount=type=bind,from=spectrum-python,source=/opt/spectrum-build-venv,target=/opt/spectrum-build-venv \
    --mount=type=bind,from=spectrum-ghostty-source,source=/src,target=/src \
    --mount=type=tmpfs,target=/tmp \
    PYTHONPATH=/src/packages/dotfiles-python/src:/src/spectrum/scripts \
    /opt/spectrum-build-venv/bin/python -m spectrum_build.cli install-ghostty

# This separate layer is the cache boundary; combining it with Ghostty would
# discard a completed Ghostty build whenever KMSCON alone fails.
# hadolint ignore=DL3059
RUN --mount=type=bind,from=spectrum-python,source=/opt/spectrum-build-venv,target=/opt/spectrum-build-venv \
    --mount=type=bind,from=spectrum-kmscon-source,source=/src,target=/src \
    --mount=type=tmpfs,target=/tmp \
    PYTHONPATH=/src/packages/dotfiles-python/src:/src/spectrum/scripts \
    /opt/spectrum-build-venv/bin/python -m spectrum_build.cli install-kmscon

# Image policy is a separate cheap phase. Because it mounts the broader image
# source stage, shell/metadata validation edits do not poison program caches.
RUN --mount=type=bind,from=spectrum-python,source=/opt/spectrum-build-venv,target=/opt/spectrum-build-venv \
    --mount=type=bind,from=spectrum-image-source,source=/src,target=/src \
    PYTHONPATH=/src/packages/dotfiles-python/src:/src/spectrum/scripts \
    /opt/spectrum-build-venv/bin/python -m spectrum_build.cli configure

# Container lifecycle belongs to the Containerfile rather than Python: enable
# inherited/system units, apply the host-auth policy change, and remove state
# left by DNF, ldconfig, SELinux tooling, and source builds. This runs after the
# cache mounts are gone so their empty mount-point directories can be removed.
RUN --mount=type=bind,from=systemd-manifest,source=/enabled-units.txt,target=/enabled-units.txt \
    --mount=type=tmpfs,target=/var/log \
    --mount=type=tmpfs,target=/run \
    --mount=type=tmpfs,target=/tmp \
    if command -v authselect >/dev/null && \
        authselect is-feature-enabled with-fingerprint >/dev/null 2>&1; then \
        authselect disable-feature with-fingerprint; \
    fi && \
    xargs --no-run-if-empty systemctl enable </enabled-units.txt && \
    rm -rf \
        /run/dnf \
        /var/cache/dnf \
        /var/cache/ldconfig/aux-cache \
        /var/cache/libdnf5 \
        /var/lib/dnf/repos \
        /var/lib/dnf/system-repo.lock \
        /var/lib/sepolgen \
        /var/log/dnf* \
        /var/log/hawkey.log \
        /var/tmp/*

# Keep the static overlay separate from the expensive package/program layer.
# Copy it last so Spectrum-owned configuration wins over files installed by RPMs.
COPY --from=rootfs / /

CMD ["/sbin/init"]

# Match Bluefin's current cache boundary: commit/version arguments are declared
# only after expensive filesystem assembly. Every GHA run gets correct metadata
# without turning a new revision SHA into a program-layer cache miss.
ARG BLUEFIN_BASE_IMAGE
ARG BLUEFIN_BASE_IMAGE_NAME
ARG BLUEFIN_BASE_IMAGE_TAG
ARG IMAGE_NAME="spectrum"
ARG IMAGE_VENDOR="4evy"
ARG IMAGE_TAG="latest"
ARG IMAGE_REF="ostree-image:docker://ghcr.io/4evy/spectrum"
ARG IMAGE_REVISION
ARG IMAGE_VERSION

RUN --mount=type=bind,from=spectrum-python,source=/opt/spectrum-build-venv,target=/opt/spectrum-build-venv \
    --mount=type=bind,from=spectrum-image-source,source=/src,target=/src \
    BLUEFIN_BASE_IMAGE="${BLUEFIN_BASE_IMAGE}" \
    BLUEFIN_BASE_IMAGE_NAME="${BLUEFIN_BASE_IMAGE_NAME}" \
    BLUEFIN_BASE_IMAGE_TAG="${BLUEFIN_BASE_IMAGE_TAG}" \
    IMAGE_NAME="${IMAGE_NAME}" \
    IMAGE_VENDOR="${IMAGE_VENDOR}" \
    IMAGE_TAG="${IMAGE_TAG}" \
    IMAGE_REF="${IMAGE_REF}" \
    IMAGE_REVISION="${IMAGE_REVISION}" \
    IMAGE_VERSION="${IMAGE_VERSION}" \
    PYTHONPATH=/src/packages/dotfiles-python/src:/src/spectrum/scripts \
    /opt/spectrum-build-venv/bin/python -m spectrum_build.cli write-metadata

# Validate only after the Spectrum rootfs overlay is present. This catches both
# dynamic installer failures and a static file that accidentally overrides an
# installed program/unit. As above, validation tooling is mounted, not shipped.
RUN --mount=type=bind,from=spectrum-python,source=/opt/spectrum-build-venv,target=/opt/spectrum-build-venv \
    --mount=type=bind,from=spectrum-image-source,source=/src,target=/src \
    IMAGE_NAME="${IMAGE_NAME}" \
    PYTHONPATH=/src/packages/dotfiles-python/src:/src/spectrum/scripts \
    /opt/spectrum-build-venv/bin/python -m spectrum_build.cli validate && \
    test -x /usr/bin/open && \
    test -x /usr/libexec/spectrum-nix-tools && \
    for command in deadnix nh nil nixd nixfmt; do \
        command -v "${command}" >/dev/null; \
    done && \
    bootc container lint --fatal-warnings

# Presentation metadata does not affect the filesystem. Keep it last so changes
# to documentation URLs and descriptions cannot bust validated filesystem layers.
ARG IMAGE_TITLE="spectrum"
ARG IMAGE_DESCRIPTION="Spectrum Bluefin image for dotfiles"
ARG IMAGE_AUTHORS="4evy <git@evy.pink>"
ARG IMAGE_SOURCE="https://github.com/4evy/dotfiles"
ARG IMAGE_URL="https://github.com/4evy/dotfiles"
ARG IMAGE_DOCUMENTATION="https://github.com/4evy/dotfiles#readme"
ARG IMAGE_README="https://raw.githubusercontent.com/4evy/dotfiles/master/README.md"
ARG IMAGE_LOGO="https://avatars.githubusercontent.com/u/57304299?v=4"
ARG IMAGE_LICENSES="MIT"

LABEL org.opencontainers.image.title="${IMAGE_TITLE}" \
      org.opencontainers.image.description="${IMAGE_DESCRIPTION}" \
      org.opencontainers.image.authors="${IMAGE_AUTHORS}" \
      org.opencontainers.image.source="${IMAGE_SOURCE}" \
      org.opencontainers.image.url="${IMAGE_URL}" \
      org.opencontainers.image.documentation="${IMAGE_DOCUMENTATION}" \
      org.opencontainers.image.licenses="${IMAGE_LICENSES}" \
      org.opencontainers.image.revision="${IMAGE_REVISION}" \
      org.opencontainers.image.version="${IMAGE_VERSION}" \
      org.opencontainers.image.vendor="${IMAGE_VENDOR}" \
      org.opencontainers.image.license="${IMAGE_LICENSES}" \
      io.artifacthub.package.deprecated=false \
      io.artifacthub.package.keywords="bootc,bluefin,ublue,spectrum,dotfiles" \
      io.artifacthub.package.license="${IMAGE_LICENSES}" \
      io.artifacthub.package.logo-url="${IMAGE_LOGO}" \
      io.artifacthub.package.maintainers="[{\"name\":\"4evy\",\"email\":\"git@evy.pink\"}]" \
      io.artifacthub.package.readme-url="${IMAGE_README}" \
      io.artifacthub.package.prerelease=false
