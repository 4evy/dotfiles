{
  "files.associations": {
    "Containerfile": "dockerfile",
    "Justfile": "just",

    "*.m": "objective-c",
    "*.mm": "objective-cpp",
    "*.plist.in": "xml",
    "*.py.in": "python",
    "*.xml.in": "xml",

    "**/*.plist.j2": "jinja-xml",
    "**/*.py.j2": "jinja-py",
    "**/*.sh.j2": "jinja-shell",

    "**/.bash_profile": "shellscript",
    "**/.bashenv": "shellscript",
    "**/.bashrc": "shellscript",
    "**/.gitconfig": "gitconfig",
    "**/.ssh/config": "ssh_config",
    "**/.zshenv": "shellscript",
    "**/.zshrc": "shellscript"
  },
  "explorer.excludeGitIgnore": true,
  "files.exclude": {
    "**/.decrypted~*": true
  },
  "C_Cpp.default.cStandard": "c23",
  // cpptools still misparses C23 constexpr declarations. Rely on clang-tidy
  // diagnostics until its C23 parser support catches up:
  // https://github.com/microsoft/vscode-cpptools/issues?q=is%3Aissue%20C23%20constexpr
  "C_Cpp.errorSquiggles": "disabled",
  "C_Cpp.codeAnalysis.clangTidy.enabled": true,
  "C_Cpp.formatting": "clangFormat",
  "search.exclude": {
    "**/.cache": true,
    "**/.complexipy_cache": true,
    "**/.decrypted~*": true,
    "**/.direnv": true,
    "**/.gradle": true,
    "**/.build": true,
    "**/.zig-cache": true,
    "**/zig-out": true,
    "**/.jj": true,
    "**/.ruff_cache": true,
    "**/.rumdl_cache": true,
    "**/.swiftpm": true,
    "**/.venv": true,
    "**/__pycache__": true,
    "**/build": true,
    "**/build-*/**": true,
    "**/builddir/**": true,
    "**/dist": true,
    "**/node_modules": true,
    "result": true,
    "secrets": true
  },
  "files.watcherExclude": {
    "**/.cache/**": true,
    "**/.complexipy_cache/**": true,
    "**/.decrypted~*": true,
    "**/.direnv/**": true,
    "**/.gradle/**": true,
    "**/.build/**": true,
    "**/.zig-cache/**": true,
    "**/zig-out/**": true,
    "**/.jj/**": true,
    "**/.ruff_cache/**": true,
    "**/.rumdl_cache/**": true,
    "**/.swiftpm/**": true,
    "**/.venv/**": true,
    "**/__pycache__/**": true,
    "**/build/**": true,
    "**/build-*/**": true,
    "**/builddir/**": true,
    "**/dist/**": true,
    "**/node_modules/**": true,
    "result/**": true,
    "secrets/**": true
  },
  "shellcheck.ignorePatterns": {
    "**/*.csh": true,
    "**/*.cshrc": true,
    "**/*.fish": true,
    "**/*.login": true,
    "**/*.logout": true,
    "**/*.tcsh": true,
    "**/*.tcshrc": true,
    "**/*.xonshrc": true,
    "**/*.xsh": true,
    "**/*.zsh": true,
    "**/*.zshrc": true,
    "**/zshrc": true,
    "**/*.zprofile": true,
    "**/zprofile": true,
    "**/*.zlogin": true,
    "**/zlogin": true,
    "**/*.zlogout": true,
    "**/zlogout": true,
    "**/*.zshenv": true,
    "**/zshenv": true,
    "**/*.zsh-theme": true
  },
  "shellcheck.customArgs": ["--source-path=SCRIPTDIR"],
  "shellcheck.useWorkspaceRootAsCwd": true,
  "shfmt.formatIgnored": false,
  "bashIde.shellcheckPath": "",
  "bashIde.shfmt.path": "shfmt",
  "git.mergeEditor": true,
  "git.branchProtection": ["main", "master"],
  "git.branchProtectionPrompt": "alwaysCommitToNewBranch",
  "git.branchRandomName.enable": true,
  "js/ts.experimental.useTsgo": true,
  "js/ts.preferences.preferTypeOnlyAutoImports": true,
  "js/ts.tsdk.path": "./node_modules/typescript",
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "python.languageServer": "None",
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.useEnvironmentsExtension": true,
  "python-envs.workspaceSearchPaths": [".venv"],
  "ty.diagnosticMode": "workspace",
  "ty.importStrategy": "fromEnvironment",
  "ty.path": ["ty"],
  "ruff.importStrategy": "fromEnvironment",
  "ruff.path": ["ruff"],
  "ruff.nativeServer": "on",
  "nix.enableLanguageServer": true,
  "nix.serverPath": "nixd",
  "nix.formatterPath": "nixfmt",
  "vscode-just.lspPath": "vscode-just-lsp",
  "markdownlint.enable": false,
  "rumdl.server.path": "rumdl",
  "redhat.telemetry.enabled": false,
  "sops.enabled": true,
  "sops.beta": false,
  "sops.creationEnabled": false,
  "stylua.disableVersionCheck": true,
  "stylua.searchBinaryInPATH": true,
  "systemd.version": "latest",
  "[go]": {
    "editor.defaultFormatter": "golang.go",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    }
  },
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    }
  },
  "[shellscript]": {
    "editor.defaultFormatter": "mkhl.shfmt"
  },
  "[c]": {
    "editor.defaultFormatter": "ms-vscode.cpptools",
    "editor.formatOnSave": true,
    "editor.formatOnType": true
  },
  "[objective-c]": {
    "editor.defaultFormatter": "ms-vscode.cpptools",
    "editor.formatOnSave": true,
    "editor.formatOnType": true
  },
  "[objective-cpp]": {
    "editor.defaultFormatter": "ms-vscode.cpptools",
    "editor.formatOnSave": true,
    "editor.formatOnType": true
  },
  "[nix]": {
    "editor.defaultFormatter": "jnoortheen.nix-ide",
    "editor.formatOnPaste": true,
    "editor.formatOnSave": true,
    "editor.formatOnType": true
  },
  "[javascript]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.formatOnPaste": true,
    "editor.formatOnSave": true,
    "editor.formatOnType": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.biome": "explicit",
      "source.organizeImports.biome": "explicit"
    }
  },
  "[typescript]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.formatOnPaste": true,
    "editor.formatOnSave": true,
    "editor.formatOnType": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.biome": "explicit",
      "source.organizeImports.biome": "explicit"
    }
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.formatOnPaste": true,
    "editor.formatOnSave": true,
    "editor.formatOnType": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.biome": "explicit",
      "source.organizeImports.biome": "explicit"
    }
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.formatOnPaste": true,
    "editor.formatOnSave": true,
    "editor.formatOnType": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.biome": "explicit",
      "source.organizeImports.biome": "explicit"
    }
  },
  "[json]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.formatOnSave": true
  },
  "[jsonc]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.formatOnSave": true
  },
  "[yaml]": {
    "editor.defaultFormatter": "redhat.vscode-yaml",
    "editor.formatOnSave": true
  },
  "[toml]": {
    "editor.defaultFormatter": "tamasfe.even-better-toml",
    "editor.formatOnSave": true
  },
  "[lua]": {
    "editor.defaultFormatter": "johnnymorganz.stylua",
    "editor.formatOnSave": true
  },
  "[xml]": {
    "editor.defaultFormatter": "redhat.vscode-xml",
    "editor.formatOnSave": true
  },
  "[kdl]": {
    "editor.defaultFormatter": "kdl-org.kdl",
    "editor.formatOnSave": true
  },
  "[markdown]": {
    "editor.defaultFormatter": "rvben.rumdl",
    "editor.formatOnSave": true
  },
  "[just]": {
    "editor.defaultFormatter": "nefrob.vscode-just-syntax"
  }
}
