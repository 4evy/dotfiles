{
  "version": "2.0.0",
  "presentation": {
    "reveal": "always",
    "revealProblems": "onProblem",
    "panel": "dedicated",
    "clear": true,
    "showReuseMessage": false,
    "preserveTerminalName": true
  },
  "tasks": [
    {
      "label": "repo: check",
      "detail": "Run the full repository validation suite.",
      "type": "process",
      "command": "just",
      "args": ["check"],
      "inAgents": true,
      "icon": {
        "id": "beaker",
        "color": "terminal.ansiGreen"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "repo: lint",
      "detail": "Run formatting checks, linters, and project validation.",
      "type": "process",
      "command": "just",
      "args": ["lint"],
      "inAgents": true,
      "icon": {
        "id": "checklist",
        "color": "terminal.ansiCyan"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "repo: check format",
      "detail": "Check repository formatting without rewriting files.",
      "type": "process",
      "command": "just",
      "args": ["check-format"],
      "inAgents": true,
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "repo: format",
      "detail": "Format files managed by this repo.",
      "type": "process",
      "command": "just",
      "args": ["fmt"],
      "icon": {
        "id": "wand",
        "color": "terminal.ansiMagenta"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "repo: doctor",
      "detail": "Check commands required by a selected repository workflow.",
      "type": "process",
      "command": "just",
      "args": ["doctor", "${input:doctorProfile}"],
      "icon": {
        "id": "heart-pulse",
        "color": "terminal.ansiBlue"
      },
      "problemMatcher": []
    },
    {
      "label": "repo: watch check",
      "detail": "Rerun the validation suite whenever tracked inputs change.",
      "type": "process",
      "command": "just",
      "args": ["watch", "check"],
      "isBackground": true,
      "promptOnClose": true,
      "runOptions": {
        "instanceLimit": 1,
        "instancePolicy": "terminateOldest"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false,
        "group": "watch"
      }
    },
    {
      "label": "bun: check",
      "detail": "Run Biome and every Bun workspace type check.",
      "type": "process",
      "command": "just",
      "args": ["bun-check"],
      "inAgents": true,
      "group": "build",
      "problemMatcher": "$tsc"
    },
    {
      "label": "ruby: check",
      "detail": "Run RuboCop and Ruby syntax checks using the repository recipe.",
      "type": "process",
      "command": "just",
      "args": ["ruby-check"],
      "inAgents": true,
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "nix: flake check (no build)",
      "detail": "Evaluate all systems without building derivations, using the repository recipe.",
      "type": "process",
      "command": "just",
      "args": ["nix-check"],
      "inAgents": true,
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "nix: build package",
      "detail": "Build a selected package output for the current system.",
      "type": "process",
      "command": "nix",
      "args": ["build", ".#${input:nixPackage}"],
      "icon": {
        "id": "package",
        "color": "terminal.ansiBlue"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "dotfiles: preview",
      "detail": "Preview pending chezmoi changes without refreshing externals.",
      "type": "process",
      "command": "just",
      "args": ["dotfiles-diff"],
      "icon": {
        "id": "diff"
      },
      "problemMatcher": []
    },
    {
      "label": "dotfiles: render current template",
      "detail": "Render the active standalone template with this repository's chezmoi data.",
      "type": "process",
      "command": "chezmoi",
      "args": [
        "--source",
        "${workspaceFolder}/dotfiles",
        "--working-tree",
        "${workspaceFolder}",
        "--refresh-externals=never",
        "execute-template",
        "--file",
        "${file}"
      ],
      "icon": {
        "id": "preview"
      },
      "problemMatcher": []
    },
    {
      "label": "python: check",
      "detail": "Run Python lint, types, dependency, complexity, and packaging checks.",
      "type": "process",
      "command": "just",
      "args": ["python-check"],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "python: typecheck",
      "detail": "Run ty with the repository Python configuration.",
      "type": "process",
      "command": "just",
      "args": ["python-typecheck"],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "go: check",
      "detail": "Check formatting, test, vet, lint, and build the Go workspace.",
      "type": "process",
      "command": "just",
      "args": ["go-check"],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "github actions: check",
      "detail": "Validate workflow syntax and security with actionlint and zizmor.",
      "type": "process",
      "command": "just",
      "args": ["github-actions-check"],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "records: check",
      "detail": "Validate the encrypted records state.",
      "type": "process",
      "command": "just",
      "args": ["records-check"],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "homebrew: check",
      "detail": "Check Homebrew formula style and the Brewfile.",
      "type": "process",
      "command": "just",
      "args": ["homebrew-check"],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "renovate: check",
      "detail": "Validate Renovate configuration and dependency extraction.",
      "type": "process",
      "command": "just",
      "args": ["renovate-check"],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "spectrum: validate",
      "detail": "Validate the BlueBuild recipe and its pinned base image. Linux only; open the Linux checkout to run this task.",
      "type": "process",
      "command": "just",
      "args": ["spectrum-validate"],
      "inAgents": true,
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "spectrum: build",
      "detail": "Build the local Spectrum image on a supported Linux host. Linux only; open the Linux checkout to run this task.",
      "type": "process",
      "command": "just",
      "args": ["spectrum-build"],
      "icon": {
        "id": "layers",
        "color": "terminal.ansiBlue"
      },
      "group": "build",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "doctorProfile",
      "type": "pickString",
      "description": "Workflow dependencies to check",
      "default": "all",
      "options": [
        "all",
        "status",
        "reboot",
        "install",
        "setup",
        "apply",
        "shell",
        "spectrum",
        "fmt",
        "lint",
        "ansible",
        "bun",
        "nix",
        "watch",
        "check",
        "records",
        "sops"
      ]
    },
    {
      "id": "nixPackage",
      "type": "pickString",
      "description": "Package output for this system (see lib/flake.nix; Linux-only outputs require the Linux checkout)",
      "default": "default",
      "options": [
        "default",
        "bluebuild-v2",
        "bun2nix",
        "check-jsonschema",
        "dotfiles-nix-tools",
        "dotfiles-python",
        "equicord-settings",
        "hyper-window-tiling-gnome",
        "hyper-window-tiling-kde",
        "kmscon",
        "theme-run",
        "toshy-runtime",
        "uresourced"
      ]
    }
  ],
  "options": {
    "cwd": "${workspaceFolder}"
  }
}
