{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "just: check",
      "detail": "Run the full repository validation suite.",
      "type": "process",
      "command": "just",
      "args": ["check"],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "just: check-format",
      "detail": "Check repository formatting without rewriting files.",
      "type": "process",
      "command": "just",
      "args": ["check-format"],
      "group": "test",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "just: fmt",
      "detail": "Format files managed by this repo.",
      "type": "process",
      "command": "just",
      "args": ["fmt"],
      "group": "build",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "just: doctor all",
      "detail": "Check all commands required by local workflows.",
      "type": "process",
      "command": "just",
      "args": ["doctor", "all"],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "just: smoke",
      "detail": "Build and run the Fedora smoke-test container.",
      "type": "process",
      "command": "just",
      "args": ["smoke"],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "python: test",
      "detail": "Run the configured pytest suite through the uv environment.",
      "type": "process",
      "command": "uv",
      "args": ["run", "pytest"],
      "group": "test",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "meson: configure",
      "detail": "Configure every native workspace project and its compilation database.",
      "type": "process",
      "command": "meson",
      "args": ["setup", "${workspaceFolder}/build/meson", "${workspaceFolder}"],
      "group": "build",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "meson: compile",
      "detail": "Compile every native workspace project with Meson.",
      "type": "process",
      "command": "meson",
      "args": ["compile", "-C", "${workspaceFolder}/build/meson"],
      "dependsOn": ["meson: configure"],
      "dependsOrder": "sequence",
      "group": "build",
      "problemMatcher": ["$gcc"],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "meson: test",
      "detail": "Build and run every native workspace test suite.",
      "type": "process",
      "command": "meson",
      "args": ["test", "-C", "${workspaceFolder}/build/meson", "--print-errorlogs"],
      "dependsOn": ["meson: compile"],
      "dependsOrder": "sequence",
      "group": "test",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}
