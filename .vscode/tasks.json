{
  "version": "2.0.0",
  "presentation": {
    "reveal": "always",
    "revealProblems": "onProblem",
    "panel": "dedicated",
    "clear": true,
    "showReuseMessage": false,
    "preserveTerminalName": true
  },
  "tasks": [
    {
      "label": "repo: check",
      "detail": "Run the full repository validation suite.",
      "type": "process",
      "command": "just",
      "args": ["check"],
      "inAgents": true,
      "icon": {
        "id": "beaker",
        "color": "terminal.ansiGreen"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "repo: lint",
      "detail": "Run formatting checks, linters, and project validation.",
      "type": "process",
      "command": "just",
      "args": ["lint"],
      "inAgents": true,
      "icon": {
        "id": "checklist",
        "color": "terminal.ansiCyan"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "repo: check format",
      "detail": "Check repository formatting without rewriting files.",
      "type": "process",
      "command": "just",
      "args": ["check", "format"],
      "inAgents": true,
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "repo: format",
      "detail": "Format files managed by this repo.",
      "type": "process",
      "command": "just",
      "args": ["fmt"],
      "icon": {
        "id": "wand",
        "color": "terminal.ansiMagenta"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "repo: doctor",
      "detail": "Check commands required by a selected repository workflow.",
      "type": "process",
      "command": "just",
      "args": ["doctor", "${input:doctorProfile}"],
      "icon": {
        "id": "heart-pulse",
        "color": "terminal.ansiBlue"
      },
      "problemMatcher": []
    },
    {
      "label": "repo: watch check",
      "detail": "Rerun the validation suite whenever tracked inputs change.",
      "type": "process",
      "command": "just",
      "args": ["watch", "check"],
      "isBackground": true,
      "promptOnClose": true,
      "runOptions": {
        "instanceLimit": 1,
        "instancePolicy": "terminateOldest"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false,
        "group": "watch"
      }
    },
    {
      "label": "bun: check",
      "detail": "Run Biome and every Bun workspace type check.",
      "type": "process",
      "command": "just",
      "args": ["bun", "check"],
      "inAgents": true,
      "group": "build",
      "problemMatcher": "$tsc"
    },
    {
      "label": "nix: flake check (no build)",
      "detail": "Evaluate all systems without building derivations, using the repository recipe.",
      "type": "process",
      "command": "just",
      "args": ["nix", "check"],
      "inAgents": true,
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "nix: build package",
      "detail": "Build a selected package output for the current system.",
      "type": "process",
      "command": "nix",
      "args": ["build", ".#${input:nixPackage}"],
      "icon": {
        "id": "package",
        "color": "terminal.ansiBlue"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "dotfiles: preview",
      "detail": "Preview pending Hjem-managed home changes.",
      "type": "process",
      "command": "just",
      "args": ["dotfiles", "diff"],
      "icon": {
        "id": "diff"
      },
      "problemMatcher": []
    },
    {
      "label": "python: check",
      "detail": "Run Python lint, types, dependency, complexity, and packaging checks.",
      "type": "process",
      "command": "just",
      "args": ["python", "check"],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "python: typecheck",
      "detail": "Run ty with the repository Python configuration.",
      "type": "process",
      "command": "just",
      "args": ["python", "typecheck"],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "go: check",
      "detail": "Check formatting, test, vet, lint, and build the Go workspace.",
      "type": "process",
      "command": "just",
      "args": ["go", "check"],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "github actions: check",
      "detail": "Validate workflow syntax and security with actionlint and zizmor.",
      "type": "process",
      "command": "just",
      "args": ["github", "actions", "check"],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "records: check",
      "detail": "Validate the encrypted records state.",
      "type": "process",
      "command": "just",
      "args": ["records", "check"],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "homebrew: check",
      "detail": "Check Homebrew formula style and the Brewfile.",
      "type": "process",
      "command": "just",
      "args": ["homebrew", "check"],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "renovate: check",
      "detail": "Validate Renovate configuration and dependency extraction.",
      "type": "process",
      "command": "just",
      "args": ["renovate", "check"],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "spectrum: validate",
      "detail": "Validate the BlueBuild recipe and its pinned base image. Linux only; open the Linux checkout to run this task.",
      "type": "process",
      "command": "just",
      "args": ["spectrum", "validate"],
      "inAgents": true,
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "spectrum: build",
      "detail": "Build the local Spectrum image on a supported Linux host. Linux only; open the Linux checkout to run this task.",
      "type": "process",
      "command": "just",
      "args": ["spectrum", "build"],
      "icon": {
        "id": "layers",
        "color": "terminal.ansiBlue"
      },
      "group": "build",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "doctorProfile",
      "type": "pickString",
      "description": "Workflow dependencies to check",
      "default": "all",
      "options": [
        "all",
        "status",
        "reboot",
        "install",
        "build",
        "setup",
        "reconcile",
        "apply",
        "shell",
        "spectrum",
        "fmt",
        "lint",
        "bun",
        "nix",
        "watch",
        "check",
        "records",
        "sops"
      ]
    },
    {
      "id": "nixPackage",
      "type": "pickString",
      "description": "Flake package output (Linux-only selections require the Linux checkout)",
      "default": "default",
      "options": [
        "default",
        "ai-configs",
        "ai-tools",
        {
          "label": "Linux only",
          "value": "bluebuild-v2"
        },
        "bun2nix",
        {
          "label": "Linux only",
          "value": "check-jsonschema"
        },
        "dotfiles-apps",
        "dotfiles-nix-tools",
        {
          "label": "Linux only",
          "value": "dotfiles-user-tools"
        },
        "dotfiles-workstation",
        "equicord-settings",
        "farstep",
        "farstep-native",
        "ghidra-mcp",
        "ghostty-patched",
        "helium-browser",
        "helix",
        "hjem",
        "hjem-files",
        {
          "label": "Linux only",
          "value": "hyper-window-tiling-gnome"
        },
        {
          "label": "Linux only",
          "value": "hyper-window-tiling-kde"
        },
        "jj-patched",
        "kanata-with-cmd",
        {
          "label": "Linux only",
          "value": "kmscon"
        },
        {
          "label": "Linux only",
          "value": "nixcord-discord"
        },
        "theme-run",
        {
          "label": "Linux only",
          "value": "toshy-runtime"
        },
        "tweezle",
        {
          "label": "Linux only",
          "value": "uresourced"
        },
        "yt-dlp-script"
      ]
    }
  ],
  "options": {
    "cwd": "${workspaceFolder}"
  }
}
