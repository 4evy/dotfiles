+/// Interactively set timestamps and sign rewritten revisions
+#[derive(clap::Args, Clone, Debug)]
+pub(crate) struct RedateArgs {
+    /// The revisions to redate
+    #[arg(value_name = "REVSETS")]
+    #[arg(add = ArgValueCompleter::new(complete::revset_expression_mutable))]
+    revisions_pos: Vec<RevisionArg>,
+
+    #[arg(short = 'r', hide = true, value_name = "REVSETS")]
+    #[arg(add = ArgValueCompleter::new(complete::revset_expression_mutable))]
+    revisions_opt: Vec<RevisionArg>,
+}
+
+#[instrument(skip_all)]
+pub(crate) async fn cmd_redate(
+    ui: &mut Ui,
+    command: &CommandHelper,
+    args: &RedateArgs,
+) -> Result<(), CommandError> {
+    let mut workspace_command = command.workspace_helper(ui).await?;
+    if !workspace_command.repo().store().signer().can_sign() {
+        return Err(user_error("No signing backend configured").hinted(
+            "For configuring a signing backend, see \
+             https://docs.jj-vcs.dev/latest/config/#commit-signing",
+        ));
+    }
+    if !ui.can_prompt() {
+        return Err(user_error("Cannot prompt for a redate timestamp")
+            .hinted("Run from a terminal or set JJ_INTERACTIVE=1"));
+    }
+    let interactive = args.revisions_pos.is_empty()
+        && args.revisions_opt.is_empty()
+        && io::stdin().is_terminal()
+        && io::stdout().is_terminal();
+    let target_expression = if !args.revisions_pos.is_empty() || !args.revisions_opt.is_empty() {
+        workspace_command
+            .parse_union_revsets(ui, &[&*args.revisions_pos, &*args.revisions_opt].concat())?
+    } else if interactive {
+        let revset = workspace_command.settings().get_string("revsets.redate")?;
+        let revset = match workspace_command
+            .settings()
+            .get::<usize>("redate.limit")
+            .optional()?
+        {
+            Some(0) => return Err(user_error("redate.limit must be greater than zero")),
+            Some(limit) => format!("latest(({revset}), {limit})"),
+            None => revset,
+        };
+        workspace_command.parse_revset(ui, &RevisionArg::from(revset))?
+    } else {
+        workspace_command.parse_revset(ui, &RevisionArg::AT)?
+    }
+    .resolve()?;
+    workspace_command
+        .check_rewritable_expr(&target_expression)
+        .await?;
+    let commits: Vec<Commit> = target_expression
+        .evaluate(workspace_command.repo().as_ref())?
+        .stream()
+        .commits(workspace_command.repo().store())
+        .try_collect()
+        .await?;
+    if commits.is_empty() {
+        writeln!(ui.status(), "No revisions to redate.")?;
+        return Ok(());
+    }
+    let commit_ids: Vec<jj_lib::backend::CommitId> = if interactive {
+        let rows = render_rows(ui, &workspace_command, &commits)?;
+        let Some(indices) = select_revisions(rows)? else {
+            return Ok(());
+        };
+        indices
+            .into_iter()
+            .map(|index| commits[index].id().clone())
+            .collect()
+    } else {
+        commits.iter().map(|commit| commit.id().clone()).collect()
+    };
+    let timestamp = prompt_timestamp(ui)?;
+    let display_timestamp = timestamp.to_datetime().unwrap().to_rfc3339();
+    let revision_label = match commit_ids.as_slice() {
+        [_] => "1 revision".to_owned(),
+        revisions => format!("{} revisions", revisions.len()),
+    };
+    if !ui.prompt_yes_no(
+        &format!("Redate {revision_label} to {display_timestamp}?"),
+        Some(true),
+    )? {
+        return Ok(());
+    }
+    metaedit::edit_commits(
+        ui,
+        &mut workspace_command,
+        &metaedit::MetaeditArgs::default(),
+        CommitEditOptions::redate(timestamp),
+        commit_ids,
+    )
+    .await
+}
+
+fn render_rows(
+    ui: &Ui,
+    workspace_command: &WorkspaceCommandHelper,
+    commits: &[Commit],
+) -> Result<Vec<Text<'static>>, CommandError> {
+    let template = workspace_command
+        .parse_commit_template(
+            ui,
+            &workspace_command
+                .settings()
+                .get_string("templates.redate")?,
+        )?
+        .labeled(["commit"]);
+    commits
+        .iter()
+        .map(|commit| {
+            let mut output = vec![];
+            let mut formatter = ui.new_formatter(&mut output).into_labeled("redate");
+            template
+                .format(commit, formatter.as_mut())
+                .map_err(|error| internal_error(format!("Failed to format redate row: {error}")))?;
+            drop(formatter);
+            output
+                .into_text()
+                .map_err(|error| internal_error(format!("Failed to render redate row: {error}")))
+        })
+        .collect()
+}
+
+fn select_revisions(rows: Vec<Text<'static>>) -> Result<Option<Vec<usize>>, CommandError> {
+    io::stdout().execute(EnterAlternateScreen)?;
+    let _terminal_guard = CleanupGuard::new(|| {
+        drop(disable_raw_mode());
+        drop(io::stdout().execute(LeaveAlternateScreen));
+    });
+    enable_raw_mode()?;
+    let mut terminal = Terminal::new(CrosstermBackend::new(io::stdout()))?;
+    terminal.clear()?;
+    run_selector(&mut terminal, &rows)
+}
+
+fn run_selector<B: ratatui::backend::Backend>(
+    terminal: &mut Terminal<B>,
+    rows: &[Text<'static>],
+) -> Result<Option<Vec<usize>>, CommandError> {
+    let mut list_state = ListState::default().with_selected(Some(0));
+    let mut selected = HashSet::new();
+    let mut invalid = false;
+
+    loop {
+        terminal
+            .draw(|frame| {
+                let areas = Layout::vertical([Constraint::Fill(1), Constraint::Length(1)])
+                    .split(frame.area());
+                let items = rows.iter().enumerate().map(|(index, row)| {
+                    let mut row = row.clone();
+                    let marker = if selected.contains(&index) {
+                        Span::styled(
+                            "● ",
+                            Style::default()
+                                .fg(Color::Magenta)
+                                .add_modifier(Modifier::BOLD),
+                        )
+                    } else {
+                        Span::styled("○ ", Style::default().fg(Color::DarkGray))
+                    };
+                    if let Some(line) = row.lines.first_mut() {
+                        line.spans.insert(0, marker);
+                    } else {
+                        row.lines.push(Line::from(marker));
+                    }
+                    ListItem::new(row)
+                });
+                let list = List::new(items)
+                    .block(
+                        Block::bordered()
+                            .title(format!(" Select revisions ({} selected) ", selected.len())),
+                    )
+                    .highlight_symbol(
+                        Line::from("› ").style(
+                            Style::default()
+                                .fg(Color::Magenta)
+                                .add_modifier(Modifier::BOLD),
+                        ),
+                    )
+                    .scroll_padding(1);
+                frame.render_stateful_widget(list, areas[0], &mut list_state);
+
+                let footer = if invalid {
+                    Line::from("Select at least one revision")
+                        .style(Style::default().fg(Color::Red))
+                } else {
+                    Line::from("↑↓/jk move · space toggle · enter confirm · q cancel")
+                        .style(Style::default().fg(Color::DarkGray))
+                };
+                frame.render_widget(Paragraph::new(footer), areas[1]);
+            })
+            .map_err(|error| internal_error(format!("Failed to draw redate TUI: {error}")))?;
+
+        let Event::Key(key) = event::read()
+            .map_err(|error| internal_error(format!("Failed to read redate TUI input: {error}")))?
+        else {
+            continue;
+        };
+        if key.is_release() {
+            continue;
+        }
+        let current = list_state.selected().unwrap_or(0).min(rows.len() - 1);
+        match (key.code, key.modifiers) {
+            (KeyCode::Char('q') | KeyCode::Esc, KeyModifiers::NONE)
+            | (KeyCode::Char('c'), KeyModifiers::CONTROL) => return Ok(None),
+            (KeyCode::Enter, KeyModifiers::NONE) if !selected.is_empty() => {
+                return Ok(Some(
+                    (0..rows.len())
+                        .filter(|index| selected.contains(index))
+                        .collect(),
+                ));
+            }
+            (KeyCode::Enter, KeyModifiers::NONE) => invalid = true,
+            (KeyCode::Down | KeyCode::Char('j'), KeyModifiers::NONE) => {
+                list_state.select(Some((current + 1).min(rows.len() - 1)));
+            }
+            (KeyCode::Up | KeyCode::Char('k'), KeyModifiers::NONE) => {
+                list_state.select(Some(current.saturating_sub(1)));
+            }
+            (KeyCode::Char(' '), KeyModifiers::NONE) => {
+                if !selected.insert(current) {
+                    selected.remove(&current);
+                }
+                invalid = false;
+            }
+            _ => {}
+        }
+    }
+}
+
+fn prompt_timestamp(ui: &Ui) -> Result<Timestamp, CommandError> {
+    let now = Local::now();
+    let default_date = now.format("%Y-%m-%d").to_string();
+    let date = prompt_prefilled(ui, "Date (YYYY-MM-DD)", &default_date, |input| {
+        NaiveDate::parse_from_str(input, "%Y-%m-%d")
+    })?;
+    let default_time = now.format("%H:%M:%S").to_string();
+    let time = prompt_prefilled(ui, "Time (HH[:MM[:SS]])", &default_time, parse_time)?;
+    let local = Local
+        .from_local_datetime(&date.and_time(time))
+        .earliest()
+        .ok_or_else(|| user_error("The selected local time does not exist"))?;
+    Ok(Timestamp::from_datetime(local.fixed_offset()))
+}
+
+fn prompt_prefilled<T, E: std::fmt::Debug + std::fmt::Display>(
+    ui: &Ui,
+    prompt: &str,
+    initial: &str,
+    mut parse: impl FnMut(&str) -> Result<T, E>,
+) -> Result<T, CommandError> {
+    if !io::stdin().is_terminal() {
+        return Ok(ui.prompt_choice_with(prompt, Some(initial), parse)?);
+    }
+    let mut terminal = line_editor_terminal().map_err(internal_error)?;
+    let mut editor = LineEditor::new(&mut terminal);
+    editor.set_prompt(&format!("{prompt}: "));
+    let mut host = NopLineEditorHost::default();
+    let mut input = initial.to_owned();
+    loop {
+        input = editor
+            .read_line_with_optional_initial_value(&mut host, Some(&input))
+            .map_err(internal_error)?
+            .ok_or_else(|| user_error("Prompt canceled"))?;
+        match parse(input.trim()) {
+            Ok(value) => return Ok(value),
+            Err(error) => writeln!(ui.warning_no_heading(), "{error}")?,
+        }
+    }
+}
+
+fn parse_time(input: &str) -> Result<NaiveTime, String> {
+    let normalized = match input.matches(':').count() {
+        0 => format!("{input}:00:00"),
+        1 => format!("{input}:00"),
+        2 => input.to_owned(),
+        _ => return Err("invalid time; expected HH[:MM[:SS]]".to_owned()),
+    };
+    NaiveTime::parse_from_str(&normalized, "%H:%M:%S").map_err(|error| error.to_string())
+}
