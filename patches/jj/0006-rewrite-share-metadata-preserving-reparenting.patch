+use jj_lib::commit_builder::CommitBuilder;
+use jj_lib::rewrite::CommitRewriter;
+use jj_lib::signing::SignBehavior;
+
+/// Reparents a commit without changing its author or committer metadata.
+///
+/// Rewritten signatures are recreated when the old commit was signed, or when
+/// `force_sign` is requested. Unsigned commits otherwise remain unsigned.
+pub(crate) fn reparent_preserving_metadata(
+    rewriter: CommitRewriter<'_>,
+    force_sign: bool,
+) -> CommitBuilder<'_> {
+    let old_commit = rewriter.old_commit();
+    let author = old_commit.author().clone();
+    let committer = old_commit.committer().clone();
+    let sign_behavior = if force_sign || old_commit.is_signed() {
+        SignBehavior::Force
+    } else {
+        SignBehavior::Drop
+    };
+    rewriter
+        .reparent()
+        .set_author(author)
+        .set_committer(committer)
+        .set_sign_behavior(sign_behavior)
+}
