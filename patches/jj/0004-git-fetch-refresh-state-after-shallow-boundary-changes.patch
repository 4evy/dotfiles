 cli/src/config-schema.json    |  5 ++++
 lib/src/git.rs                | 19 ++++++++++++++
 lib/src/git_backend.rs        | 47 +++++++++++++++++++----------------
 4 files changed, 84 insertions(+), 22 deletions(-)

