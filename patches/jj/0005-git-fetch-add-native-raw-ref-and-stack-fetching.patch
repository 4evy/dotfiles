+    /// Fetch a raw Git ref into a remote bookmark.
+    ///
+    /// If `shallow_exclude` is provided for an existing shallow repository,
+    /// fetches the stack above that ref and exactly one additional commit to
+    /// provide the oldest fetched commit with a real diff base.
+    #[tracing::instrument(skip(self, callback))]
+    pub fn fetch_ref(
+        &mut self,
+        source: &str,
+        source_ref: &str,
+        remote_name: &RemoteName,
+        bookmark_name: &RefName,
+        shallow_exclude: Option<&str>,
+        callback: &mut dyn GitSubprocessCallback,
+    ) -> Result<(), GitFetchError> {
+        validate_remote_name(remote_name)?;
+        let destination_ref = format!(
+            "{REMOTE_BOOKMARK_REF_NAMESPACE}{}/{}",
+            remote_name.as_str(),
+            bookmark_name.as_str()
+        );
+        let refspecs = [RefSpec::forced(source_ref, &destination_ref)];
+        let no_negative_refspecs = [];
+        let shallow_excludes = if self.shallow_boundary.is_some() {
+            shallow_exclude.map(|value| vec![value.to_owned()])
+        } else {
+            None
+        };
+
+        let fetch = |this: &Self,
+                     depth: Option<NonZeroU32>,
+                     shallow_excludes: &[String],
+                     callback: &mut dyn GitSubprocessCallback| {
+            let status = this.git_ctx.spawn_fetch_from(
+                source,
+                &refspecs,
+                &no_negative_refspecs,
+                callback,
+                depth,
+                shallow_excludes,
+            )?;
+            match status {
+                GitFetchStatus::Updates(updates) if updates.rejected.is_empty() => Ok(()),
+                GitFetchStatus::Updates(updates) => {
+                    let names = updates.rejected.into_iter().map(|(name, _)| name).collect();
+                    Err(GitFetchError::RejectedUpdates(names))
+                }
+                GitFetchStatus::NoRemoteRef(_) => Err(GitFetchError::NoSuchRef {
+                    location: source.to_owned(),
+                    ref_name: source_ref.to_owned(),
+                }),
+            }
+        };
+
+        if let Some(shallow_excludes) = &shallow_excludes {
+            fetch(self, None, shallow_excludes, callback)?;
+            let stack_depth = self.git_ctx.spawn_rev_list_count(&destination_ref)?;
+            let depth = stack_depth
+                .checked_add(1)
+                .and_then(NonZeroU32::new)
+                .ok_or_else(|| {
+                    GitSubprocessError::External(format!(
+                        "cannot extend fetched stack at {destination_ref}"
+                    ))
+                })?;
+            fetch(self, Some(depth), &[], callback)?;
+        } else {
+            fetch(self, None, &[], callback)?;
+        }
+
+        self.fetched.push(FetchedRefs {
+            remote: remote_name.to_owned(),
+            bookmark_matcher: StringExpression::exact(bookmark_name).to_matcher(),
+            tag_matcher: StringExpression::none().to_matcher(),
+        });
+        Ok(())
+    }
