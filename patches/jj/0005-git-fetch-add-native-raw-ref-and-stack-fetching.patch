+
+/// Fetch an arbitrary Git ref into a remote bookmark
+#[derive(clap::Args, Clone, Debug)]
+pub struct GitFetchRefArgs {
+    /// Named remote, URL, or path to fetch from
+    #[arg(long, value_hint = clap::ValueHint::Url)]
+    source: String,
+
+    /// Ref name at the source
+    #[arg(value_name = "REF")]
+    ref_name: String,
+
+    /// Remote name used for the imported bookmark
+    #[arg(long)]
+    remote: RemoteNameBuf,
+
+    /// Name of the imported bookmark
+    #[arg(long, value_parser = revset_util::parse_bookmark_name)]
+    bookmark: RefNameBuf,
+
+    /// Exclude this base ref when fetching an existing shallow repository
+    ///
+    /// The fetch includes the complete stack above this ref plus one parent as
+    /// the oldest fetched commit's diff base.
+    #[arg(long, value_name = "REF")]
+    shallow_exclude: Option<String>,
+
+    /// Track the imported remote bookmark
+    #[arg(long)]
+    track: bool,
+}
+
+pub async fn cmd_git_fetch_ref(
+    ui: &mut Ui,
+    command: &CommandHelper,
+    args: &GitFetchRefArgs,
+) -> Result<(), CommandError> {
+    let mut workspace_command = command.workspace_helper(ui).await?;
+    let mut tx = workspace_command.start_transaction();
+    let remote_settings = tx.settings().remote_settings()?;
+    let git_settings = GitSettings::from_settings(tx.settings())?;
+    let import_options = load_git_import_options(ui, &git_settings, &remote_settings)?;
+    let index_store = tx.repo().base_repo().index_store().clone();
+    let mut git_fetch = GitFetch::new(
+        tx.repo_mut(),
+        git_settings.to_subprocess_options(),
+        &import_options,
+    )?;
+
+    let mut callback = GitSubprocessUi::new(ui);
+    git_fetch.fetch_ref(
+        &args.source,
+        &args.ref_name,
+        args.remote.as_ref(),
+        args.bookmark.as_ref(),
+        args.shallow_exclude.as_deref(),
+        &mut callback,
+    )?;
+    let import_stats = git_fetch.import_refs().await?;
+    let shallow_boundary_changed = git_fetch.shallow_boundary_changed();
+    print_git_import_stats(ui, &tx, &import_stats)?;
+
+    if args.track {
+        tx.repo_mut()
+            .track_remote_bookmark(args.bookmark.to_remote_symbol(args.remote.as_ref()))?;
+    }
+
+    tx.finish(
+        ui,
+        format!(
+            "fetch git ref {} as {}@{}",
+            args.ref_name,
+            args.bookmark.as_symbol(),
+            args.remote.as_symbol()
+        ),
+    )
+    .await?;
+    super::reinit_index_after_shallow_change(ui, index_store.as_ref(), shallow_boundary_changed)?;
+    Ok(())
+}
