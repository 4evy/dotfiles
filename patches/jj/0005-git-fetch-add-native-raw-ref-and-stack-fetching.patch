+    /// Count commits reachable from a Git revision, respecting shallow roots.
+    pub(crate) fn spawn_rev_list_count(&self, revision: &str) -> Result<u32, GitSubprocessError> {
+        let mut command = self.create_command();
+        command.stdout(Stdio::piped());
+        command.args(["rev-list", "--count", revision]);
+        let output = wait_with_output(self.spawn_cmd(command)?)?;
+        if !output.status.success() {
+            return Err(GitSubprocessError::External(
+                String::from_utf8_lossy(&output.stderr).trim().to_owned(),
+            ));
+        }
+        String::from_utf8_lossy(&output.stdout)
+            .trim()
+            .parse()
+            .map_err(|err| {
+                GitSubprocessError::External(format!(
+                    "failed to parse commit count for {revision}: {err}"
+                ))
+            })
+    }
