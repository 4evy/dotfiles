From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: 4evy <git@evy.pink>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH 2/6] apprt: identify terminal scrollback text

Give scrollback text its own open-URL kind so runtimes can choose an
in-terminal editor while preserving the existing platform text-editor
fallback.
---
 include/ghostty.h    | 1 +
 src/Surface.zig      | 5 ++++-
 src/apprt/action.zig | 4 ++++
 src/os/open.zig      | 2 +-
 4 files changed, 10 insertions(+), 2 deletions(-)

diff --git a/include/ghostty.h b/include/ghostty.h
index 72bbb57a80b5c238b551435f196c508ccae60dba..32f3c23d4eda5ebe73261b6252cbb381b3646a4b 100644
--- a/include/ghostty.h
+++ b/include/ghostty.h
@@ -812,6 +812,7 @@ typedef enum {
   GHOSTTY_ACTION_OPEN_URL_KIND_UNKNOWN,
   GHOSTTY_ACTION_OPEN_URL_KIND_TEXT,
   GHOSTTY_ACTION_OPEN_URL_KIND_HTML,
+  GHOSTTY_ACTION_OPEN_URL_KIND_TERMINAL_TEXT,
 } ghostty_action_open_url_kind_e;
 
 // apprt.action.OpenUrl.C
diff --git a/src/Surface.zig b/src/Surface.zig
index 218bf2fdb0aaefb806c6b3ebbc589b70eacbfd09..52ac1a2c631cbff4021543fa6661ae2c8e9b0968 100644
--- a/src/Surface.zig
+++ b/src/Surface.zig
@@ -5771,7 +5771,10 @@ fn writeScreenFile(
         },
         .open => try self.openUrl(.{
             .kind = switch (write_screen.emit) {
-                .plain, .vt => .text,
+                .plain, .vt => if (loc == .history)
+                    .terminal_text
+                else
+                    .text,
                 .html => .html,
             },
             .url = path,
diff --git a/src/apprt/action.zig b/src/apprt/action.zig
index 23bff13d71295e4013ee099034d76d8b7f0956b7..2c2a269d79395801afb2d2378c4f0ad08bb37a9f 100644
--- a/src/apprt/action.zig
+++ b/src/apprt/action.zig
@@ -906,6 +906,10 @@ pub const OpenUrl = struct {
         /// The URL is known to contain HTML content.
         html,
 
+        /// The URL is a scrollback text file that should preferably be
+        /// opened in a terminal-based editor.
+        terminal_text,
+
         test "ghostty.h OpenUrl.Kind" {
             try lib.checkGhosttyHEnum(Kind, "GHOSTTY_ACTION_OPEN_URL_KIND_");
         }
diff --git a/src/os/open.zig b/src/os/open.zig
index 806030fcdca997e0c4b92ef4dc1156bd3bf84154..c04356d335b76bd526f97e8478165d1bf61b260c 100644
--- a/src/os/open.zig
+++ b/src/os/open.zig
@@ -23,7 +23,7 @@ pub fn open(
         .linux, .freebsd => .{ .argv = &.{ "xdg-open", url } },
         .windows => .{ .argv = &.{ "rundll32", "url.dll,FileProtocolHandler", url } },
         .macos => switch (kind) {
-            .text => .{ .argv = &.{ "open", "-t", url } },
+            .text, .terminal_text => .{ .argv = &.{ "open", "-t", url } },
             .html, .unknown => .{ .argv = &.{ "open", url } },
         },
         .ios => return error.Unimplemented,
-- 
