From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: 4evy <git@evy.pink>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH 7/7] build: disable the nested package manifest sandbox

Homebrew already runs formula builds inside its own macOS sandbox. SwiftPM's
package-manifest sandbox cannot be nested inside it, so disable only that inner manifest
sandbox in Ghostty's xcodebuild invocations
---
 src/build/GhosttyXcodebuild.zig | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/src/build/GhosttyXcodebuild.zig b/src/build/GhosttyXcodebuild.zig
index 6f7e18dc3..86d261d35 100644
--- a/src/build/GhosttyXcodebuild.zig
+++ b/src/build/GhosttyXcodebuild.zig
@@ -65,6 +65,7 @@ pub fn init(
         step.environ_map = env_map;
         step.addArgs(&.{
             "xcodebuild",
+            "-IDEPackageSupportDisableManifestSandbox=1",
             "-target",
             "Ghostty",
             "-configuration",
@@ -101,6 +102,7 @@ pub fn init(
         step.environ_map = env_map;
         step.addArgs(&.{
             "xcodebuild",
+            "-IDEPackageSupportDisableManifestSandbox=1",
             "test",
             "-scheme",
             "Ghostty",
