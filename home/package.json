{
  "name": "@dotfiles/home",
  "private": true,
  "type": "module",
  "files": [
    "deploy",
    "theme/palette/palette.json",
    "generators.json",
    "data"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./schema": "./deploy/schema.ts",
    "./nix": "./deploy/nix.ts",
    "./palette": "./theme/palette/palette.json",
    "./generators": "./generators.json",
    "./data/*": "./data/*.json"
  },
  "scripts": {
    "check": "bun run typecheck",
    "typecheck": "bun run deploy/check/typescript.ts"
  },
  "dependencies": {
    "@dotfiles/core": "workspace:*",
    "@dotfiles/runtime": "workspace:*",
    "@effect/platform-bun": "4.0.7",
    "effect": "4.0.7"
  }
}
