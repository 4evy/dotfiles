{
  "base_keymap": "VSCode",
  "vim_mode": false,
  "helix_mode": false,
  "disable_ai": true,
  "session": {
    "trust_all_worktrees": true
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "theme": {
    "mode": "system",
    "light": "Catppuccin Custom Light",
    "dark": "Catppuccin Custom Dark"
  },
  "icon_theme": {
    "mode": "system",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Mocha"
  },
  "auto_install_extensions": {
    "biome": true,
    "catppuccin": true,
    "catppuccin-icons": true,
    "dockerfile": true,
    "git-firefly": true,
    "html": true,
    "jinja2": true,
    "just": true,
    "kdl": true,
    "lua": true,
    "nix": true,
    "objective-c": true,
    "ruby": true,
    "rumdl": true,
    "scss": true,
    "ssh-config": true,
    "svelte": true,
    "toml": true,
    "typst": true,
    "xml": true
  },
  "ui_font_family": ".SystemUIFont",
  "ui_font_size": 18,
  "buffer_font_family": "JetBrainsMono Nerd Font Mono",
  "mouse_wheel_zoom": true,
  "terminal": {
    "font_family": "JetBrainsMono Nerd Font Mono",
    "option_as_meta": true,
    "minimum_contrast": 0
  },
  "soft_wrap": "editor_width",
  "show_whitespaces": "selection",
  "auto_signature_help": true,
  "semantic_tokens": "combined",
  "diagnostics": {
    "inline": {
      "enabled": true,
      "update_debounce_ms": 250,
      "max_severity": "warning"
    }
  },
  "on_new_window": "empty_tab",
  "gutter": {
    "runnables": false
  },
  "toolbar": {
    "quick_actions": false,
    "selections_menu": false
  },
  "title_bar": {
    "show_onboarding_banner": false,
    "show_user_picture": false,
    "show_user_menu": false,
    "show_sign_in": false
  },
  "collaboration_panel": {
    "button": false
  },
  "project_panel": {
    "dock": "left",
    "starts_open": true,
    "indent_size": 12,
    "file_icons": true,
    "hide_gitignore": true,
    "folder_indicator": "both"
  },
  "git": {
    "inline_blame": {
      "enabled": false
    }
  },
  "git_panel": {
    "dock": "right",
    "starts_open": true,
    "file_icons": true,
    "entry_primary_click_action": "file_diff"
  },
  "diff_view_style": "split",
  "word_diff_enabled": true,
  "file_types": {
    "CSS": ["*.less", "*.pcss", "*.postcss"]
  },
  "languages": {
    "Nix": {
      "language_servers": ["nixd", "!nil"],
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "nixfmt"
        }
      }
    },
    "Python": {
      "language_servers": ["ty", "ruff", "!basedpyright"],
      "format_on_save": "on",
      "formatter": {
        "language_server": {
          "name": "ruff"
        }
      },
      "code_actions_on_format": {
        "source.fixAll.ruff": true,
        "source.organizeImports.ruff": true
      }
    },
    "JavaScript": {
      "language_servers": ["biome", "..."],
      "format_on_save": "on",
      "formatter": {
        "language_server": {
          "name": "biome"
        }
      },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      },
      "inlay_hints": {
        "enabled": true
      }
    },
    "TypeScript": {
      "language_servers": ["biome", "..."],
      "format_on_save": "on",
      "formatter": {
        "language_server": {
          "name": "biome"
        }
      },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      },
      "inlay_hints": {
        "enabled": true
      }
    },
    "TSX": {
      "language_servers": ["biome", "..."],
      "format_on_save": "on",
      "formatter": {
        "language_server": {
          "name": "biome"
        }
      },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      },
      "inlay_hints": {
        "enabled": true
      }
    },
    "HTML": {
      "format_on_save": "on",
      "formatter": "prettier"
    },
    "CSS": {
      "format_on_save": "on",
      "formatter": "prettier"
    },
    "SCSS": {
      "format_on_save": "on",
      "formatter": "prettier"
    },
    "Svelte": {
      "format_on_save": "on",
      "formatter": "language_server"
    },
    "JSON": {
      "format_on_save": "on",
      "formatter": "language_server"
    },
    "JSONC": {
      "format_on_save": "on",
      "formatter": "language_server"
    },
    "YAML": {
      "format_on_save": "on",
      "formatter": "language_server"
    },
    "TOML": {
      "format_on_save": "on",
      "formatter": "language_server"
    },
    "Lua": {
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "stylua",
          "arguments": ["--stdin-filepath", "{buffer_path}", "-"]
        }
      }
    },
    "XML": {
      "format_on_save": "on",
      "formatter": "language_server"
    },
    "Typst": {
      "format_on_save": "on",
      "formatter": "language_server"
    },
    "Markdown": {
      "format_on_save": "on",
      "formatter": "prettier"
    },
    "Dockerfile": {
      "format_on_save": "on",
      "formatter": "language_server"
    },
    "Shell Script": {
      "formatter": {
        "external": {
          "command": "shfmt",
          "arguments": ["--filename", "{buffer_path}"]
        }
      }
    }
  },
  "lsp": {
    "just-lsp": {
      "binary": {
        "path": "~/.local/bin/vscode-just-lsp",
        "arguments": []
      }
    },
    "rumdl": {
      "binary": {
        "path": "rumdl",
        "arguments": ["server"]
      }
    },
    "ty": {
      "binary": {
        "path": "ty",
        "arguments": ["server"]
      },
      "settings": {
        "diagnosticMode": "workspace"
      }
    },
    "ruff": {
      "binary": {
        "path": "ruff",
        "arguments": ["server"]
      }
    },
    "vtsls": {
      "settings": {
        "typescript": {
          "preferences": {
            "preferTypeOnlyAutoImports": true
          },
          "updateImportsOnFileMove": {
            "enabled": "always"
          },
          "inlayHints": {
            "parameterNames": {
              "enabled": "literals"
            },
            "parameterTypes": {
              "enabled": true
            },
            "functionLikeReturnTypes": {
              "enabled": false
            },
            "variableTypes": {
              "enabled": false
            },
            "propertyDeclarationTypes": {
              "enabled": false
            },
            "enumMemberValues": {
              "enabled": false
            }
          }
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always"
          },
          "inlayHints": {
            "parameterNames": {
              "enabled": "literals"
            },
            "parameterTypes": {
              "enabled": true
            },
            "functionLikeReturnTypes": {
              "enabled": false
            },
            "variableTypes": {
              "enabled": false
            },
            "propertyDeclarationTypes": {
              "enabled": false
            },
            "enumMemberValues": {
              "enabled": false
            }
          }
        }
      }
    }
  }
}
