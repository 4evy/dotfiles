<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>name</key>
    <string>Catppuccin Custom Dark</string>
    <key>semanticClass</key>
    <string>theme.dark.catppuccin-custom-dark</string>
    <key>author</key>
    <string>Catppuccin Custom</string>
    <key>colorSpaceName</key>
    <string>sRGB</string>
    <key>settings</key>
    <array>
      <dict>
        <key>settings</key>
        <dict>
          <key>background</key>
          <string>@COLOR_DARK_TERMINALBACKGROUND@</string>
          <key>foreground</key>
          <string>@COLOR_DARK_TERMINALFOREGROUND@</string>
          <key>caret</key>
          <string>@COLOR_DARK_TERMINALCURSOR@</string>
          <key>lineHighlight</key>
          <string>@COLOR_DARK_SURFACE0@</string>
          <key>misspelling</key>
          <string>@COLOR_DARK_RED@</string>
          <key>accent</key>
          <string>@COLOR_DARK_ACCENT@</string>
          <key>selection</key>
          <string>@COLOR_DARK_TERMINALSELECTION@</string>
          <key>selectionForeground</key>
          <string>@COLOR_DARK_SELECTIONFOREGROUND@</string>
          <key>activeGuide</key>
          <string>@COLOR_DARK_SURFACE1@</string>
          <key>findHighlight</key>
          <string>@COLOR_DARK_SURFACE2@</string>
          <key>gutterForeground</key>
          <string>@COLOR_DARK_OVERLAY1@</string>
        </dict>
      </dict>
      <dict>
        <key>name</key>
        <string>Text</string>
        <key>scope</key>
        <string>text, source, variable.other.readwrite, punctuation.definition.variable</string>
        <key>settings</key>
        <dict>
          <key>foreground</key>
          <string>@COLOR_DARK_TEXT@</string>
        </dict>
      </dict>
      <dict>
        <key>name</key>
        <string>Muted punctuation and comments</string>
        <key>scope</key>
        <string>punctuation, comment, punctuation.definition.comment</string>
        <key>settings</key>
        <dict>
          <key>foreground</key>
          <string>@COLOR_DARK_OVERLAY2@</string>
        </dict>
      </dict>
      <dict>
        <key>name</key>
        <string>Strings</string>
        <key>scope</key>
        <string>string, punctuation.definition.string</string>
        <key>settings</key>
        <dict>
          <key>foreground</key>
          <string>@COLOR_DARK_GREEN@</string>
        </dict>
      </dict>
      <dict>
        <key>name</key>
        <string>Rose accent scopes</string>
        <key>scope</key>
        <string>keyword, keyword.operator.word, keyword.operator.new, variable.language.super, support.type.primitive, storage.type, storage.modifier, constant.character.escape, punctuation.definition.keyword</string>
        <key>settings</key>
        <dict>
          <key>foreground</key>
          <string>@COLOR_DARK_PINK@</string>
        </dict>
      </dict>
      <dict>
        <key>name</key>
        <string>Functions</string>
        <key>scope</key>
        <string>entity.name.function, meta.function-call.method, support.function, support.function.misc, variable.function</string>
        <key>settings</key>
        <dict>
          <key>foreground</key>
          <string>@COLOR_DARK_BLUE@</string>
        </dict>
      </dict>
      <dict>
        <key>name</key>
        <string>Types and classes</string>
        <key>scope</key>
        <string>entity.name.class, entity.other.inherited-class, support.class, meta.function-call.constructor, entity.name.struct, meta.type, meta.type-alias, entity.name.type</string>
        <key>settings</key>
        <dict>
          <key>foreground</key>
          <string>@COLOR_DARK_YELLOW@</string>
        </dict>
      </dict>
      <dict>
        <key>name</key>
        <string>Constants and numbers</string>
        <key>scope</key>
        <string>constant.numeric, variable.other.constant, entity.name.constant, constant.language.boolean, constant.language.false, constant.language.true</string>
        <key>settings</key>
        <dict>
          <key>foreground</key>
          <string>@COLOR_DARK_PEACH@</string>
        </dict>
      </dict>
      <dict>
        <key>name</key>
        <string>Markup inserted</string>
        <key>scope</key>
        <string>markup.inserted, markup.inserted.diff, diff.inserted</string>
        <key>settings</key>
        <dict>
          <key>foreground</key>
          <string>@COLOR_DARK_GREEN@</string>
          <key>background</key>
          <string>@MIX_DARK_SUCCESS@</string>
        </dict>
      </dict>
      <dict>
        <key>name</key>
        <string>Markup deleted</string>
        <key>scope</key>
        <string>markup.deleted, markup.deleted.diff, diff.deleted</string>
        <key>settings</key>
        <dict>
          <key>foreground</key>
          <string>@COLOR_DARK_RED@</string>
          <key>background</key>
          <string>@COLOR_DARK_ERRORSURFACE@</string>
        </dict>
      </dict>
    </array>
  </dict>
</plist>
