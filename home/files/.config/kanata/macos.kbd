(defcfg
  process-unmapped-keys yes
)

(defsrc
  esc caps lctl lalt lmet rmet ralt rctl w    p           a    s    d         ret             bksl     nubs     nuhs     ro       mbck mfwd
)

(defvar
  tap-hold-ms 200
  volume-mute-hold-ms 1000
)

(defalias
  caps-hyper (tap-hold-press $tap-hold-ms $tap-hold-ms esc (multi lmet lctl lalt lsft (layer-while-held hyper)))
  volume-down-mute (tap-hold $tap-hold-ms $volume-mute-hold-ms vold mute)
  volume-up-mute (tap-hold $tap-hold-ms $volume-mute-hold-ms volu mute)
  win-up (macos-window top-half top-two-thirds top-third)
  win-left (macos-window left-half left-two-thirds first-third)
  win-down (macos-window bottom-half bottom-two-thirds bottom-third)
  win-right (macos-window right-half right-two-thirds last-third)
  win-max-almost (macos-window almost-maximize center)
  win-max (macos-window maximize)
)

(deflayer base
  caps @caps-hyper lmet lalt lctl rctl ralt rmet w       p           a         s         d         ret             bksl     nubs     nuhs     ro       @volume-down-mute @volume-up-mute
)

(deflayer hyper
  _    _           _    _    _    _    _    _    @win-up _           @win-left @win-down @win-right @win-max-almost @win-max @win-max @win-max @win-max _    _
)
