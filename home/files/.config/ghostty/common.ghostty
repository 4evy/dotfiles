theme = light:catppuccin-custom-light.conf,dark:catppuccin-custom-dark.conf
custom-shader = @HOME@/.config/ghostty/shaders/catppuccin-custom-glow.glsl
custom-shader-animation = false
alpha-blending = linear-corrected
adjust-underline-position = 4
confirm-close-surface = false
# Closing a tab/split means terminate it; do not retain its PTY for macOS undo.
undo-timeout = 0
cursor-style = bar
cursor-style-blink = false
font-family = JetBrainsMono Nerd Font Mono
