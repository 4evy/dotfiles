{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "@COLOR_LIGHT_TEXT@",
    "margin": 2
  },
  "block_quote": {
    "indent": 1,
    "indent_token": "> "
  },
  "paragraph": {},
  "list": {
    "level_indent": 2
  },
  "heading": {
    "block_suffix": "\n",
    "color": "@COLOR_LIGHT_TEXT@",
    "bold": true
  },
  "h1": {
    "prefix": "# ",
    "suffix": " ",
    "color": "@COLOR_LIGHT_PINK@",
    "bold": true
  },
  "h2": {
    "prefix": "## ",
    "color": "@COLOR_LIGHT_MAUVE@"
  },
  "h3": {
    "prefix": "### ",
    "color": "@COLOR_LIGHT_LAVENDER@"
  },
  "h4": {
    "prefix": "#### ",
    "color": "@COLOR_LIGHT_BLUE@"
  },
  "h5": {
    "prefix": "##### ",
    "color": "@COLOR_LIGHT_SAPPHIRE@"
  },
  "h6": {
    "prefix": "###### ",
    "color": "@COLOR_LIGHT_SKY@"
  },
  "text": {},
  "strikethrough": {
    "crossed_out": true
  },
  "emph": {
    "italic": true
  },
  "strong": {
    "bold": true
  },
  "hr": {
    "color": "@COLOR_LIGHT_OVERLAY0@",
    "format": "\n--------\n"
  },
  "item": {
    "block_prefix": "- "
  },
  "enumeration": {
    "block_prefix": ". "
  },
  "task": {
    "ticked": "[x] ",
    "unticked": "[ ] "
  },
  "link": {
    "color": "@COLOR_LIGHT_BLUE@",
    "underline": true
  },
  "link_text": {
    "color": "@COLOR_LIGHT_LAVENDER@",
    "bold": true
  },
  "image": {
    "color": "@COLOR_LIGHT_BLUE@",
    "underline": true
  },
  "image_text": {
    "color": "@COLOR_LIGHT_LAVENDER@",
    "format": "Image: @GLAMOUR_TEXT@ ->"
  },
  "code": {
    "prefix": " ",
    "suffix": " ",
    "color": "@COLOR_LIGHT_PINK@",
    "background_color": "@COLOR_LIGHT_MANTLE@"
  },
  "code_block": {
    "color": "@COLOR_LIGHT_MANTLE@",
    "margin": 2,
    "chroma": {
      "text": {
        "color": "@COLOR_LIGHT_TEXT@"
      },
      "error": {
        "color": "@COLOR_LIGHT_TEXT@",
        "background_color": "@COLOR_LIGHT_RED@"
      },
      "comment": {
        "color": "@COLOR_LIGHT_OVERLAY0@"
      },
      "comment_preproc": {
        "color": "@COLOR_LIGHT_BLUE@"
      },
      "keyword": {
        "color": "@COLOR_LIGHT_MAUVE@"
      },
      "keyword_reserved": {
        "color": "@COLOR_LIGHT_MAUVE@"
      },
      "keyword_namespace": {
        "color": "@COLOR_LIGHT_YELLOW@"
      },
      "keyword_type": {
        "color": "@COLOR_LIGHT_YELLOW@"
      },
      "operator": {
        "color": "@COLOR_LIGHT_SKY@"
      },
      "punctuation": {
        "color": "@COLOR_LIGHT_OVERLAY2@"
      },
      "name": {
        "color": "@COLOR_LIGHT_LAVENDER@"
      },
      "name_builtin": {
        "color": "@COLOR_LIGHT_PEACH@"
      },
      "name_tag": {
        "color": "@COLOR_LIGHT_MAUVE@"
      },
      "name_attribute": {
        "color": "@COLOR_LIGHT_YELLOW@"
      },
      "name_class": {
        "color": "@COLOR_LIGHT_YELLOW@"
      },
      "name_constant": {
        "color": "@COLOR_LIGHT_YELLOW@"
      },
      "name_decorator": {
        "color": "@COLOR_LIGHT_PINK@"
      },
      "name_exception": {},
      "name_function": {
        "color": "@COLOR_LIGHT_BLUE@"
      },
      "name_other": {},
      "literal": {},
      "literal_number": {
        "color": "@COLOR_LIGHT_PEACH@"
      },
      "literal_date": {},
      "literal_string": {
        "color": "@COLOR_LIGHT_GREEN@"
      },
      "literal_string_escape": {
        "color": "@COLOR_LIGHT_PINK@"
      },
      "generic_deleted": {
        "color": "@COLOR_LIGHT_RED@"
      },
      "generic_emph": {
        "color": "@COLOR_LIGHT_TEXT@",
        "italic": true
      },
      "generic_inserted": {
        "color": "@COLOR_LIGHT_GREEN@"
      },
      "generic_strong": {
        "color": "@COLOR_LIGHT_TEXT@",
        "bold": true
      },
      "generic_subheading": {
        "color": "@COLOR_LIGHT_SKY@"
      },
      "background": {
        "background_color": "@COLOR_LIGHT_MANTLE@"
      }
    }
  },
  "table": {
    "center_separator": "+",
    "column_separator": "|",
    "row_separator": "-"
  },
  "definition_list": {},
  "definition_term": {},
  "definition_description": {
    "block_prefix": "\n=> "
  },
  "html_block": {},
  "html_span": {}
}
