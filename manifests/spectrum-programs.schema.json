{
  "$comment": "The instance's format_version is a dotfiles-local data contract revision. The schema's $schema URI independently selects the JSON Schema dialect.",
  "$defs": {
    "ConcreteProgramSpec": {
      "discriminator": {
        "mapping": {
          "dnf": "#/$defs/DnfProgramSpec",
          "github-release-rpm": "#/$defs/GitHubReleaseRpmSpec",
          "gnome-shell-extension": "#/$defs/GnomeShellExtensionSpec",
          "module": "#/$defs/ModuleProgramSpec"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ModuleProgramSpec"
        },
        {
          "$ref": "#/$defs/DnfProgramSpec"
        },
        {
          "$ref": "#/$defs/GitHubReleaseRpmSpec"
        },
        {
          "$ref": "#/$defs/GnomeShellExtensionSpec"
        }
      ]
    },
    "DnfProgramSpec": {
      "additionalProperties": false,
      "properties": {
        "after_install": {
          "default": [],
          "description": "Generic filesystem operations run after repository cleanup.",
          "items": {
            "$ref": "#/$defs/FileOperationSpec"
          },
          "title": "After Install",
          "type": "array"
        },
        "before_install": {
          "default": [],
          "description": "Generic filesystem operations run before package installation.",
          "items": {
            "$ref": "#/$defs/FileOperationSpec"
          },
          "title": "Before Install",
          "type": "array"
        },
        "enabled_repositories": {
          "default": [],
          "description": "Repository IDs enabled for this installation only.",
          "items": {
            "type": "string"
          },
          "title": "Enabled Repositories",
          "type": "array",
          "uniqueItems": true
        },
        "generated_repository_files": {
          "default": [],
          "description": "Repository files generated by repository package installation.",
          "items": {
            "format": "path",
            "type": "string"
          },
          "title": "Generated Repository Files",
          "type": "array",
          "uniqueItems": true
        },
        "group": {
          "description": "Ordered Spectrum Containerfile installation/cache group.",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "title": "Group",
          "type": "string"
        },
        "key": {
          "description": "Stable program identifier used by automation.",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "title": "Key",
          "type": "string"
        },
        "kind": {
          "const": "dnf",
          "description": "Install packages directly with DNF.",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "description": "Human-readable program name.",
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "nogpgcheck": {
          "default": false,
          "description": "Disable RPM signature checks for this installation.",
          "title": "Nogpgcheck",
          "type": "boolean"
        },
        "package_variables": {
          "default": [],
          "description": "Commands that resolve repository-package template variables.",
          "items": {
            "$ref": "#/$defs/PackageVariableSpec"
          },
          "title": "Package Variables",
          "type": "array"
        },
        "packages": {
          "description": "Package names or HTTPS RPM URLs to install.",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Packages",
          "type": "array",
          "uniqueItems": true
        },
        "repositories": {
          "default": [],
          "description": "Temporary DNF repository definitions.",
          "items": {
            "$ref": "#/$defs/RepositorySpec"
          },
          "title": "Repositories",
          "type": "array"
        },
        "repository_packages": {
          "default": [],
          "description": "Package URL templates installed before the main packages.",
          "items": {
            "type": "string"
          },
          "title": "Repository Packages",
          "type": "array",
          "uniqueItems": true
        },
        "system_groups": {
          "default": [],
          "description": "Fixed system groups required before package installation.",
          "items": {
            "$ref": "#/$defs/SystemGroupSpec"
          },
          "title": "System Groups",
          "type": "array"
        },
        "validation_packages": {
          "description": "RPM package names required in the completed image.",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Validation Packages",
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "key",
        "group",
        "kind",
        "name",
        "packages",
        "validation_packages"
      ],
      "title": "DnfProgramSpec",
      "type": "object"
    },
    "EnsureDirectorySpec": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "ensure-directory",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "format": "path",
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path",
        "kind"
      ],
      "title": "EnsureDirectorySpec",
      "type": "object"
    },
    "FileOperationSpec": {
      "discriminator": {
        "mapping": {
          "ensure-directory": "#/$defs/EnsureDirectorySpec",
          "remove-empty-directory": "#/$defs/RemoveEmptyDirectorySpec",
          "require-file": "#/$defs/RequireFileSpec",
          "symlink": "#/$defs/SymlinkSpec",
          "unlink": "#/$defs/UnlinkSpec"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/EnsureDirectorySpec"
        },
        {
          "$ref": "#/$defs/RequireFileSpec"
        },
        {
          "$ref": "#/$defs/UnlinkSpec"
        },
        {
          "$ref": "#/$defs/RemoveEmptyDirectorySpec"
        },
        {
          "$ref": "#/$defs/SymlinkSpec"
        }
      ]
    },
    "GitHubReleaseRpmSpec": {
      "additionalProperties": false,
      "properties": {
        "asset_pattern": {
          "description": "Release asset regex; {arch} expands to the RPM architecture.",
          "format": "regex",
          "minLength": 1,
          "title": "Asset Pattern",
          "type": "string"
        },
        "group": {
          "description": "Ordered Spectrum Containerfile installation/cache group.",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "title": "Group",
          "type": "string"
        },
        "key": {
          "description": "Stable program identifier used by automation.",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "title": "Key",
          "type": "string"
        },
        "kind": {
          "const": "github-release-rpm",
          "description": "Install the newest matching RPM from a GitHub release.",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "description": "Human-readable program name.",
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "source": {
          "description": "Key of a GitHub source with a latest-release tracking policy in manifests/sources.json.",
          "enum": [
            "copyous",
            "rustdesk",
            "sops"
          ],
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Source",
          "type": "string"
        },
        "validation_packages": {
          "description": "RPM package names required in the completed image.",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Validation Packages",
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "key",
        "group",
        "kind",
        "name",
        "source",
        "asset_pattern",
        "validation_packages"
      ],
      "title": "GitHubReleaseRpmSpec",
      "type": "object"
    },
    "GnomeShellExtensionSpec": {
      "additionalProperties": false,
      "properties": {
        "asset_pattern": {
          "description": "Regular expression selecting the release ZIP asset.",
          "format": "regex",
          "minLength": 1,
          "title": "Asset Pattern",
          "type": "string"
        },
        "group": {
          "description": "Ordered Spectrum Containerfile installation/cache group.",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "title": "Group",
          "type": "string"
        },
        "key": {
          "description": "Stable program identifier used by automation.",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "title": "Key",
          "type": "string"
        },
        "kind": {
          "const": "gnome-shell-extension",
          "description": "Install a ZIP-packaged GNOME Shell extension release.",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "description": "Human-readable extension name.",
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "packages": {
          "default": [],
          "description": "Runtime packages required by the extension.",
          "items": {
            "type": "string"
          },
          "title": "Packages",
          "type": "array",
          "uniqueItems": true
        },
        "required_files": {
          "description": "Required paths relative to the extracted extension root.",
          "items": {
            "format": "path",
            "type": "string"
          },
          "minItems": 1,
          "title": "Required Files",
          "type": "array",
          "uniqueItems": true
        },
        "schema_directories": {
          "default": [],
          "description": "Relative directories compiled with glib-compile-schemas.",
          "items": {
            "format": "path",
            "type": "string"
          },
          "title": "Schema Directories",
          "type": "array",
          "uniqueItems": true
        },
        "source": {
          "description": "Key of a GitHub source with a latest-release tracking policy in manifests/sources.json.",
          "enum": [
            "copyous",
            "rustdesk",
            "sops"
          ],
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Source",
          "type": "string"
        },
        "uuid": {
          "description": "The GNOME Shell extension UUID.",
          "minLength": 3,
          "pattern": "^[A-Za-z0-9_.-]+@[A-Za-z0-9_.-]+$",
          "title": "Uuid",
          "type": "string"
        }
      },
      "required": [
        "key",
        "group",
        "kind",
        "name",
        "source",
        "uuid",
        "asset_pattern",
        "required_files"
      ],
      "title": "GnomeShellExtensionSpec",
      "type": "object"
    },
    "ModuleProgramSpec": {
      "additionalProperties": false,
      "properties": {
        "group": {
          "description": "Ordered Spectrum Containerfile installation/cache group.",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "title": "Group",
          "type": "string"
        },
        "key": {
          "description": "Stable program identifier used by automation.",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "title": "Key",
          "type": "string"
        },
        "kind": {
          "const": "module",
          "description": "Load a custom Spectrum Python program module.",
          "title": "Kind",
          "type": "string"
        },
        "module": {
          "description": "Module under spectrum_build.programs containing PROGRAM.",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Module",
          "type": "string"
        },
        "sources": {
          "default": [],
          "description": "Shared source records consumed by the custom module.",
          "items": {
            "description": "Key of a repository declared in manifests/sources.json.",
            "enum": [
              "copyous",
              "ghidra_mcp",
              "ghostty",
              "helix",
              "kanata",
              "karabiner_vhid",
              "kmscon",
              "libtsm",
              "python_astral",
              "rustdesk",
              "sops",
              "sushi",
              "tomlc17",
              "toshy",
              "uresourced"
            ],
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_-]*$",
            "type": "string"
          },
          "title": "Sources",
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "key",
        "group",
        "kind",
        "module"
      ],
      "title": "ModuleProgramSpec",
      "type": "object"
    },
    "PackageVariableSpec": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Command",
          "type": "array"
        },
        "name": {
          "minLength": 1,
          "pattern": "^[a-z_][a-z0-9_]*$",
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name",
        "command"
      ],
      "title": "PackageVariableSpec",
      "type": "object"
    },
    "RemoveEmptyDirectorySpec": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "remove-empty-directory",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "format": "path",
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path",
        "kind"
      ],
      "title": "RemoveEmptyDirectorySpec",
      "type": "object"
    },
    "RepositorySpec": {
      "additionalProperties": false,
      "oneOf": [
        {
          "not": {
            "required": [
              "source_url"
            ]
          },
          "required": [
            "source_path"
          ]
        },
        {
          "not": {
            "required": [
              "source_path"
            ]
          },
          "required": [
            "source_url"
          ]
        }
      ],
      "properties": {
        "destination": {
          "description": "Absolute destination for the repository definition.",
          "format": "path",
          "title": "Destination",
          "type": "string"
        },
        "import_rpm_key": {
          "default": false,
          "description": "Import RPM keys declared by the installed repository.",
          "title": "Import Rpm Key",
          "type": "boolean"
        },
        "repo_ids": {
          "default": [],
          "description": "DNF repository IDs made available during installation.",
          "items": {
            "type": "string"
          },
          "title": "Repo Ids",
          "type": "array",
          "uniqueItems": true
        },
        "source_path": {
          "anyOf": [
            {
              "format": "path",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Repository-relative file copied to the destination.",
          "title": "Source Path"
        },
        "source_url": {
          "anyOf": [
            {
              "pattern": "^https://",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "HTTPS URL downloaded to the destination.",
          "format": "uri",
          "title": "Source Url"
        }
      },
      "required": [
        "destination"
      ],
      "title": "RepositorySpec",
      "type": "object"
    },
    "RequireFileSpec": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "require-file",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "format": "path",
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path",
        "kind"
      ],
      "title": "RequireFileSpec",
      "type": "object"
    },
    "SymlinkSpec": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "symlink",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "format": "path",
          "title": "Path",
          "type": "string"
        },
        "target": {
          "format": "path",
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "path",
        "kind",
        "target"
      ],
      "title": "SymlinkSpec",
      "type": "object"
    },
    "SystemGroupSpec": {
      "additionalProperties": false,
      "properties": {
        "gid": {
          "minimum": 1,
          "title": "Gid",
          "type": "integer"
        },
        "name": {
          "minLength": 1,
          "pattern": "^[a-z_][a-z0-9_-]*$",
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name",
        "gid"
      ],
      "title": "SystemGroupSpec",
      "type": "object"
    },
    "UnlinkSpec": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "unlink",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "format": "path",
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path",
        "kind"
      ],
      "title": "UnlinkSpec",
      "type": "object"
    }
  },
  "$id": "https://raw.githubusercontent.com/4evy/dotfiles/main/manifests/spectrum-programs.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Ordered declarative Spectrum program inventory.",
  "properties": {
    "$schema": {
      "const": "./spectrum-programs.schema.json",
      "description": "The editor and validation schema for this manifest.",
      "title": "$Schema",
      "type": "string"
    },
    "format_version": {
      "const": 1,
      "description": "Revision of this repository's Spectrum-manifest contract; this is not the TOML or JSON Schema specification version.",
      "title": "Format Version",
      "type": "integer"
    },
    "program": {
      "description": "Programs in deterministic installation order.",
      "items": {
        "$ref": "#/$defs/ConcreteProgramSpec"
      },
      "minItems": 1,
      "title": "Program",
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "$schema",
    "format_version",
    "program"
  ],
  "title": "ProgramManifest",
  "type": "object"
}
