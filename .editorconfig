root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,py.in,py.j2,pyi,pyw}]
indent_size = 4

[{systems/spectrum/files/system/usr/bin/open,home/files/.local/bin/helix-rumdl-lsp}]
indent_size = 4

[*.{rs,zig,zon}]
indent_size = 4

[{Justfile,justfile,*.just}]
indent_size = 4

[{Makefile,makefile,*.mk}]
indent_style = tab
indent_size = tab

[*.{if,lua,te}]
indent_style = tab
indent_size = tab

[*.{bash,sh}]
indent_style = tab
indent_size = tab
binary_next_line = false
simplify = false
switch_case_indent = true

[{home/files/.bash*,home/files/.zprofile,home/files/.local/bin/codex-node-repl-browser-trust,home/files/.local/bin/solaar-no-tray,home/files/.local/lib/sops/sops.sh}]
indent_style = tab
indent_size = tab
binary_next_line = false
simplify = false
switch_case_indent = true

[*.{md}]
trim_trailing_whitespace = false

[*.{diff,patch}]
indent_style = unset
indent_size = unset
insert_final_newline = unset
trim_trailing_whitespace = false

[*.{lock,lockb}]
indent_style = unset
indent_size = unset
insert_final_newline = unset
trim_trailing_whitespace = unset

[**/{node_modules,vendor,zig-pkg}/**]
charset = unset
end_of_line = unset
indent_style = unset
indent_size = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
ignore = true
