{
  "name": "dotfiles-workspace",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": {
    "packages": [
      "dotfiles"
    ],
    "catalog": {
      "@types/bun": "1.3.14",
      "typescript": "7.0.2"
    }
  },
  "scripts": {
    "check": "bun run check:biome && bun run --sequential --workspaces check && bun run --cwd packages/hyper-window-tiling check",
    "check:biome": "biome check .",
    "format": "biome check --write .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6"
  }
}
