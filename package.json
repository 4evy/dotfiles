{
  "name": "@dotfiles/repo",
  "private": true,
  "packageManager": "bun@1.4.4",
  "type": "module",
  "exports": {
    "./data/*": "./data/*.json"
  },
  "bin": {
    "dotfiles-applications": "tools/setup/applications.ts",
    "dotfiles-codesign": "systems/modules/darwin/codesign.ts",
    "dotfiles-homebrew": "tools/setup/homebrew.ts",
    "dotfiles-logitech": "systems/modules/darwin/keyboard/logitech.ts",
    "dotfiles-notifications": "systems/modules/darwin/permissions/notifications/preferences.ts",
    "dotfiles-permissions": "systems/modules/darwin/permissions/permissions.ts"
  },
  "workspaces": {
    "packages": [
      "home",
      "home/files/.local/lib",
      "lib/typescript",
      "tools/tiling",
      "tools/workstation"
    ],
    "catalog": {
      "@types/bun": "1.4.4",
      "typescript": "7.0.2"
    }
  },
  "scripts": {
    "check": "bun run check:biome && bun run tsc -p tsconfig.json && bun run --sequential --workspaces check",
    "check:biome": "bun run biome check .",
    "format": "just fmt",
    "lint": "bun run biome lint .",
    "lint:fix": "bun run biome lint --write .",
    "sync:omp": "bun tools/renovate/omp.ts",
    "typecheck": "bun run tsc -p tsconfig.json && bun run --sequential --workspaces typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@catppuccin/palette": "1.8.0",
    "@oh-my-pi/pi-coding-agent": "18.16.0",
    "@oh-my-pi/pi-tui": "18.16.0",
    "@tailnet/tailscaled": "0.1.2",
    "@types/bun": "catalog:",
    "@types/culori": "4.0.1",
    "@types/write-file-atomic": "4.0.3",
    "culori": "4.0.2",
    "fallow": "file:tools/tiling/vendor/fallow",
    "typescript": "catalog:",
    "vscode-jsonrpc": "10.0.0"
  },
  "dependencies": {
    "@dotfiles/core": "workspace:*",
    "@dotfiles/home": "workspace:*",
    "@dotfiles/runtime": "workspace:*",
    "@dotfiles/workstation": "workspace:*",
    "@effect/platform-bun": "4.1.2",
    "@optique/core": "1.3.6",
    "drizzle-orm": "0.45.4",
    "effect": "4.1.2",
    "fast-xml-validator": "1.4.2",
    "jsonc-parser": "3.3.1",
    "shellwords-ts": "3.0.1",
    "smol-toml": "1.9.1",
    "valibot": "1.5.0",
    "write-file-atomic": "8.0.0"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.1.2"
  }
}
