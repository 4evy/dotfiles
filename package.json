{
  "name": "dotfiles-workspace",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": {
    "packages": [
      "dotfiles",
      "packages/chatgpt"
    ],
    "catalog": {
      "@types/bun": "1.3.14",
      "typescript": "7.0.2"
    }
  },
  "scripts": {
    "check": "bun run check:biome && bun run --sequential --workspaces check && bun run --cwd packages/hyper-window-tiling check",
    "check:biome": "bun x --no-install biome check .",
    "format": "bun x --no-install biome check --write .",
    "lint": "bun x --no-install biome lint .",
    "lint:fix": "bun x --no-install biome lint --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9"
  }
}
