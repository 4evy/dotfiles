{
  "name": "dotfiles-renovate",
  "private": true,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "extract": "cd ../.. && LOG_LEVEL=warn .github/renovate/node_modules/.bin/renovate --platform=local --dry-run=extract --require-config=required",
    "renovate": "renovate",
    "validate": "renovate-config-validator --strict --no-global ../renovate.json"
  },
  "devDependencies": {
    "renovate": "44.115.4"
  }
}
