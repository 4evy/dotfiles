{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", "group:all"],
  "timezone": "Europe/Sofia",
  "dependencyDashboard": false,
  "automerge": true,
  "automergeType": "branch",
  "ignoreTests": true,
  "commitBodyTable": true,
  "vulnerabilityAlerts": {
    "enabled": false
  },
  "nix": {
    "enabled": true
  },
  "pep621": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": ["* 0-5 1 * *"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track the pinned Spectrum Bluefin base image",
      "managerFilePatterns": [
        "/^bluebuild\\/recipes\\/spectrum\\.yml$/",
        "/^bluebuild\\/recipes\\/spectrum\\.lock$/"
      ],
      "matchStrings": [
        "registry:\\s+ghcr\\.io\\n\\s+repository:\\s+projectbluefin/bluefin-nvidia\\n\\s+tag:\\s+(?<currentValue>[^\\s@]+)\\n\\s+digest:\\s+(?<currentDigest>sha256:[a-f0-9]+)",
        "ghcr\\.io/projectbluefin/bluefin-nvidia:(?<currentValue>[^\\s@]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "depNameTemplate": "ghcr.io/projectbluefin/bluefin-nvidia",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Track pinned Spectrum builder images",
      "managerFilePatterns": ["/^bluebuild\\/recipes\\/spectrum\\/stages\\/.*\\.yml$/"],
      "matchStrings": [
        "from:\\s+(?<depName>[^\\s:@]+(?:/[^\\s:@]+)+):(?<currentValue>[^\\s@]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Track annotated GitHub release assets in the Spectrum recipe",
      "managerFilePatterns": [
        "/^bluebuild\\/recipes\\/spectrum(?:\\.yml|\\/.*\\.yml)$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\s]+)\\s+- https://github\\.com/[^\\s]+/releases/download/v?(?<currentValue>[^/\\s]+)/[^\\s]+"
      ]
    },
    {
      "customType": "regex",
      "description": "Track pinned BlueBuild module image digests",
      "managerFilePatterns": [
        "/^bluebuild\\/recipes\\/spectrum(?:\\.yml|\\/.*\\.yml)$/"
      ],
      "matchStrings": [
        "source:\\s+(?<depName>ghcr\\.io/blue-build/modules)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker",
      "currentValueTemplate": "latest",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Track the Helium binary flake input",
      "managerFilePatterns": ["/^flake\\.nix$/"],
      "matchStrings": [
        "url = \"file\\+https://github\\.com/imputnet/helium-linux/releases/download/(?<currentValue>[^/]+)/helium-[^/]+-x86_64_linux\\.tar\\.xz\";"
      ],
      "depNameTemplate": "imputnet/helium-linux",
      "datasourceTemplate": "github-releases",
      "autoReplaceStringTemplate": "url = \"file+https://github.com/imputnet/helium-linux/releases/download/{{{newValue}}}/helium-{{{newValue}}}-x86_64_linux.tar.xz\";"
    },
    {
      "customType": "regex",
      "description": "Track the Astral source flake input",
      "managerFilePatterns": ["/^flake\\.nix$/"],
      "matchStrings": [
        "url = \"file\\+https://files\\.pythonhosted\\.org/packages/source/a/astral/astral-(?<currentValue>[^/]+)\\.tar\\.gz\";"
      ],
      "depNameTemplate": "astral",
      "datasourceTemplate": "pypi",
      "versioningTemplate": "pep440"
    },
    {
      "customType": "regex",
      "description": "Track Equilotl release tags in the flake",
      "managerFilePatterns": ["/^flake\\.nix$/"],
      "matchStrings": ["url = \"github:Equicord/Equilotl/(?<currentValue>v[^\"/]+)\";"],
      "depNameTemplate": "Equicord/Equilotl",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Track Toshy release tags in the flake",
      "managerFilePatterns": ["/^flake\\.nix$/"],
      "matchStrings": [
        "url = \"github:RedBearAK/Toshy/Toshy_v(?<currentValue>[^\"/]+)\";"
      ],
      "depNameTemplate": "RedBearAK/Toshy",
      "datasourceTemplate": "github-tags",
      "extractVersionTemplate": "^Toshy_v(?<version>.*)$",
      "versioningTemplate": "loose"
    }
  ],
  "packageRules": [
    {
      "description": "Relock release URLs changed by the flake source managers",
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["flake.nix"],
      "postUpgradeTasks": {
        "commands": ["nix flake lock"],
        "fileFilters": ["flake.lock"],
        "executionMode": "branch"
      }
    },
    {
      "description": "Preserve frozen source revisions and let release managers own tag changes",
      "matchManagers": ["nix"],
      "matchDepNames": [
        "source-equilotl",
        "source-toshy",
        "source-ghostty",
        "source-jj",
        "source-kanata-homebrew",
        "source-kmscon",
        "source-libtsm",
        "source-uresourced"
      ],
      "enabled": false
    }
  ]
}
