{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "gitAuthor": "4evy <git@evy.pink>",
  "gitIgnoredAuthors": ["41898282+github-actions[bot]@users.noreply.github.com"],
  "dependencyDashboard": false,
  "configMigration": false,
  "automerge": true,
  "automergeType": "branch",
  "ignoreTests": true,
  "platformAutomerge": false,
  "prCreation": "status-success",
  "rebaseWhen": "auto",
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "vulnerabilityAlerts": {
    "enabled": false
  },
  "pep621": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track the pinned Spectrum Bluefin base image",
      "managerFilePatterns": [
        "/^bluebuild\\/recipes\\/spectrum\\.yml$/",
        "/^bluebuild\\/recipes\\/spectrum\\.lock$/"
      ],
      "matchStrings": [
        "registry:\\s+ghcr\\.io\\n\\s+repository:\\s+projectbluefin/bluefin-nvidia\\n\\s+tag:\\s+(?<currentValue>[^\\s@]+)\\n\\s+digest:\\s+(?<currentDigest>sha256:[a-f0-9]+)",
        "ghcr\\.io/projectbluefin/bluefin-nvidia:(?<currentValue>[^\\s@]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "depNameTemplate": "ghcr.io/projectbluefin/bluefin-nvidia",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Track the pinned Go Helium profile configurer",
      "managerFilePatterns": [
        "/^ansible\\/roles\\/applications\\/defaults\\/main\\.yml$/"
      ],
      "matchStrings": ["browser@(?<currentDigest>[a-f0-9]{40})"],
      "depNameTemplate": "4evy/browser",
      "datasourceTemplate": "github-digest",
      "currentValueTemplate": "HEAD",
      "versioningTemplate": "git"
    },
    {
      "customType": "jsonata",
      "description": "Discover non-frozen npins GitHub branch revisions",
      "fileFormat": "json",
      "managerFilePatterns": ["/^npins\\/sources\\.json$/"],
      "matchStrings": [
        "$each(pins, function($v, $k) { $v.type = \"Git\" and $v.repository.type = \"GitHub\" and $not($v.frozen = true) ? { \"depName\": $v.repository.owner & \"/\" & $v.repository.repo, \"currentValue\": $v.branch, \"currentDigest\": $v.revision, \"datasource\": \"github-digest\", \"versioning\": \"git\", \"depType\": \"npins\" } })"
      ]
    },
    {
      "customType": "jsonata",
      "description": "Discover non-frozen npins GitHub release tags",
      "fileFormat": "json",
      "managerFilePatterns": ["/^npins\\/sources\\.json$/"],
      "matchStrings": [
        "$each(pins, function($v, $k) { $v.type = \"GitRelease\" and $v.repository.type = \"GitHub\" and $not($v.frozen = true) ? { \"depName\": $v.repository.owner & \"/\" & $v.repository.repo, \"currentValue\": $v.version, \"datasource\": \"github-tags\", \"versioning\": \"loose\", \"depType\": \"npins\" } })"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Keep pyproject.toml and uv.lock Python updates together.",
      "matchManagers": ["pep621"],
      "groupName": "python dependencies",
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "description": "Automerge digest-only updates after checks pass",
      "matchUpdateTypes": ["digest", "pin", "pinDigest"],
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "description": "Keep the Spectrum Bluefin base image on the selected stream",
      "matchDepNames": ["ghcr.io/projectbluefin/bluefin-nvidia"],
      "matchUpdateTypes": ["digest", "pin", "pinDigest"],
      "schedule": ["at any time"]
    },
    {
      "description": "Let npins own grouped lock updates and hash regeneration",
      "matchManagers": ["custom.jsonata"],
      "matchDepTypes": ["npins"],
      "groupName": "npins sources",
      "groupSlug": "npins-sources",
      "postUpgradeTasks": {
        "commands": ["nix shell nixpkgs#npins --command npins update"],
        "fileFilters": ["npins/sources.json"],
        "executionMode": "update"
      }
    }
  ]
}
