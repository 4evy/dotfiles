{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", "group:all"],
  "timezone": "Europe/Sofia",
  "dependencyDashboard": false,
  "automerge": true,
  "automergeType": "branch",
  "ignoreTests": true,
  "commitBodyTable": true,
  "vulnerabilityAlerts": {
    "enabled": false
  },
  "nix": {
    "enabled": true,
    "managerFilePatterns": ["/^flake\\.nix$/"]
  },
  "pep621": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "commitMessageAction": "refresh lock files",
    "schedule": ["at any time"]
  },
  "customDatasources": {
    "rex-server": {
      "defaultRegistryUrlTemplate": "https://blob.superlogical.com/api/releases/rex/snapshot",
      "transformTemplates": [
        "{\"releases\":[{\"version\":version,\"digest\":commit,\"isStable\":true}]}"
      ]
    },
    "rex-app": {
      "defaultRegistryUrlTemplate": "https://blob.superlogical.com/public/rex-app/snapshot-arm64/appcast.xml",
      "format": "plain",
      "transformTemplates": [
        "{\"releases\":$match($join(releases.version,\"\\n\"), /<sparkle:version>([0-9]+)<\\/sparkle:version>/).{\"version\":groups[0]}}"
      ]
    },
    "super-engineering-linux": {
      "defaultRegistryUrlTemplate": "https://releases.super.engineering/linux/nightly/manifest.json",
      "transformTemplates": [
        "$eval($base64decode(payload))",
        "{\"releases\":[{\"version\":\"0-unstable-\" & date,\"digest\":artifacts.\"x86_64-unknown-linux-gnu\".commit,\"isStable\":true}]}"
      ]
    },
    "super-engineering-darwin": {
      "defaultRegistryUrlTemplate": "https://releases.super.engineering/latest-v2.json",
      "transformTemplates": [
        "{\"releases\":[{\"version\":\"0-unstable-\" & nightly.date,\"digest\":nightly.artifacts.\"aarch64-apple-darwin\".sha,\"isStable\":true}]}"
      ]
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track Rex server snapshots and their matching support sources",
      "managerFilePatterns": ["/^packages/rex/sources\\.json$/"],
      "matchStrings": [
        "\"server\":\\s*\\{\\s*\"version\":\\s*\"(?<currentValue>[^\"]+)\",\\s*\"rev\":\\s*\"(?<currentDigest>[a-f0-9]+)\""
      ],
      "depNameTemplate": "rex-server",
      "datasourceTemplate": "custom.rex-server",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Track Rex app builds independently of its bundled server",
      "managerFilePatterns": ["/^packages/rex/sources\\.json$/"],
      "matchStrings": ["\"build\":\\s*\"(?<currentValue>[0-9]+)\""],
      "depNameTemplate": "rex-app",
      "datasourceTemplate": "custom.rex-app",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "description": "Track both Super Engineering nightly channels, including same-day rebuilds",
      "managerFilePatterns": ["/^packages/super-engineering/sources\\.json$/"],
      "matchStrings": [
        "\"(?<platform>linux|darwin)\":\\s*\\{\\s*\"version\":\\s*\"(?<currentValue>[^\"]+)\",\\s*\"rev\":\\s*\"(?<currentDigest>[a-f0-9]+)\""
      ],
      "depNameTemplate": "super-engineering-{{{platform}}}",
      "datasourceTemplate": "custom.super-engineering-{{{platform}}}",
      "versioningTemplate": "regex:^0-unstable-(?<major>\\d{4})-(?<minor>\\d{2})-(?<patch>\\d{2})$"
    },
    {
      "customType": "regex",
      "description": "Track the Noto emoji font's owning source revision",
      "managerFilePatterns": ["/^flake\\.nix$/"],
      "matchStrings": [
        "file\\+https://raw\\.githubusercontent\\.com/googlefonts/noto-emoji/(?<currentDigest>[a-f0-9]{40})/2D/fonts/NotoColorEmoji\\.ttf"
      ],
      "depNameTemplate": "googlefonts/noto-emoji",
      "packageNameTemplate": "https://github.com/googlefonts/noto-emoji",
      "datasourceTemplate": "git-refs",
      "currentValueTemplate": "main",
      "versioningTemplate": "exact"
    },
    {
      "customType": "regex",
      "description": "Track the Darwin Helium release override",
      "managerFilePatterns": ["/^nix/overlays/applications\\.nix$/"],
      "matchStrings": ["version = \"(?<currentValue>[0-9.]+)\";\\s+src = fetchurl"],
      "depNameTemplate": "imputnet/helium-macos",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "description": "Track the managed Bun release override and all platform hashes",
      "managerFilePatterns": ["/^nix/overlays/upstream/upstream\\.nix$/"],
      "matchStrings": ["version = \"(?<currentValue>[0-9.]+)\";"],
      "depNameTemplate": "oven-sh/bun",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^bun-v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "Track the checksum-verified Homebrew installer",
      "managerFilePatterns": ["/^tools/setup/setup\\.ts$/"],
      "matchStrings": ["homebrewRevision = \"(?<currentDigest>[a-f0-9]{40})\""],
      "depNameTemplate": "Homebrew/install",
      "packageNameTemplate": "https://github.com/Homebrew/install",
      "datasourceTemplate": "git-refs",
      "currentValueTemplate": "HEAD",
      "versioningTemplate": "exact"
    },
    {
      "customType": "regex",
      "description": "Track the vendored Fallow launcher as well as its native dependencies",
      "managerFilePatterns": ["/^tools/tiling/vendor/fallow/package\\.json$/"],
      "matchStrings": ["\"version\":\\s*\"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "fallow",
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "Track the all-features BlueBuild main installer digest, since release installers omit recipe v2 and bootc",
      "managerFilePatterns": [
        "/^systems\\/spectrum\\/recipes\\/spectrum\\/stages\\/files\\.yml$/"
      ],
      "matchStrings": [
        "COPY --from=(?<depName>ghcr\\.io/blue-build/cli):(?<currentValue>main-installer)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Track the pinned Spectrum Bluefin base image",
      "managerFilePatterns": [
        "/^systems\\/spectrum\\/recipes\\/spectrum\\.yml$/",
        "/^systems\\/spectrum\\/recipes\\/spectrum\\.lock$/"
      ],
      "matchStrings": [
        "registry:\\s+ghcr\\.io\\n\\s+repository:\\s+ublue-os/bluefin-nvidia-open\\n\\s+tag:\\s+\"?(?<currentValue>\\d+)\"?\\n\\s+digest:\\s+(?<currentDigest>sha256:[a-f0-9]+)",
        "ghcr\\.io/ublue-os/bluefin-nvidia-open:(?<currentValue>[^\\s@]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "depNameTemplate": "ghcr.io/ublue-os/bluefin-nvidia-open",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Track pinned Spectrum builder images",
      "managerFilePatterns": [
        "/^systems\\/spectrum\\/recipes\\/spectrum\\/stages\\/.*\\.yml$/"
      ],
      "matchStrings": [
        "from:\\s+(?<depName>[^\\s:@]+(?:/[^\\s:@]+)+):(?<currentValue>[^\\s@]+)@(?<currentDigest>sha256:[a-f0-9]+)",
        "COPY --from=(?<depName>[^\\s:@]+(?:/[^\\s:@]+)+):(?<currentValue>[^\\s@]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Track annotated GitHub release assets in the Spectrum recipe",
      "managerFilePatterns": [
        "/^systems\\/spectrum\\/recipes\\/spectrum(?:\\.yml|\\/.*\\.yml)$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\s]+)\\s+- https://github\\.com/[^\\s]+/releases/download/v?(?<currentValue>[^/\\s]+)/[^\\s]+"
      ]
    },
    {
      "customType": "regex",
      "description": "Track pinned BlueBuild module image digests",
      "managerFilePatterns": [
        "/^systems\\/spectrum\\/recipes\\/spectrum(?:\\.yml|\\/.*\\.yml)$/"
      ],
      "matchStrings": [
        "source:\\s+(?<depName>ghcr\\.io/blue-build/modules/[a-z-]+):(?<currentValue>[^\\s@]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Track Toshy release tags in the flake",
      "managerFilePatterns": ["/^flake\\.nix$/"],
      "matchStrings": [
        "url = \"github:RedBearAK/Toshy/Toshy_v(?<currentValue>[^\"/]+)\";"
      ],
      "depNameTemplate": "RedBearAK/Toshy",
      "datasourceTemplate": "github-tags",
      "extractVersionTemplate": "^Toshy_v(?<version>.*)$",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "description": "Track the Bun workspace catalog at its owning manifest",
      "managerFilePatterns": ["/^package\\.json$/"],
      "matchStrings": [
        "\"catalog\":\\s*\\{[^}]+\\}",
        "\"(?<depName>[^\"\\s]+)\":\\s*\"(?<currentValue>[^\"\\s]+)\""
      ],
      "matchStringsStrategy": "recursive",
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "Track zizmor because the asdf manager does not support it",
      "managerFilePatterns": ["/^\\.tool-versions$/"],
      "matchStrings": ["(?:^|\\n)zizmor (?<currentValue>[^\\s]+)"],
      "depNameTemplate": "zizmor",
      "packageNameTemplate": "zizmorcore/zizmor",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Track the checksum-verified mise bootstrap",
      "managerFilePatterns": ["/^\\.github/actions/setup/check/tools/action\\.yaml$/"],
      "matchStrings": ["MISE_VERSION: (?<currentValue>v[^\\s]+)"],
      "depNameTemplate": "jdx/mise",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Track the Determinate release URL instead of treating FlakeHub as a Git remote",
      "managerFilePatterns": ["/^flake\\.nix$/"],
      "matchStrings": [
        "https://flakehub\\.com/f/DeterminateSystems/determinate/=(?<currentValue>[^\"\\s]+)"
      ],
      "depNameTemplate": "DeterminateSystems/determinate",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Track the Karabiner VirtualHID device binary",
      "managerFilePatterns": ["/^flake\\.nix$/"],
      "matchStrings": [
        "file\\+https://raw\\.githubusercontent\\.com/pqrs-org/Karabiner-DriverKit-VirtualHIDDevice/v(?<currentValue>[^/]+)/dist/[^\"\\s]+"
      ],
      "depNameTemplate": "pqrs-org/Karabiner-DriverKit-VirtualHIDDevice",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Track uresourced release tags instead of silently refreshing the same tag",
      "managerFilePatterns": ["/^flake\\.nix$/"],
      "matchStrings": [
        "git\\+https://gitlab\\.freedesktop\\.org/benzea/uresourced\\.git\\?ref=refs/tags/(?<currentValue>[^\"\\s]+)"
      ],
      "depNameTemplate": "uresourced",
      "packageNameTemplate": "https://gitlab.freedesktop.org/benzea/uresourced.git",
      "datasourceTemplate": "git-tags"
    },
    {
      "customType": "regex",
      "description": "Track the checksum-verified Translate Web Pages extension",
      "managerFilePatterns": ["/^home/applications/helium/config\\.toml$/"],
      "matchStrings": [
        "version = \"(?<currentValue>[^\"\\s]+)\"\\s+url = \"https://github\\.com/FilipePS/Traduzir-paginas-web/releases/download/[^\"\\s]+\""
      ],
      "depNameTemplate": "FilipePS/Traduzir-paginas-web",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "description": "Track all revision-pinned Yazi plugins",
      "managerFilePatterns": ["/^home/files/\\.config/yazi/package\\.toml$/"],
      "matchStrings": [
        "use = \"(?<depName>[^\":]+)(?::[^\"\\s]+)?\"\\s+rev = \"(?<currentDigest>[a-f0-9]{7,40})\""
      ],
      "packageNameTemplate": "https://github.com/{{{depName}}}{{#if (equals depName 'Rolv-Apneseth/starship')}}.yazi{{/if}}",
      "datasourceTemplate": "git-refs",
      "currentValueTemplate": "main",
      "versioningTemplate": "exact"
    },
    {
      "customType": "regex",
      "description": "Track the ChatGPT Linux RPM from its first-party repository",
      "managerFilePatterns": [
        "/^home/files/\\.local/share/nix/chatgpt/package\\.nix$/"
      ],
      "matchStrings": ["  version = \"(?<currentValue>[^\"\\s]+)\";"],
      "depNameTemplate": "chatgpt",
      "datasourceTemplate": "rpm",
      "registryUrlTemplate": "https://persistent.oaistatic.com/codex-app-prod/linux/rpm/x86_64/repodata/",
      "extractVersionTemplate": "^(?<version>[^-]+)-.*$",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "description": "Track the checksum-verified Bun bootstrap",
      "managerFilePatterns": ["/^tools/setup/setup\\.sh$/"],
      "matchStrings": [
        "https://github\\.com/oven-sh/bun/releases/download/bun-v(?<currentValue>[^/]+)/"
      ],
      "depNameTemplate": "oven-sh/bun",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^bun-v(?<version>.*)$"
    }
  ],
  "packageRules": [
    {
      "description": "The vendored launcher owns its matching native binary release",
      "matchFileNames": ["tools/tiling/vendor/fallow/package.json"],
      "matchPackageNames": ["@fallow-cli/**"],
      "enabled": false
    },
    {
      "description": "The vendored Fallow updater owns the matching semantic companion",
      "matchFileNames": ["package.json"],
      "matchPackageNames": ["fallow-type-aware"],
      "enabled": false
    },
    {
      "description": "Track nightly digests even when their published version is unchanged",
      "matchDatasources": [
        "custom.rex-server",
        "custom.super-engineering-linux",
        "custom.super-engineering-darwin"
      ],
      "ignoreUnstable": false,
      "pinDigests": true
    },
    {
      "description": "Extract Bun toolchain versions from bun-v release tags",
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["systems/spectrum/recipes/spectrum/stages/**"],
      "matchDepNames": ["oven-sh/bun"],
      "extractVersion": "^bun-v(?<version>.*)$"
    },
    {
      "description": "Let release managers own tag and explicitly pinned revision changes",
      "matchManagers": ["nix"],
      "matchDepNames": ["source-toshy", "source-uresourced", "determinate"],
      "enabled": false
    },
    {
      "description": "Inherit OMP runtime and extension versions from the locked AI flake input",
      "matchManagers": ["npm", "bun"],
      "matchPackageNames": ["@oh-my-pi/**"],
      "enabled": false
    },
    {
      "description": "Resolve the declared flake-parts GitHub source despite the old FlakeHub lock URL",
      "matchManagers": ["nix"],
      "matchDepNames": ["flake-parts"],
      "overridePackageName": "https://github.com/hercules-ci/flake-parts"
    },
    {
      "description": "Resolve the declared git-hooks GitHub source despite the old FlakeHub lock URL",
      "matchManagers": ["nix"],
      "matchDepNames": ["git-hooks-nix"],
      "overridePackageName": "https://github.com/cachix/git-hooks.nix"
    }
  ],
  "baseBranchPatterns": ["master"],
  "platformCommit": "disabled",
  "platformAutomerge": false,
  "semanticCommits": "disabled",
  "commitMessagePrefix": "deps:",
  "commitMessageAction": "update",
  "dependencyDashboardApproval": false,
  "configMigration": false,
  "ignorePaths": ["secrets/**"],
  "postUpgradeTasks": {
    "commands": ["bun tools/renovate/artifacts.ts"],
    "fileFilters": [
      "flake.lock",
      "flake.nix",
      "bun.nix",
      "**/bun.lock",
      "**/package.json",
      "tools/theme/run/package.nix",
      ".github/renovate/patches/**",
      ".github/actions/setup/check/tools/action.yaml",
      "home/applications/helium/config.toml",
      "home/files/.config/yazi/package.toml",
      "home/files/.local/share/nix/chatgpt/*",
      "tools/setup/setup.sh",
      "tools/setup/setup.ts",
      "tools/tiling/vendor/fallow/**",
      "home/theme/palette/palette.json",
      "systems/spectrum/recipes/spectrum/modules/software.yml",
      "biome.jsonc",
      "packages/**",
      "systems/spectrum/recipes/**/*.yml",
      "nix/overlays/**"
    ],
    "executionMode": "branch"
  },
  "statusCheckWhen": {
    "artifactError": "never",
    "minimumReleaseAge": "never",
    "mergeConfidence": "never"
  }
}
